---
/**
 * TestimonialCard — Molecule component.
 * Renders a single client testimonial: verified badge, project domain tag,
 * system title, technical deliverable tags, quote, and key outcome metric.
 */
import type { Testimonial } from "../data/testimonials";

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<article
  class="testimonial-card flex flex-col h-full p-7 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-[#252528]/80 backdrop-blur-md shadow-sm hover:border-wood-accent/40 hover:shadow-xl hover:shadow-wood-accent/5 transition-all duration-300 transform hover:-translate-y-1"
  data-domain={testimonial.projectType}
>
  <div class="flex items-start justify-between gap-3 mb-4">
    <div class="flex items-center gap-3">
      <span
        class="w-11 h-11 rounded-full bg-wood-accent/10 text-wood-accent dark:text-wood-300 font-bold text-base flex items-center justify-center flex-shrink-0"
        aria-hidden="true"
      >
        {testimonial.name.charAt(0)}
      </span>
      <div>
        <p class="text-sm font-bold text-gray-900 dark:text-white flex items-center gap-1.5">
          {testimonial.name}
          <svg class="w-4 h-4 text-wood-accent" fill="currentColor" viewBox="0 0 20 20" aria-label="Verified client">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </p>
        <p class="text-xs text-gray-500 dark:text-gray-400">{testimonial.role}</p>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2 mb-4">
    <span class="inline-block px-2.5 py-1 rounded-full bg-wood-accent/10 text-wood-accent dark:text-wood-300 text-[11px] font-bold uppercase tracking-wider">
      {testimonial.projectType}
    </span>
    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M5.05 3.636a1 1 0 010 1.414 7 7 0 000 9.9 1 1 0 11-1.414 1.414 9 9 0 010-12.728 1 1 0 011.414 0zm9.9 0a1 1 0 011.414 0 9 9 0 010 12.728 1 1 0 11-1.414-1.414 7 7 0 000-9.9 1 1 0 010-1.414zM9 9a1 1 0 012 0v3a1 1 0 11-2 0V9zm1-4a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
      </svg>
      Verified Client
    </span>
  </div>

  <h3 class="text-base font-bold text-gray-900 dark:text-white leading-snug mb-3">
    {testimonial.projectTitle}
  </h3>

  <blockquote class="relative flex-grow">
    <svg
      class="absolute -top-1 -left-1 w-7 h-7 text-wood-accent/15"
      fill="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M9.983 3v7.391C9.983 16.095 6.252 19.5 1 19.5v-3.13c3.198 0 5.486-1.936 5.486-5.979H1V3h8.983zm13.017 0v7.391C23 16.095 19.269 19.5 14.017 19.5v-3.13c3.198 0 5.486-1.936 5.486-5.979H14V3h9z" />
    </svg>
    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed italic pl-6">
      &ldquo;{testimonial.quote}&rdquo;
    </p>
  </blockquote>

  <p class="mt-4 pl-6 text-xs font-semibold text-gray-700 dark:text-gray-200">
    <span class="text-wood-accent">Key Deliverable:</span> {testimonial.highlight}
  </p>

  <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-800">
    <div class="flex flex-wrap gap-1.5 mb-3">
      {testimonial.techStack.map((tech) => (
        <span class="px-2 py-0.5 rounded-md bg-gray-100 dark:bg-gray-800 text-[11px] font-medium text-gray-600 dark:text-gray-300">
          [{tech}]
        </span>
      ))}
    </div>
    <p class="flex items-center gap-1.5 text-xs font-bold text-wood-accent">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
      </svg>
      {testimonial.metricOrOutcome}
    </p>
  </div>
</article>
