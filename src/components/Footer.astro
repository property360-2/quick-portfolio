---
/**
 * Site footer component for the quick portfolio.
 * This component renders brand attribution and footer navigation links, including the centralized contact email.
 * It fits into the shared Layout component so every page exposes consistent contact and sitemap access.
 */
import { CONTACT_EMAIL } from "../utils/contact";
---
<footer
      class="bg-white dark:bg-[#1a1a1a] border-t border-gray-200 dark:border-gray-800 mt-auto pb-24 sm:pb-12"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="mb-4 md:mb-0">
            <span
              class="text-xl font-bold text-gray-900 dark:text-white tracking-tight"
              >Jun <span class="text-wood-accent">Alvior</span></span
            >
            <p class="text-sm text-gray-500 mt-1">
              © {new Date().getFullYear()}. All rights reserved.
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-4 sm:gap-6">
            <nav class="flex items-center gap-4 text-sm font-medium text-gray-500 dark:text-gray-400">
              <a href="/quick-portfolio/portfolio/" class="hover:text-wood-accent transition-colors">My Work</a>
              <a href="/quick-portfolio/about/" class="hover:text-wood-accent transition-colors">About</a>
              <a href="/quick-portfolio/writings/" class="hover:text-wood-accent transition-colors">Writings</a>
              <a href="/quick-portfolio/sitemap/" class="hover:text-wood-accent transition-colors">Sitemap</a>
            </nav>
            <div class="h-6 w-px bg-gray-200 dark:bg-gray-800 hidden sm:block"></div>
            <div class="flex gap-4">
              <a
                href={`mailto:${CONTACT_EMAIL}`}
                class="text-gray-400 hover:text-wood-accent transition-colors p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252528] focus-visible:ring-2 focus-visible:ring-wood-accent focus-visible:outline-none"
                aria-label="Email Jun Alvior"
              >
                <span class="sr-only">Email</span>
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                  />
                </svg>
              </a>
              <a
                href="https://github.com/property360-2"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 hover:text-wood-accent transition-colors p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252528] focus-visible:ring-2 focus-visible:ring-wood-accent focus-visible:outline-none"
                aria-label="GitHub"
              >
                <span class="sr-only">GitHub</span>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z" />
                </svg>
              </a>
              <a
                href="https://www.linkedin.com/in/dionisio-jun-alvior-732987364/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-gray-400 hover:text-wood-accent transition-colors p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-[#252528] focus-visible:ring-2 focus-visible:ring-wood-accent focus-visible:outline-none"
                aria-label="LinkedIn"
              >
                <span class="sr-only">LinkedIn</span>
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                  />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </footer>
