---
import type { Article } from "../data/articles";

export interface Props {
  article: Article;
  index?: number;
  featured?: boolean;
}

const { article, index = 0, featured = false } = Astro.props;
const delay = Math.min(index * 50, 200);
const eager = index < 3;
---

<a
  href={article.href}
  class:list={[
    "article-row",
    { "article-row--featured": featured },
  ]}
  data-aos="fade-up"
  data-aos-delay={delay}
>
  <div class="article-row__media">
    <img
      src={article.image}
      alt=""
      aria-hidden="true"
      class="article-row__image"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      width={featured ? 460 : 176}
      height={featured ? 288 : 176}
    />
  </div>

  <div class="article-row__content">
    <time class="article-row__date" datetime={article.date}>
      {article.date}
    </time>

    <h4 class="article-row__title">{article.title}</h4>

    <p class="article-row__description">{article.description}</p>

    <div class="article-row__tags" aria-label="Article topics">
      {
        article.tags.map((tag) => (
          <span class="article-row__tag">{tag}</span>
        ))
      }
    </div>
  </div>
</a>

<style>
  .article-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    min-width: 0;
    overflow: hidden;
    padding: 0.875rem;
    border: 1px solid rgb(229 231 235 / 0.8);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.8);
    box-shadow: 0 1px 2px rgb(17 24 39 / 0.03);
    color: inherit;
    text-decoration: none;
    transition: transform 200ms ease-out, background-color 200ms ease-out,
      border-color 200ms ease-out, box-shadow 200ms ease-out;
  }

  .article-row:hover {
    transform: translateY(-2px);
    border-color: rgb(141 110 99 / 0.28);
    background: rgb(250 250 249);
    box-shadow: 0 8px 18px rgb(17 24 39 / 0.08);
  }

  .article-row:focus-visible {
    outline: 3px solid #8d6e63;
    outline-offset: 3px;
  }

  .article-row__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #efebe9;
  }

  .article-row__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 200ms ease-out;
  }

  .article-row:hover .article-row__image {
    transform: scale(1.03);
  }

  .article-row__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
  }

  .article-row__date {
    color: #9ca3af;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      "Liberation Mono", "Courier New", monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .article-row__title {
    margin: 0.5rem 0 0;
    color: #111827;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.35;
    transition: color 180ms ease-out;
  }

  .article-row:hover .article-row__title {
    color: #8d6e63;
  }

  .article-row__description {
    display: -webkit-box;
    margin: 0.45rem 0 0;
    overflow: hidden;
    color: #4b5563;
    font-size: 0.9375rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .article-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.8rem;
  }

  .article-row__tag {
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: #f3f4f6;
    color: #374151;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .article-row--featured {
    padding: 1rem;
    border-color: rgb(141 110 99 / 0.24);
    box-shadow: 0 10px 28px rgb(17 24 39 / 0.06);
  }

  .article-row--featured .article-row__title {
    font-size: 1.25rem;
  }

  :global(.dark) .article-row {
    border-color: #303030;
    background: rgb(255 255 255 / 0.03);
    box-shadow: none;
  }

  :global(.dark) .article-row:hover {
    border-color: rgb(188 170 164 / 0.35);
    background: rgb(255 255 255 / 0.06);
    box-shadow: 0 8px 18px rgb(0 0 0 / 0.16);
  }

  :global(.dark) .article-row__media {
    background: #2b2523;
  }

  :global(.dark) .article-row__title {
    color: #f9fafb;
  }

  :global(.dark) .article-row__description {
    color: #9ca3af;
  }

  :global(.dark) .article-row__tag {
    background: #27272a;
    color: #e5e7eb;
  }

  @media (min-width: 768px) {
    .article-row {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: center;
      padding: 1rem;
    }

    .article-row__media {
      width: 11rem;
      height: 11rem;
      aspect-ratio: 1;
    }

    .article-row__description {
      font-size: 0.875rem;
      -webkit-line-clamp: 2;
    }

    .article-row--featured {
      grid-template-columns: clamp(20.8rem, 42vw, 28.8rem) minmax(0, 1fr);
      gap: 1.5rem;
      align-items: stretch;
      padding: 1.125rem;
    }

    .article-row--featured .article-row__media {
      width: 100%;
      height: auto;
      min-height: 13rem;
      max-height: 18rem;
      aspect-ratio: 16 / 10;
    }

    .article-row--featured .article-row__title {
      font-size: 1.5rem;
    }
  }
</style>
