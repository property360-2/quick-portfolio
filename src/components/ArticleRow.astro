---
import type { Article } from "../data/articles";

export interface Props {
  article: Article;
  index?: number;
}

const { article, index = 0 } = Astro.props;
const delay = Math.min(index * 50, 200);
const eager = index < 3;
---

<a
  href={article.href}
  class="group flex items-start gap-6 p-4 -mx-4 rounded-xl transition-all duration-200 ease-out hover:bg-gray-50/50 dark:hover:bg-white/[0.04] focus-visible:outline-2 focus-visible:outline-wood-accent"
  data-aos="fade-up"
  data-aos-delay={delay}
>
  <time
    class="w-16 shrink-0 font-mono text-sm leading-snug text-gray-400 pt-0.5"
    datetime={article.date}
  >
    {article.date}
  </time>
  <div class="flex gap-4 sm:gap-6 flex-1 min-w-0">
    <img
      src={article.image}
      alt=""
      aria-hidden="true"
      class="w-[72px] h-[72px] sm:w-24 sm:h-24 lg:w-[104px] lg:h-[104px] rounded-xl object-cover flex-shrink-0 transition-transform duration-200 ease-out group-hover:scale-[1.03]"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      width={104}
      height={104}
    />
    <div class="flex-1 min-w-0">
      <h4
        class="text-base sm:text-lg font-bold text-gray-900 dark:text-white leading-snug transition-colors duration-180 ease-out group-hover:text-wood-accent"
      >
        {article.title}
      </h4>
      <p
        class="mt-1.5 text-sm text-gray-600 dark:text-gray-400 leading-relaxed line-clamp-2"
      >
        {article.description}
      </p>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {
          article.tags.map((tag) => (
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</a>
