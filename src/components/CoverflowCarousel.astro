---
interface Item { src: string; alt: string; label: string; href?: string }
interface Props { items: Item[]; autoIntervalMs?: number }
const { items, autoIntervalMs = 2600 } = Astro.props as Props;
const carouselId = `cf-${Math.random().toString(36).slice(2,7)}`;
---

<div id={carouselId} class="coverflow-root relative select-none" data-interval={autoIntervalMs}>
  <div class="coverflow-stage relative mx-auto w-full max-w-[580px] aspect-[16/11] sm:aspect-[16/10.5] perspective-[1400px] preserve-3d overflow-visible py-4">
    <div class="coverflow-track absolute inset-0 overflow-visible">
      {items.map((it, idx) => (
        <article
          class="coverflow-card group absolute top-1/2 left-1/2 will-change-transform cursor-pointer"
          data-index={idx}
          data-href={it.href || ""}
          aria-label={it.label}
          role="button"
          tabindex={idx === 0 ? 0 : -1}
        >
          <div class="relative w-[300px] sm:w-[360px] rounded-2xl overflow-hidden shadow-[0_24px_64px_-16px_rgba(0,0,0,0.65)]">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img src={it.src} alt={it.alt} loading={idx < 3 ? "eager" : "lazy"} decoding="async" class="w-full h-full object-cover object-top" draggable="false" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ carouselId }}>
(function(){
  var root = document.getElementById(carouselId);
  if (!root) return;
  var cards = Array.prototype.slice.call(root.querySelectorAll('.coverflow-card'));
  var n = cards.length;
  if (!n) return;
  var interval = parseInt(root.getAttribute('data-interval')||'3800',10);
  var current = 0;
  var autoTimer = null;
  var resumeTimer = null;
  var isDragging = false;
  var startX = 0;
  var deltaX = 0;
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function wrap(i){ return (i % n + n) % n; }
  function shortestDist(i){
    var d = i - current;
    if (d > n/2) d -= n;
    if (d < -n/2) d += n;
    return d;
  }

  function render(withTransition, dragX){
    if (prefersReduced) withTransition = false;
    var isMobile = window.innerWidth < 640;
    var step = isMobile ? 72 : 98;
    var tilt = 14;
    var dragProgress = 0;
    if (typeof dragX === 'number' && isDragging) {
      dragProgress = dragX / step;
    }
    cards.forEach(function(card, i){
      var dRaw = shortestDist(i) + dragProgress;
      // for visibility use rounded distance
      var dRounded = Math.round(dRaw);
      var adRounded = Math.abs(dRounded);
      var visible = adRounded <= 3;
      if (!visible) {
        card.style.opacity = '0';
        card.style.pointerEvents = 'none';
        card.style.transform = 'translate(-50%, -50%) translateX('+(dRaw*step)+'px) translateZ(-120px) scale(0.72) rotateZ('+(dRaw>0?tilt:-tilt)+'deg)';
        card.style.filter = 'blur(10px)';
        return;
      }
      // smooth lerp between integer steps
      var frac = dRaw - Math.floor(dRaw);
      if (dRaw < 0) frac = dRaw - Math.ceil(dRaw);
      // interpolate scale/opacity/blur based on fractional distance
      var ad = Math.abs(dRaw);
      var scale, opacity, blur, rotateY, rotateZ, translateZ;
      // lerp helper
      function lerp(a,b,t){ return a + (b-a)*Math.abs(t); }
      if (ad <= 1.2) {
        // between 0 and 1
        var t = Math.min(ad, 1);
        scale = lerp(1.1, 0.92, t);
        opacity = lerp(1, 0.58, t);
        blur = lerp(0, 5, t);
        rotateY = dRaw>0 ? -22*t : 22*t;
        rotateZ = dRaw>0 ? -tilt*t : tilt*t;
        translateZ = lerp(36, -12, t);
      } else if (ad <= 2.2) {
        var t = Math.min(ad-1, 1);
        scale = lerp(0.92, 0.85, t);
        opacity = lerp(0.58, 0.38, t);
        blur = lerp(5, 7, t);
        rotateY = dRaw>0 ? lerp(-22, -22, t) : lerp(22, 22, t);
        rotateZ = dRaw>0 ? -tilt : tilt;
        translateZ = lerp(-12, -42, t);
      } else {
        scale = 0.78;
        opacity = 0.22;
        blur = 9;
        rotateY = dRaw>0 ? -22 : 22;
        rotateZ = dRaw>0 ? -tilt : tilt;
        translateZ = -42;
      }
      var z = 30 - Math.abs(Math.round(dRaw));
      card.style.zIndex = String(z);
      card.style.pointerEvents = 'auto';
      card.style.opacity = String(opacity);
      var offsetX = dRaw * step;
      var tf = 'translate(-50%, -50%) translateX(' + offsetX + 'px) translateZ(' + translateZ + 'px) rotateY(' + rotateY + 'deg) rotateZ(' + rotateZ + 'deg) scale(' + scale + ')';
      if (withTransition && !isDragging) {
        card.style.transition = 'transform 620ms cubic-bezier(0.22,1,0.36,1), opacity 420ms ease, filter 420ms ease';
        requestAnimationFrame(function(){
          card.style.transform = tf;
          card.style.filter = 'blur(' + blur + 'px)';
        });
      } else {
        card.style.transition = 'none';
        card.style.transform = tf;
        card.style.filter = 'blur(' + blur + 'px)';
      }
      card.tabIndex = Math.abs(dRaw) < 0.5 ? 0 : -1;
    });
  }

  function goTo(i, withTransition){
    current = wrap(i);
    render(withTransition !== false);
    pauseAutoTemporarily();
  }
  function next(){ goTo(current+1, true); }
  function prev(){ goTo(current-1, true); }
  function autoNext(){ current = wrap(current+1); render(true); }

  function restartAuto(){
    if (prefersReduced) return;
    if (autoTimer) clearInterval(autoTimer);
    if (resumeTimer) clearTimeout(resumeTimer);
    autoTimer = setInterval(autoNext, interval);
  }
  function pauseAutoTemporarily(){
    if (autoTimer) clearInterval(autoTimer);
    autoTimer = null;
    if (resumeTimer) clearTimeout(resumeTimer);
    resumeTimer = setTimeout(restartAuto, 2200);
  }

  root.style.perspective = '1400px';
  var stage = root.querySelector('.coverflow-stage');
  stage.style.transformStyle = 'preserve-3d';
  render(false);
  requestAnimationFrame(function(){ render(true); });
  restartAuto();

  cards.forEach(function(card){
    card.addEventListener('click', function(){
      var idx = parseInt(card.getAttribute('data-index'),10);
      if (idx === wrap(current)) {
        var href = card.getAttribute('data-href');
        if (href) window.location.href = href;
        return;
      }
      goTo(idx, true);
    });
    card.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); card.click(); }
    });
  });

  function onDown(x){
    isDragging = true;
    startX = x;
    deltaX = 0;
    pauseAutoTemporarily();
    stage.style.cursor = 'grabbing';
    cards.forEach(function(c){ c.style.transition = 'none'; });
  }
  function onMove(x){
    if (!isDragging) return;
    deltaX = x - startX;
    render(false, deltaX);
  }
  function onUp(){
    if (!isDragging) return;
    isDragging = false;
    stage.style.cursor = 'grab';
    var th = 36;
    // snap to nearest based on drag distance
    var steps = Math.round(deltaX / (window.innerWidth < 640 ? 72 : 98));
    if (steps !== 0) {
      // drag right -> prev (positive delta), left -> next
      if (steps > 0) { for(var k=0;k<steps;k++) current = wrap(current-1); }
      else { for(var k=0;k<-steps;k++) current = wrap(current+1); }
      render(true);
      pauseAutoTemporarily();
    } else {
      if (Math.abs(deltaX) > th) {
        if (deltaX > 0) prev(); else next();
      } else {
        render(true);
      }
    }
    deltaX = 0;
  }

  stage.style.cursor = 'grab';
  stage.addEventListener('pointerdown', function(e){ if (e.pointerType==='mouse' && e.button!==0) return; stage.setPointerCapture(e.pointerId); onDown(e.clientX); });
  stage.addEventListener('pointermove', function(e){ if (!isDragging) return; onMove(e.clientX); });
  stage.addEventListener('pointerup', onUp);
  stage.addEventListener('pointercancel', onUp);
  stage.addEventListener('pointerleave', function(){ if (isDragging) onUp(); });

  root.addEventListener('keydown', function(e){
    if (e.key === 'ArrowRight') next();
    if (e.key === 'ArrowLeft') prev();
  });
  root.tabIndex = 0;
  document.addEventListener('visibilitychange', function(){ if (document.hidden) { if (autoTimer) clearInterval(autoTimer); } else restartAuto(); });
})();
</script>

<style>
  .coverflow-stage { transform-style: preserve-3d; }
  .coverflow-card { transform-style: preserve-3d; backface-visibility: hidden; }
</style>
