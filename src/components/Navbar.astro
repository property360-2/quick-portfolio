---
/**
 * Navigation bar component for the quick portfolio.
 * This component renders the top sticky navigation header, responsive links for desktop and mobile views,
 * brand branding, and theme toggling controls.
 * It integrates directly into the global Layout component to provide unified and persistent site navigation across all routes.
 */
---
<nav
      class="fixed w-full z-50 bg-white/70 dark:bg-[#1a1a1a]/70 backdrop-blur-md border-b border-gray-100 dark:border-gray-800 transition-colors duration-300"
    >
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <!-- ATOMS: Logo -->
          <div class="flex-shrink-0 flex items-center">
            <a
              href="/quick-portfolio/"
              class="text-2xl font-bold text-gray-900 dark:text-white tracking-tight flex items-center gap-2"
            >
              <span>Jun <span class="text-wood-accent">Alvior</span></span>
            </a>
          </div>

          <!-- MOLECULES: Desktop Menu -->
          <div class="hidden md:flex items-center gap-6">
            <a
              href="/quick-portfolio/"
              class:list={[
                "nav-link transition-colors font-medium",
                Astro.url.pathname === "/quick-portfolio/" || Astro.url.pathname === "/quick-portfolio" 
                  ? "text-wood-accent font-semibold" 
                  : "text-gray-600 dark:text-gray-300 hover:text-wood-accent dark:hover:text-wood-accent"
              ]}
              >Home</a
            >

            <a
              href="/quick-portfolio/contact/"
              class:list={[
                "nav-link transition-colors font-medium",
                Astro.url.pathname.includes("/contact") 
                  ? "text-wood-accent font-semibold" 
                  : "text-gray-600 dark:text-gray-300 hover:text-wood-accent dark:hover:text-wood-accent"
              ]}
              >Contact</a
            >
            <a
              href="/quick-portfolio/portfolio/"
              class:list={[
                "nav-link transition-colors font-medium",
                Astro.url.pathname.includes("/portfolio") 
                  ? "text-wood-accent font-semibold" 
                  : "text-gray-600 dark:text-gray-300 hover:text-wood-accent dark:hover:text-wood-accent"
              ]}
              >My Work</a
            >
            <a
              href="/quick-portfolio/writings/"
              class:list={[
                "nav-link transition-colors font-medium",
                Astro.url.pathname.includes("/writings") 
                  ? "text-wood-accent font-semibold" 
                  : "text-gray-600 dark:text-gray-300 hover:text-wood-accent dark:hover:text-wood-accent"
              ]}
              >Writings</a
            >
            <a
              href="/quick-portfolio/about/"
              class:list={[
                "nav-link transition-colors font-medium",
                Astro.url.pathname.includes("/about") 
                  ? "text-wood-accent font-semibold" 
                  : "text-gray-600 dark:text-gray-300 hover:text-wood-accent dark:hover:text-wood-accent"
              ]}
              >About Me</a
            >


            <!-- ATOMS: Theme Toggle (Desktop) -->
            <button
              id="theme-toggle"
              class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-wood-accent transition-all duration-300 hover:scale-110 active:scale-95"
              aria-label="Toggle Dark Mode"
            >
              <svg
                class="w-5 h-5 sun-icon hidden"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-12.37c-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06c-.39-.39-1.03-.39-1.41 0zm-12.37 12.37c-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06c-.39-.39-1.03-.39-1.41 0z"
                />
              </svg>
              <svg
                class="w-5 h-5 moon-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"
                />
              </svg>
            </button>
          </div>

          <!-- MOLECULES: Mobile Menu Button -->
          <div class="md:hidden flex items-center gap-4">
            <button
              id="theme-toggle-mobile"
              aria-label="Toggle Dark Mode"
              class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300 focus:ring-2 focus:ring-wood-accent focus:outline-none transition-all duration-300 hover:scale-110 active:scale-95"
            >
              <svg
                class="w-5 h-5 sun-icon hidden"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-12.37c-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06c-.39-.39-1.03-.39-1.41 0zm-12.37 12.37c-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06c-.39-.39-1.03-.39-1.41 0z"
                />
              </svg>
              <svg
                class="w-5 h-5 moon-icon"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"
                />
              </svg>
            </button>
            <button
              id="mobile-menu-btn"
              aria-expanded="false"
              aria-label="Toggle navigation menu"
              class="text-gray-600 dark:text-gray-300 hover:text-wood-accent focus:outline-none"
            >
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- MOLECULES: Mobile Menu Dropdown -->
      <div
        id="mobile-menu"
        class="hidden md:hidden bg-white dark:bg-[#1a1a1a] border-t border-gray-200 dark:border-gray-800 absolute w-full left-0"
      >
        <div class="px-4 pt-2 pb-6 space-y-2 shadow-lg">
          <a
            href="/quick-portfolio/"
            class:list={[
              "block px-3 py-3 rounded-md text-base font-medium transition-colors",
              Astro.url.pathname === "/quick-portfolio/" || Astro.url.pathname === "/quick-portfolio"
                ? "text-wood-accent bg-gray-50 dark:bg-gray-800"
                : "text-gray-700 dark:text-gray-200 hover:text-wood-accent dark:hover:text-wood-accent hover:bg-gray-50 dark:hover:bg-gray-800"
            ]}
            >Home</a
          >

          <a
            href="/quick-portfolio/contact/"
            class:list={[
              "block px-3 py-3 rounded-md text-base font-medium transition-colors",
              Astro.url.pathname.includes("/contact")
                ? "text-wood-accent bg-gray-50 dark:bg-gray-800"
                : "text-gray-700 dark:text-gray-200 hover:text-wood-accent dark:hover:text-wood-accent hover:bg-gray-50 dark:hover:bg-gray-800"
            ]}
            >Contact</a
          >
          <a
            href="/quick-portfolio/portfolio/"
            class:list={[
              "block px-3 py-3 rounded-md text-base font-medium transition-colors",
              Astro.url.pathname.includes("/portfolio")
                ? "text-wood-accent bg-gray-50 dark:bg-gray-800"
                : "text-gray-700 dark:text-gray-200 hover:text-wood-accent dark:hover:text-wood-accent hover:bg-gray-50 dark:hover:bg-gray-800"
            ]}
            >My Work</a
          >
          <a
            href="/quick-portfolio/writings/"
            class:list={[
              "block px-3 py-3 rounded-md text-base font-medium transition-colors",
              Astro.url.pathname.includes("/writings")
                ? "text-wood-accent bg-gray-50 dark:bg-gray-800"
                : "text-gray-700 dark:text-gray-200 hover:text-wood-accent dark:hover:text-wood-accent hover:bg-gray-50 dark:hover:bg-gray-800"
            ]}
            >Writings</a
          >
          <a
            href="/quick-portfolio/about/"
            class:list={[
              "block px-3 py-3 rounded-md text-base font-medium transition-colors",
              Astro.url.pathname.includes("/about")
                ? "text-wood-accent bg-gray-50 dark:bg-gray-800"
                : "text-gray-700 dark:text-gray-200 hover:text-wood-accent dark:hover:text-wood-accent hover:bg-gray-50 dark:hover:bg-gray-800"
            ]}
            >About Me</a
          >
        </div>
      </div>
    </nav>