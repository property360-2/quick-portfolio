<!--
Purpose: Represents the premium interactive floating Chatbot UI Widget on the portfolio website.
What it contains: Floating toggle buttons, a glassmorphic chat window, header controls, typing state animations, and scrollable message lists.
How it fits into the broader system: Mounted globally inside Layout.astro to offer conversational navigation and resume/about query services to visitors.
-->

---
/**
 * Chatbot UI Component
 * Renders the floating chat bubble, expandable conversation window, input stream, and typing indicators.
 * Leverages Astro's client bundling to import the chat utility for serverless backend API requests.
 */
---

<!-- Chatbot Floating Launcher Button -->
<button
  id="chatbot-launcher"
  aria-label="Open portfolio AI assistant chat window"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#d4a373] hover:bg-[#c39262] text-white rounded-full flex items-center justify-center shadow-xl hover:shadow-[#d4a373]/30 cursor-pointer select-none transition-all duration-300 transform hover:scale-110 active:scale-95 focus:outline-none focus:ring-2 focus:ring-[#d4a373] focus:ring-offset-2 dark:focus:ring-offset-[#1a1a1a]"
>
  <!-- Launcher Icon: Custom SVG Chat Bubble -->
  <svg
    id="icon-chat"
    class="w-6 h-6 transition-all duration-300 transform scale-100 rotate-0"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
    ></path>
  </svg>
  <!-- Close Icon (Hidden Initially): Custom SVG 'X' -->
  <svg
    id="icon-close"
    class="w-6 h-6 absolute transition-all duration-300 transform scale-0 rotate-90"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M6 18L18 6M6 6l12 12"
    ></path>
  </svg>
</button>

<!-- Chatbot Conversation Window -->
<div
  id="chatbot-window"
  role="dialog"
  aria-modal="true"
  aria-label="AI assistant chat"
  class="fixed bottom-24 right-6 w-[90vw] sm:w-[400px] h-[500px] z-50 flex flex-col rounded-2xl border border-gray-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md shadow-2xl overflow-hidden transition-all duration-300 transform scale-90 translate-y-4 opacity-0 pointer-events-none"
>
  <!-- Chat Header Bar -->
  <div class="px-5 py-4 border-b border-gray-200 dark:border-[#2d2d30] bg-gray-50/50 dark:bg-[#252528] flex items-center justify-between">
    <div class="flex items-center gap-2">
      <!-- Premium Minimalist Status Pulsing Orb -->
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-semibold tracking-wider text-gray-500 dark:text-zinc-400 uppercase select-none">
        AI Copilot
      </span>
    </div>
    
    <!-- Mini Minimize Button -->
    <button
      id="chatbot-minimize"
      aria-label="Minimize chat window"
      class="text-gray-400 hover:text-gray-600 dark:hover:text-white transition-colors cursor-pointer focus:outline-none"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
  </div>

  <!-- Messages Container -->
  <div
    id="chatbot-messages"
    class="flex-grow p-5 overflow-y-auto space-y-4 scrollbar-thin flex flex-col"
    aria-live="polite"
    aria-relevant="additions"
  >
    <!-- Dynamic Chat Bubbles Generated by Script -->
  </div>

  <!-- Bouncing Dots Typing Indicator Container (Hidden Initially) -->
  <div
    id="chatbot-typing-indicator"
    class="hidden px-5 py-3.5 bg-gray-50/30 dark:bg-zinc-900/30 border-t border-gray-100 dark:border-zinc-800/50 flex items-center gap-2"
  >
    <span class="text-[11px] font-medium text-gray-500 dark:text-gray-400 italic select-none">Assistant is typing</span>
    <div class="flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-[#d4a373] block animate-[bounce_1s_infinite_100ms]"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#d4a373] block animate-[bounce_1s_infinite_200ms]"></span>
      <span class="w-1.5 h-1.5 rounded-full bg-[#d4a373] block animate-[bounce_1s_infinite_300ms]"></span>
    </div>
  </div>

  <!-- Input Form Section -->
  <form
    id="chatbot-form"
    class="px-4 py-3 bg-gray-50/80 dark:bg-[#252528] border-t border-gray-200 dark:border-[#2d2d30] flex items-center"
  >
    <div class="relative flex-grow flex items-center bg-gray-100 dark:bg-[#1a1a1c] border border-gray-200 dark:border-[#2d2d30] rounded-2xl transition-all duration-300">
      <input
        type="text"
        id="chatbot-input"
        placeholder="Ask about Jun's projects, skills..."
        autocomplete="off"
        maxlength="500"
        class="w-full pl-4 pr-12 py-3 bg-transparent border-0 text-sm text-gray-900 dark:text-white focus:outline-none focus:ring-0 placeholder-gray-400 dark:placeholder-zinc-500"
      />
      <button
        type="submit"
        id="chatbot-submit"
        aria-label="Send message"
        class="absolute right-1.5 w-9 h-9 bg-[#d4a373] hover:bg-[#c39262] text-white rounded-xl flex items-center justify-center cursor-pointer select-none transition-all duration-300 active:scale-95 focus:outline-none"
      >
        <svg class="w-4 h-4 transform rotate-45 -translate-x-[1px] translate-y-[0.5px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M2 21l21-9L2 3v7l15 2-15 2v7z"></path>
        </svg>
      </button>
    </div>
  </form>
</div>

<!-- Custom Keyframes and explicit dark mode style overrides for rock-solid visual consistency -->
<style>
  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  /* Explicit launcher styles to guarantee high visibility in light mode and dark mode */
  :global(#chatbot-launcher) {
    background-color: #d4a373 !important;
    color: #ffffff !important;
  }
  :global(#chatbot-launcher:hover) {
    background-color: #c39262 !important;
  }
  :global(#chatbot-launcher svg) {
    stroke: #ffffff !important;
    fill: none !important;
  }

  /* Unified input pill-shaped container and inner input overrides */
  :global(#chatbot-form .relative) {
    background-color: #f3f4f6 !important;
    border-color: #e5e7eb !important;
  }
  :global(.dark #chatbot-form .relative) {
    background-color: #1a1a1c !important;
    border-color: #2d2d30 !important;
  }
  :global(#chatbot-form .relative:focus-within) {
    border-color: #d4a373 !important;
    box-shadow: 0 0 0 1px rgba(212, 163, 115, 0.3) !important;
  }
  
  :global(#chatbot-input) {
    color: #111827 !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }
  :global(.dark #chatbot-input) {
    color: #ffffff !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  /* Submit button nested inside input */
  :global(#chatbot-submit) {
    background-color: #d4a373 !important;
    color: #ffffff !important;
  }
  :global(#chatbot-submit:hover) {
    background-color: #c39262 !important;
  }
  :global(#chatbot-submit svg) {
    fill: #ffffff !important;
  }

  /* Window borders and internal dividers in light mode */
  :global(#chatbot-window) {
    border-color: #e5e7eb !important;
  }
  :global(#chatbot-window .border-b),
  :global(#chatbot-window .border-t),
  :global(#chatbot-typing-indicator) {
    border-color: #e5e7eb !important;
  }

  /* Window borders and internal dividers in dark mode, matching the About page timeline/components */
  :global(.dark #chatbot-window) {
    border-color: #2d2d30 !important;
    background-color: #1a1a1a !important;
  }
  :global(.dark #chatbot-window div.border-b) {
    background-color: #252528 !important;
    border-color: #2d2d30 !important;
  }
  :global(.dark #chatbot-window form) {
    background-color: #252528 !important;
    border-color: #2d2d30 !important;
  }
  :global(.dark #chatbot-typing-indicator) {
    background-color: #252528 !important;
    border-color: #2d2d30 !important;
  }

  /* High-contrast explicit color and border rules for assistant message bubbles to prevent dark-on-dark text */
  :global(#chatbot-messages .self-start) {
    border-color: rgba(229, 231, 235, 0.5) !important;
  }
  :global(.dark #chatbot-messages .self-start) {
    border-color: #2d2d30 !important;
  }

  :global(#chatbot-messages .self-start),
  :global(#chatbot-messages .self-start *) {
    color: #1f2937 !important; /* gray-800 */
  }
  :global(.dark #chatbot-messages .self-start),
  :global(.dark #chatbot-messages .self-start *) {
    color: #e4e4e7 !important; /* zinc-200 */
  }

  /* Keep links inside assistant bubbles visibly distinct from surrounding text */
  :global(#chatbot-messages a),
  :global(.dark #chatbot-messages a) {
    color: #d4a373 !important; /* wood accent */
    text-decoration: underline !important;
  }
</style>

<!-- Dynamic Client-Side Interactive Script -->
<script>
  // @ts-nocheck
  import { sendChatMessage, type ChatMessage } from "../utils/chat";

  /**
   * Orchestrates the active lifecycle of the portfolio chatbot widget in the browser client.
   * Manages opening/closing CSS layout states, renders conversational message bubbles,
   * handles browser sessionStorage syncing, triggers API fetches, and formats dynamic user-friendly errors.
   */
  document.addEventListener("DOMContentLoaded", () => {
    const launcher = document.getElementById("chatbot-launcher");
    const windowEl = document.getElementById("chatbot-window");
    const minimizeBtn = document.getElementById("chatbot-minimize");
    const messagesContainer = document.getElementById("chatbot-messages");
    const typingIndicator = document.getElementById("chatbot-typing-indicator");
    const form = document.getElementById("chatbot-form") as HTMLFormElement;
    const input = document.getElementById("chatbot-input") as HTMLInputElement;

    const iconChat = document.getElementById("icon-chat");
    const iconClose = document.getElementById("icon-close");

    if (!launcher || !windowEl || !minimizeBtn || !messagesContainer || !typingIndicator || !form || !input || !iconChat || !iconClose) return;

    let isOpen = false;
    let messages: ChatMessage[] = [];

    // Base welcoming text automatically injected on first invocation.
    const WELCOME_GREETING: ChatMessage = {
      role: "assistant",
      content: "Hello! I am Jun Alvior's AI assistant. Ask me anything about his skills, custom software projects, B2B automations, or how you can get in touch with him!"
    };

    /**
     * Toggles the visible scaling, opacity, and accessibility pointer events of the Chat Window.
     * Transitions open launcher icons between standard chat bubbles and close crosses.
     */
    function toggleChat() {
      isOpen = !isOpen;
      if (isOpen) {
        windowEl.classList.remove("scale-90", "translate-y-4", "opacity-0", "pointer-events-none");
        windowEl.classList.add("scale-100", "translate-y-0", "opacity-100", "pointer-events-auto");
        
        iconChat.classList.add("scale-0", "rotate-90");
        iconChat.classList.remove("scale-100", "rotate-0");
        iconClose.classList.add("scale-100", "rotate-0");
        iconClose.classList.remove("scale-0", "rotate-90");

        input.focus();
        scrollToBottom();
      } else {
        windowEl.classList.remove("scale-100", "translate-y-0", "opacity-100", "pointer-events-auto");
        windowEl.classList.add("scale-90", "translate-y-4", "opacity-0", "pointer-events-none");
        
        iconChat.classList.add("scale-100", "rotate-0");
        iconChat.classList.remove("scale-0", "rotate-90");
        iconClose.classList.add("scale-0", "rotate-90");
        iconClose.classList.remove("scale-100", "rotate-0");
      }
    }

    /**
     * Scrolls the chat message display block completely to the bottom.
     * Keeps recent conversation entries immediately visible to users.
     */
    function scrollToBottom() {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    /**
     * Loads the conversation history array cache from session storage.
     * Automatically injects the welcoming message if first turn initialized.
     */
    function loadHistory() {
      try {
        const cached = sessionStorage.getItem("portfolio_chatbot_history");
        if (cached) {
          messages = JSON.parse(cached);
        } else {
          messages = [WELCOME_GREETING];
          sessionStorage.setItem("portfolio_chatbot_history", JSON.stringify(messages));
        }
      } catch (err) {
        console.error("Failed to load chat history cache:", err);
        messages = [WELCOME_GREETING];
      }
      renderMessages();
    }

    /**
     * Formats raw chat message strings into secure, rich HTML layouts by parsing basic Markdown.
     * This method prevents cross-site scripting (XSS) by escaping dangerous characters (&, <, >, ", '),
     * translates markdown strong tags (**bold**) into strong elements, parses line item lists
     * starting with * or - into distinct, properly nested bullet list elements (ul and li),
     * and groups other text items into structured spacing paragraphs.
     * It handles multiline blocks cleanly by mapping line structures and sanitizing all user inputs in-place.
     *
     * @param {string} content - The raw plaintext or markdown string returned by the chat stream.
     * @returns {string} The fully compiled, safe, styled HTML string ready for template insertion.
     */
    function formatMessageContent(content: string): string {
      // Step 1: Strict input sanitation to prevent XSS (complying fully with Rule 13)
      const escaped = content
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

      // Renders a markdown link only for safe protocols; rejects javascript: etc.
      const renderLink = (text: string, rawUrl: string): string => {
        const href = rawUrl.replace(/&amp;/g, "&");
        if (/^(https?:\/\/|mailto:|\/)/i.test(href)) {
          return `<a href="${href}" target="_blank" rel="noopener noreferrer" class="text-wood-accent underline break-all">${text}</a>`;
        }
        return text;
      };

      // Step 2: Stateful line-by-line parsing for code, links, bold, lists, and paragraphs
      const lines = escaped.split("\n");
      const parsedElements: string[] = [];
      let inList = false;
      let inOrderedList = false;

      lines.forEach((line) => {
        let trimmed = line.trim();
        if (!trimmed) {
          if (inList) {
            parsedElements.push("</ul>");
            inList = false;
          }
          if (inOrderedList) {
            parsedElements.push("</ol>");
            inOrderedList = false;
          }
          parsedElements.push('<div class="h-2"></div>');
          return;
        }

        // Inline code spans first, shielded with placeholders so later rules don't touch them
        const codeSpans: string[] = [];
        trimmed = trimmed.replace(/`([^`]+)`/g, (_m, code: string) => {
          codeSpans.push(`<code class="px-1.5 py-0.5 rounded bg-gray-200 dark:bg-zinc-800 font-mono text-xs">${code}</code>`);
          return `\u0000${codeSpans.length - 1}\u0000`;
        });

        // Markdown links [text](url)
        trimmed = trimmed.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, text: string, url: string) => renderLink(text, url));

        // Bold **text**
        trimmed = trimmed.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");

        // Restore code spans
        trimmed = trimmed.replace(/\u0000(\d+)\u0000/g, (_m, idx: string) => codeSpans[Number(idx)] ?? "");

        const orderedMatch = trimmed.match(/^(\d+)\.\s+(.*)$/);
        const bulletMatch = trimmed.match(/^[-*]\s+(.*)$/);

        if (orderedMatch) {
          if (inList) {
            parsedElements.push("</ul>");
            inList = false;
          }
          if (!inOrderedList) {
            parsedElements.push('<ol class="my-2 space-y-1 list-decimal text-gray-800 dark:text-zinc-200">');
            inOrderedList = true;
          }
          parsedElements.push(`<li class="ml-5 pl-1 my-1">${orderedMatch[2]}</li>`);
        } else if (bulletMatch) {
          if (inOrderedList) {
            parsedElements.push("</ol>");
            inOrderedList = false;
          }
          if (!inList) {
            parsedElements.push('<ul class="my-2 space-y-1 text-gray-800 dark:text-zinc-200">');
            inList = true;
          }
          parsedElements.push(`<li class="ml-4 list-disc pl-1 my-1">${bulletMatch[1]}</li>`);
        } else {
          if (inList) {
            parsedElements.push("</ul>");
            inList = false;
          }
          if (inOrderedList) {
            parsedElements.push("</ol>");
            inOrderedList = false;
          }
          parsedElements.push(`<p class="mb-2 leading-relaxed text-gray-800 dark:text-zinc-200">${trimmed}</p>`);
        }
      });

      if (inList) {
        parsedElements.push("</ul>");
      }
      if (inOrderedList) {
        parsedElements.push("</ol>");
      }

      return parsedElements.join("");
    }

    /**
     * Instantiates and appends a styled message bubble DOM element to the scrolling container.
     * It parses msg content using formatMessageContent, determines user vs assistant layout orientation,
     * assigns premium dark mode theme classes matching the 'About' section card backgrounds (bg-[#252528] with borderzinc-800),
     * and triggers a scroll adjustment to keep the new bubble immediately visible to the user.
     *
     * @param {ChatMessage} msg - The message object containing the role ('user' or 'assistant') and raw text content.
     */
    function renderMessageBubble(msg: ChatMessage) {
      const bubble = document.createElement("div");
      
      if (msg.role === "user") {
        bubble.className = "self-end max-w-[85%] bg-[#d4a373] text-white px-4 py-3 rounded-2xl rounded-tr-none text-sm leading-relaxed shadow-sm break-words";
        bubble.innerHTML = formatMessageContent(msg.content);
      } else {
        bubble.className = "self-start max-w-[85%] bg-gray-100 dark:bg-[#252528] text-gray-800 dark:text-zinc-200 px-4 py-3 rounded-2xl rounded-tl-none text-sm leading-relaxed shadow-sm border border-gray-200/50 dark:border-[#2d2d30] break-words";
        bubble.innerHTML = formatMessageContent(msg.content);
      }
      
      messagesContainer.appendChild(bubble);
    }

    /**
     * Re-renders the entire message container using current context.
     * Completely clears the list element and rebuilds each individual bubble from cache.
     * Accepts no arguments and returns nothing.
     */
    function renderMessages() {
      messagesContainer.innerHTML = "";
      messages.forEach(renderMessageBubble);
      scrollToBottom();
    }

    /**
     * Handles incoming form submits, handles inputs, triggers API requests,
     * toggles typing animations, and appends incoming LLM model answers.
     *
     * @param {SubmitEvent} e - The browser submit event.
     */
    async function handleMessageSubmit(e: SubmitEvent) {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      input.value = "";
      
      // Append user prompt turns
      const userMsg: ChatMessage = { role: "user", content: text };
      messages.push(userMsg);
      renderMessageBubble(userMsg);
      scrollToBottom();

      // Show bouncing indicator
      typingIndicator.classList.remove("hidden");
      scrollToBottom();

      try {
        // Send request to serverless API proxy using dynamic utility
        const responseData = await sendChatMessage(text, messages.slice(0, -1));

        const replyMsg: ChatMessage = { role: "assistant", content: responseData.reply };
        messages.push(replyMsg);
        renderMessageBubble(replyMsg);

        // Update session storage
        sessionStorage.setItem("portfolio_chatbot_history", JSON.stringify(messages));
      } catch (err: any) {
        console.error("Chatbot processing error:", err);
        const errMsg: ChatMessage = {
          role: "assistant",
          content: err?.message ?? "I apologize, but I ran into a network bottleneck. Please check your connection or try again."
        };
        renderMessageBubble(errMsg);
      } finally {
        // Dismiss loading animation
        typingIndicator.classList.add("hidden");
        scrollToBottom();
      }
    }

    // Attach Event Listeners
    launcher.addEventListener("click", toggleChat);
    minimizeBtn.addEventListener("click", toggleChat);
    form.addEventListener("submit", handleMessageSubmit);

    // Bootstrap conversation history cache on initial component paint
    loadHistory();
  });
</script>
