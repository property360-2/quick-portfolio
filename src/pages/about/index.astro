<script>
  import { animate } from 'animejs';

  /**
   * Initializes interactive SVG background ring animations for the About page.
   * It sets up infinite idle rotation for the outer ring, inner ring, and orbit dot,
   * as well as a subtle parallax offset on mouse move for the background ring element.
   * The user profile picture itself remains completely static without any transformation.
   * Accepts no arguments and returns nothing.
   */
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("about-image-container");
    const outerRing = document.querySelector(".about-ring-outer");
    const innerRing = document.querySelector(".about-ring-inner");
    const orbitDot = document.querySelector(".about-orbit-dot");

    if (container) {
      // Idle rotation for background decorative rings
      animate(outerRing, {
        rotateZ: 360,
        duration: 20000,
        ease: 'linear',
        loop: true,
        transformOrigin: '100px 100px'
      });

      animate(innerRing, {
        rotateZ: -360,
        duration: 15000,
        ease: 'linear',
        loop: true,
        transformOrigin: '100px 100px'
      });

      animate(orbitDot, {
        rotateZ: 360,
        duration: 5000,
        ease: 'linear',
        loop: true,
        transformOrigin: '100px 100px'
      });

      /**
       * Mouse tracking handler to apply a subtle parallax effect on the background SVG rings.
       * Accepts the MouseEvent object and calculates relative delta from the container's center.
       */
      window.addEventListener("mousemove", (e) => {
        const rect = container.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        
        const deltaX = e.clientX - centerX;
        const deltaY = e.clientY - centerY;
        
        // Parallax effect restricted exclusively to the background SVG rings
        animate('#about-interactive-ring', {
          translateX: deltaX * 0.05,
          translateY: deltaY * 0.05,
          duration: 300,
          ease: 'easeOutSine'
        });
      });
      
      /**
       * Click interaction handler targeting only the background outer ring.
       * Accepts no parameters and triggers a temporary outer ring expansion.
       */
      container.addEventListener("click", () => {
        animate(outerRing, {
          scale: [1, 1.1, 1],
          duration: 400,
          ease: 'easeInOutSine'
        });
      });
    }
  });
</script>
