---
/**
 * About Page Component
 * Purpose: Provides a detailed overview of Jun Alvior's professional journey, technical expertise, and core competencies.
 * Contains: Introduction, detailed Tech Stack categories (PHP, Django, Frontend, Firebase/BaaS), and professional experience timeline.
 * System Role: One of the primary informational pages helping potential clients/employers understand the developer's background.
 */
import Layout from '../../layouts/Layout.astro';
const title = 'About Jun Alvior | Full Stack Software Developer';
const description = "Learn about Jun Alvior's journey from construction to code. A dedicated Full Stack Software Developer with a blend of tech expertise and strong work ethic. ✓";
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: About Me -->
      <section
        id="about"
        class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            <div>
              <div class="mb-8 gs-reveal">
                <img
                  src="../assets/junjun.webp"
                  alt="Jun Alvior"
                  class="w-48 h-48 rounded-full object-cover shadow-lg border-4 border-white dark:border-gray-800"
                  loading="lazy"
                  decoding="async"
                  width="192"
                  height="192"
                />
              </div>
              <h2
                class="text-sm font-bold tracking-widest text-wood-accent uppercase gs-reveal"
              >
                About Me
              </h2>
              <h3
                class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl mb-6 gs-reveal"
              >
                Beyond the Code
              </h3>
              <div
                class="prose dark:prose-invert prose-lg prose-wood text-gray-700 dark:text-gray-300"
              >
                <p class="mb-4">
                  Hi! I’m
                  <strong class="text-wood-accent font-bold"
                    >Dionisio Alvior</strong
                  >
                  aka
                  <strong class="text-wood-accent font-bold">Jun</strong>, a
                  22-year-old full stack software developer and a 4th-year BSIS
                  student. I love building web applications that are
                  <strong>functional, beautiful, and user-friendly</strong>,
                  utilizing a diverse range of modern technologies including
                  <strong
                    >PHP (Laravel), Python (Django), Frontend (Astro, Next.js),
                    and Firebase</strong
                  >
                  to create high-impact solutions.
                </p>
                <p class="mb-4">
                  I’ve also embraced <strong>AI-assisted development</strong>,
                  which helps me speed up repetitive tasks and explore creative
                  solutions. Over the years, working with clients and receiving
                  feedback has taught me a lot — not just about coding, but also
                  about designing systems with <strong>better UX/UI</strong>.
                </p>
                <p>
                  Currently, I’m a <strong>Full Stack Software Developer</strong> at my
                  school, leading the development of a full school portal. I
                  enjoy
                  <strong
                    >collaborating with others, learning new tools, and building
                    smarter software</strong
                  >
                  every day.
                </p>
              </div>

              <div class="mt-8 space-y-6">
                <div>
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-widest mb-3">
                    PHP Development
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Laravel API-only</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Laravel Full-stack (Blade)</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Vanilla PHP</span>
                  </div>
                </div>

                <div>
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-widest mb-3">
                    Django / Python
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Django API-only</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Django Full-stack (Templates)</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Vanilla Python</span>
                  </div>
                </div>

                <div>
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-widest mb-3">
                    Frontend
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Astro</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Next.js</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">HTML / CSS / JS</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">React</span>
                  </div>
                </div>

                <div>
                  <h4 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-widest mb-3">
                    Firebase & BaaS
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Firebase Auth</span>
                    <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-sm text-gray-600 dark:text-gray-300">Hardcoded Automation Workflows</span>
                  </div>
                </div>
              </div>
            </div>

            <div
              class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700"
              data-aos="fade-left"
            >
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
                Experience
              </h4>

              <div
                class="space-y-8 border-l-2 border-gray-200 dark:border-gray-700 ml-3 pl-8 relative"
              >
                <!-- Timeline Item 1 -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-wood-accent"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Freelance Software Developer
                  </h5>
                  <span class="text-sm text-wood-accent font-bold font-medium"
                    >Remote/Freelance • 2022 - Present</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1"
                  >
                    <p>
                      • Built solutions for businesses — from simple sales and
                      inventory systems to capstone-level projects.
                    </p>
                    <p>
                      • Focused on improving <strong>UX/UI</strong> based on
                      client feedback, which helped me grow as a developer.
                    </p>
                  </div>
                </div>

                <!-- Timeline Item 2 -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-wood-accent"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Full Stack Software Developer
                  </h5>
                  <span class="text-sm text-wood-accent font-bold font-medium"
                    >2025 - Present</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1"
                  >
                    <p>
                      • Managing the complete software development process from
                      conception to deployment.
                    </p>
                    <p>
                      • Planning the software development architecture,
                      including database schema design, data flow, system
                      architecture, and technology stack selection.
                    </p>
                    <p>
                      • Maintaining and upgrading the software following
                      deployment.
                    </p>
                    <p>
                      • Managing the end-to-end life cycle for the production of
                      software and applications.
                    </p>
                    <p>
                      • Overseeing and guiding the analyzing, writing, building,
                      and deployment of software.
                    </p>
                    <p>
                      • Overseeing the automated testing and providing feedback
                      to management during the development process.
                    </p>
                    <p>
                      • Modifying and testing changes to previously developed
                      programs.
                    </p>
                  </div>
                </div>

                <!-- Timeline Item 3 -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-gray-300 dark:bg-gray-600"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Recruitment Associate
                  </h5>
                  <span class="text-sm text-wood-accent font-bold font-medium"
                    >Previous Experience</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1"
                  >
                    <p>
                      • Interviewed candidates and helped them find suitable job
                      opportunities.
                    </p>
                    <p>
                      • Managed client and candidate information efficiently.
                    </p>
                    <p>
                      • Learned how to communicate clearly and understand user
                      needs — skills I also apply in software projects.
                    </p>
                  </div>
                </div>

                <!-- Timeline Item 4 -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-gray-300 dark:bg-gray-600"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Other Experiences
                  </h5>
                  <span class="text-sm text-wood-accent font-bold font-medium"
                    >Life Skills & Work Ethic</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1"
                  >
                    <p class="italic mb-2">
                      Before diving into software development full-time, I tried
                      a lot of different roles — from
                      <strong
                        >tutoring kids, construction work, equipment handling,
                        welding, aluminum assembly, masonry, vending, to labor
                        work</strong
                      >.
                    </p>
                    <p>
                      Each experience taught me
                      <strong
                        >discipline, adaptability, and a strong work
                        ethic</strong
                      >, which I carry into every project I build today.
                    </p>
                  </div>
                </div>
              </div>

              <div
                class="mt-10 pt-6 border-t border-gray-100 dark:border-gray-700"
              >
                <a
                  href="mailto:junalvior21@gmail.com"
                  class="flex items-center text-wood-accent font-bold hover:text-wood-accent dark:hover:text-wood-accent font-medium transition-colors"
                >
                  <svg class="w-6 h-6 mr-2" viewBox="0 0 24 24" fill="currentColor">
                    <path
                      d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                    />
                  </svg>
                  Get in touch
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ORGANISMS: Core Competencies -->
      <section
        id="competencies"
        class="py-24 bg-white dark:bg-[#1f1f1f] border-t border-gray-100 dark:border-gray-800"
