                  />
                </svg>
              </div>
              <div>
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  System Architecture
                </h4>
                <p
                  class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed"
                >
                  Extensive experience designing full-cycle applications, from
                  relational database schemas to responsive frontend state
