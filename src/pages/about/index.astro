                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.44 14.8c-.2.2-.45.3-.78.3-.33 0-.59-.1-.78-.3-.19-.19-.29-.46-.29-.81 0-.35.1-.62.29-.81.2-.2.45-.3.78-.3.33 0 .59.1.78.3.19.2.29.47.29.81s-.1.62-.29.81zM14.24 11c-.34.42-.87.89-1.57 1.4-.29.21-.52.41-.69.6-.17.18-.3.36-.39.52-.09.16-.16.32-.2.48-.04.16-.08.3-.11.41h-1.31c.03-.27.09-.57.17-.9s.2-.66.36-1c.16-.34.39-.67.68-.99.29-.32.65-.67 1.07-1.04.41-.37.74-.71.99-1.02.25-.31.37-.64.37-1.01 0-.35-.13-.65-.4-.9-.27-.25-.63-.38-1.07-.38-.45 0-.82.13-1.1.38-.28.25-.43.55-.44.89h-1.32c.02-.7.27-1.27.76-1.71.49-.44 1.14-.66 1.97-.66.86 0 1.54.23 2.05.69.51.46.77 1.07.77 1.83 0 .5-.11.95-.33 1.34z"
                  />
