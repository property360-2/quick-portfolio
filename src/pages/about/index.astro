---
/**
 * About Page Component
 * Purpose: Provides a detailed overview of Jun Alvior's professional journey, technical expertise, and core competencies.
 * Contains: Introduction, detailed Tech Stack categories (PHP, Django, Frontend, Firebase/BaaS), and professional experience timeline.
 * System Role: One of the primary informational pages helping potential clients/employers understand the developer's background.
 */
import Layout from '../../layouts/Layout.astro';
const title = 'About Jun Alvior | Full Stack Developer & Business Automation Specialist';
const description = "I build fast, secure web applications, custom dashboards, automation scripts, and secure portals to automate business workflows and streamline operations. ✓";
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: About Me -->
      <section
        id="about"
        class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            <div>
              <div class="mb-8 gs-reveal relative w-fit" id="about-image-container">
                <!-- Interactive SVG Background -->
                <svg viewBox="0 0 200 200" class="absolute inset-0 w-full h-full scale-[1.3] pointer-events-none z-0" id="about-interactive-ring">
                  <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="2" class="text-wood-accent/30 dark:text-wood-accent/20 about-ring-outer" stroke-dasharray="8 8" />
                  <circle cx="100" cy="100" r="75" fill="none" stroke="currentColor" stroke-width="1" class="text-wood-accent/50 about-ring-inner" />
                  <circle cx="10" cy="100" r="5" fill="currentColor" class="text-wood-accent about-orbit-dot" />
                </svg>
                <img
                  src="../assets/junjun.webp"
                  alt="Jun Alvior"
                  class="relative z-10 w-48 h-48 rounded-full object-cover shadow-lg border-4 border-white dark:border-gray-800 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                  width="192"
                  height="192"
                  id="about-profile-img"
                />
              </div>
              <h2
                class="text-sm font-bold tracking-widest text-wood-accent uppercase gs-reveal"
              >
                Specialist Profile
              </h2>
              <h3
                class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl mb-6 gs-reveal"
              >
                Turning Ideas into Automated Reality
              </h3>
              <div
                class="prose dark:prose-invert prose-lg prose-wood text-gray-700 dark:text-gray-300"
              >
                <p class="mb-4">
                  Having spent years in labor and construction, I don't look at software as just code—I look at it as a tool that needs to be durable, functional, and built on a solid foundation. I bring that same blue-collar work ethic to software engineering. I build practical, no-nonsense custom software, workflow automation, and AI tools that solve real-world operational headaches.
                </p>
                <p class="mb-4">
                  Rather than just writing lines of code, I engineer complete, durable systems designed to solve operational bottlenecks and eliminate manual effort. By developing custom solutions—ranging from <strong>client management dashboards</strong> and <strong>secure customer portals</strong> to <strong>automated database integrations</strong>—I bridge the gap between complex software design and actual business ROI.
                </p>
                <p>
                  I specialize in connecting disparate tools like CRMs, Google Workspace APIs, database layers, and automation flows to create a unified, automated experience. My goal is to help businesses transition from manual spreadsheets and fragile, repetitive tasks to <strong>scalable, secure digital infrastructure</strong>.
                </p>
              </div>
            </div>

            <div
              class="bg-white dark:bg-[#252528] p-8 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800"
              data-aos="fade-left"
            >
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
                Professional Journey
              </h4>

              <div
                class="space-y-8 border-l-2 border-gray-200 dark:border-gray-800 ml-3 pl-8 relative"
              >
                <!-- Timeline Item 1: Richwell Colleges Incorporated -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-wood-accent"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Full Stack Developer Intern
                  </h5>
                  <span class="text-sm text-wood-accent font-bold"
                    >Richwell Colleges Incorporated • Internship (Present)</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1.5"
                  >
                    <p>
                      • Managing the complete software development process from architectural design to final deployment.
                    </p>
                    <p>
                      • Architecting database schemas, data flows, systems architecture, and managing the end-to-end production lifecycle.
                    </p>
                    <p>
                      • Overseeing automated testing pipelines, modifying code, and maintaining software stability post-deployment.
                    </p>
                  </div>
                </div>

                <!-- Timeline Item 2: Freelance Solutions -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-wood-accent"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Software Developer Freelancer
                  </h5>
                  <span class="text-sm text-wood-accent font-bold"
                    >Remote / Freelance • 2022 - 2025</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1.5"
                  >
                    <p>
                      • Engineered customized solutions for local businesses, including sales trackers and inventory management portals.
                    </p>
                    <p>
                      • Focused on rapid UX/UI updates guided directly by client operational feedback loops.
                    </p>
                  </div>
                </div>

                <!-- Timeline Item 3: Lexie Staffing -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-gray-300 dark:bg-gray-600"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Recruitment Associate
                  </h5>
                  <span class="text-sm text-wood-accent font-bold"
                    >Lexie Staffing and Business Consulting</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1.5"
                  >
                    <p>
                      • Coordinated candidate intakes, managed ATS information integrity, and prepared employment contracts.
                    </p>
                    <p>
                      • Generated recruitment metrics and reports to assist HR management decisions.
                    </p>
                  </div>
                </div>
              </div>

              <div
                class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-800"
              >
                <a
                  href="/quick-portfolio/contact/"
                  class="group mt-6 flex items-center justify-between p-4 bg-wood-accent text-white rounded-xl font-bold hover:bg-wood-accent/90 transition-all shadow-lg hover:shadow-wood-accent/20"
                >
                  <div class="flex items-center">
                    <svg class="w-6 h-6 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Get in Touch / View Resume</span>
                  </div>
                  <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Tech Stack Details Grid (Full-Width) -->
          <div class="mt-16 pt-16 border-t border-gray-200 dark:border-gray-800/50">
            <h4 class="text-xs font-bold tracking-widest text-wood-accent uppercase mb-8 text-center">Technical Toolbox</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              <!-- Card 1: Workflow Automation & AI -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Workflow Automation & AI
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">RAG (AI Architecture)</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">API Orchestration</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Google Sheets DB Integration</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Webhook Integration</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">n8n Automation</span>
                </div>
              </div>

              <!-- Card 2: Backend Infrastructure -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Backend Infrastructure
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Laravel / Django</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Node.js / Express.js</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">PostgreSQL / Supabase</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">MongoDB / Firebase</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">REST API Design</span>
                </div>
              </div>

              <!-- Card 3: Cloud Systems -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Cloud Systems
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">AWS Lambda / EC2</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Serverless Functions</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">AWS S3</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Vercel Deployment</span>
                </div>
              </div>

              <!-- Card 4: Interactive Frontends -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
