---
/**
 * About Page Component
 * Purpose: Provides a detailed overview of Jun Alvior's professional journey, technical expertise, and core competencies.
 * Contains: Introduction, detailed Tech Stack categories (PHP, Django, Frontend, Firebase/BaaS), and professional experience timeline.
 * System Role: One of the primary informational pages helping potential clients/employers understand the developer's background.
 */
import Layout from '../../layouts/Layout.astro';
const title = 'About Jun Alvior | Full Stack Developer & Business Automation';
const description = "I build fast, secure web applications, custom dashboards, automation scripts, and secure portals to automate business workflows and streamline operations. ✓";
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: About Me -->
      <section
        id="about"
        class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
            <div>
              <div class="mb-8 gs-reveal relative w-fit" id="about-image-container">
                <!-- Interactive SVG Background -->
                <svg viewBox="0 0 200 200" class="absolute inset-0 w-full h-full scale-[1.3] pointer-events-none z-0" id="about-interactive-ring">
                  <circle cx="100" cy="100" r="90" fill="none" stroke="currentColor" stroke-width="2" class="text-wood-accent/30 dark:text-wood-accent/20 about-ring-outer" stroke-dasharray="8 8" />
                  <circle cx="100" cy="100" r="75" fill="none" stroke="currentColor" stroke-width="1" class="text-wood-accent/50 about-ring-inner" />
                  <circle cx="10" cy="100" r="5" fill="currentColor" class="text-wood-accent about-orbit-dot" />
                </svg>
                <img
                  src="/quick-portfolio/assets/junjun.webp"
                  alt="Jun Alvior"
                  class="relative z-10 w-48 h-48 rounded-full object-cover shadow-lg border-4 border-white dark:border-gray-800 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                  width="192"
                  height="192"
                  id="about-profile-img"
                />
              </div>
              <h2
                class="text-sm font-bold tracking-widest text-wood-accent uppercase gs-reveal"
              >
                About Me
              </h2>
              <h3
                class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl mb-6 gs-reveal"
              >
                Full-Stack Developer Building Practical Software
              </h3>
              <div
                class="prose dark:prose-invert prose-lg prose-wood text-gray-700 dark:text-gray-300"
              >
                <p class="mb-4">
                  Having spent years in labor and construction, I don't look at software as just code—I look at it as a tool that needs to be durable, functional, and built on a solid foundation. I bring that same blue-collar work ethic to software engineering.
                </p>
                <p>
                  I build practical, no-nonsense custom software, workflow automation, and AI tools—from <strong>client management dashboards</strong> and <strong>secure customer portals</strong> to <strong>automated database integrations</strong>—so businesses can move from manual spreadsheets and repetitive tasks to <strong>scalable, secure digital infrastructure</strong>.
                </p>
              </div>
            </div>

            <div
              class="bg-white dark:bg-[#252528] p-8 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-800"
              data-aos="fade-left"
            >
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-6">
                Professional Journey
              </h4>

              <div
                class="space-y-8 border-l-2 border-gray-200 dark:border-gray-800 ml-3 pl-8 relative"
              >
                <!-- Timeline Item 1: Richwell Colleges Incorporated -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-wood-accent"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Full Stack Developer
                  </h5>
                  <span class="text-sm text-wood-accent font-bold"
                    >Richwell Colleges Incorporated • Oct 2025 - May 2026</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1.5"
                  >
                    <p>
                      • Developed and maintained full-stack applications supporting organizational workflows.
                    </p>
                    <p>
                      • Designed database schemas, data flows, and application features.
                    </p>
                    <p>
                      • Contributed to system architecture, testing, debugging, and maintenance.
                    </p>
                    <p>
                      • Built and refined automation workflows to reduce repetitive processes.
                    </p>
                    <p>
                      • Collaborated with the development team on planning and implementation.
                    </p>
                  </div>
                </div>

                <!-- Timeline Item 2: Freelance Solutions -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-wood-accent"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Software Developer Freelancer
                  </h5>
                  <span class="text-sm text-wood-accent font-bold"
                    >Remote / Freelance • 2022 - 2025</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1.5"
                  >
                    <p>
                      • Engineered customized solutions for local businesses, including sales trackers and inventory management portals.
                    </p>
                    <p>
                      • Focused on rapid UX/UI updates guided directly by client operational feedback loops.
                    </p>
                  </div>
                </div>

                <!-- Timeline Item 3: Lexie Staffing -->
                <div class="relative">
                  <span
                    class="absolute -left-[41px] top-1 h-5 w-5 rounded-full border-4 border-white dark:border-gray-800 bg-gray-300 dark:bg-gray-600"
                  ></span>
                  <h5 class="text-lg font-bold text-gray-900 dark:text-white">
                    Recruitment Associate
                  </h5>
                  <span class="text-sm text-wood-accent font-bold"
                    >Lexie Staffing and Business Consulting</span
                  >
                  <div
                    class="mt-2 text-gray-700 dark:text-gray-300 text-sm space-y-1.5"
                  >
                    <p>
                      • Coordinated candidate intakes, managed ATS information integrity, and prepared employment contracts.
                    </p>
                    <p>
                      • Generated recruitment metrics and reports to assist HR management decisions.
                    </p>
                  </div>
                </div>
              </div>

              <div
                class="mt-10 pt-6 border-t border-gray-200 dark:border-gray-800"
              >
                <a
                  href="/quick-portfolio/contact/"
                  class="group mt-6 flex items-center justify-between p-4 bg-wood-accent text-white rounded-xl font-bold hover:bg-wood-accent/90 transition-all shadow-lg hover:shadow-wood-accent/20"
                >
                  <div class="flex items-center">
                    <svg class="w-6 h-6 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" />
                    </svg>
                    <span>Get in Touch / View Resume</span>
                  </div>
                  <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Tech Stack Details Grid (Full-Width) -->
          <div class="mt-16 pt-16 border-t border-gray-200 dark:border-gray-800/50">
            <h4 class="text-xs font-bold tracking-widest text-wood-accent uppercase mb-8 text-center">Technical Toolbox</h4>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6">
              <!-- Card 1: Frontend -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Frontend
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">React</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Next.js</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Astro</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">TypeScript</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">JavaScript</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">HTML</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">CSS</span>
                </div>
              </div>

              <!-- Card 2: Backend -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Backend
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Python</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Django</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">PHP</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Laravel</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">ASP.NET</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">C#</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Node.js</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Express.js</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">REST APIs</span>
                </div>
              </div>

              <!-- Card 3: Databases -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Databases
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">PostgreSQL</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">MySQL</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Supabase</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">MongoDB</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Firebase</span>
                </div>
              </div>

              <!-- Card 4: AI & Automation -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  AI & Automation
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">RAG</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">AI APIs</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">n8n</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Webhooks</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">API Integrations</span>
                </div>
              </div>

              <!-- Card 5: Cloud -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Cloud
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Vercel</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Serverless Functions</span>
                </div>
              </div>

              <!-- Card 6: Methodologies -->
              <div class="p-6 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm hover:shadow-md transition-shadow">
                <h5 class="text-sm font-bold text-wood-accent uppercase tracking-widest mb-4">
                  Methodologies
                </h5>
                <div class="flex flex-wrap gap-2">
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Agile</span>
                  <span class="px-2.5 py-1 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-800 rounded-lg text-xs text-gray-600 dark:text-gray-300">Waterfall</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ORGANISMS: Core Strengths -->
      <section
        id="competencies"
        class="py-24 bg-white dark:bg-[#1f1f1f] border-t border-gray-100 dark:border-gray-800"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16" data-aos="fade-up">
            <h2
              class="text-sm font-bold tracking-widest text-wood-accent uppercase"
            >
              Core Strengths
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            <!-- Full-Stack Development -->
            <div
              class="flex gap-6 p-6 rounded-2xl hover:bg-grey-light dark:hover:bg-[#1a1a1a] transition-all duration-300 group"
              data-aos="fade-up"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center group-hover:bg-wood-accent transition-colors duration-300"
              >
                <svg
                  class="w-6 h-6 text-wood-accent group-hover:text-white"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M22 11V3h-7v3H9V3H2v8h7V8h2v10h4v3h7v-8h-7v3h-2V8h2v10h4v3h7v-8h-7v3h-2V8h2v3h7z"
                  />
                </svg>
              </div>
              <div>
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  Full-Stack Development
                </h4>
                <p
                  class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed"
                >
                  Frontend, backend, APIs, databases, and complete web
                  applications.
                </p>
              </div>
            </div>

            <!-- Automation & Integration -->
            <div
              class="flex gap-6 p-6 rounded-2xl hover:bg-grey-light dark:hover:bg-[#1a1a1a] transition-all duration-300 group"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center group-hover:bg-wood-accent transition-colors duration-300"
              >
                <svg
                  class="w-6 h-6 text-wood-accent group-hover:text-white"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M11 21h-1l1-7H7.5c-.58 0-.57-.32-.38-.66.19-.34.05-.08.07-.12C8.48 10.94 10.42 7.54 13 3h1l-1 7h3.5c.49 0 .56.33.47.51l-.07.15C12.96 17.55 11 21 11 21z"
                  />
                </svg>
              </div>
              <div>
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  Automation & Integration
                </h4>
                <p
                  class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed"
                >
                  Connecting APIs, databases, webhooks, and automation platforms
                  to streamline workflows.
                </p>
              </div>
            </div>

            <!-- Problem Solving -->
            <div
              class="flex gap-6 p-6 rounded-2xl hover:bg-grey-light dark:hover:bg-[#1a1a1a] transition-all duration-300 group"
              data-aos="fade-up"
              data-aos-delay="200"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center group-hover:bg-wood-accent transition-colors duration-300"
              >
                <svg
                  class="w-6 h-6 text-wood-accent group-hover:text-white"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.44 14.8c-.2.2-.45.3-.78.3-.33 0-.59-.1-.78-.3-.19-.19-.29-.46-.29-.81 0-.35.1-.62.29-.81.2-.2.45-.3.78-.3.33 0 .59.1.78.3.19.2.29.47.29.81s-.1.62-.29.81zM14.24 11c-.34.42-.87.89-1.57 1.4-.29.21-.52.41-.69.6-.17.18-.3.36-.39.52-.09.16-.16.32-.2.48-.04.16-.08.3-.11.41h-1.31c.03-.27.09-.57.17-.9s.2-.66.36-1c.16-.34.39-.67.68-.99.29-.32.65-.67 1.07-1.04.41-.37.74-.71.99-1.02.25-.31.37-.64.37-1.01 0-.35-.13-.65-.4-.9-.27-.25-.63-.38-1.07-.38-.45 0-.82.13-1.1.38-.28.25-.43.55-.44.89h-1.32c.02-.7.27-1.27.76-1.71.49-.44 1.14-.66 1.97-.66.86 0 1.54.23 2.05.69.51.46.77 1.07.77 1.83 0 .5-.11.95-.33 1.34z"
                  />
                </svg>
              </div>
              <div>
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  Problem Solving
                </h4>
                <p
                  class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed"
                >
                  Debugging systems by identifying root causes and improving
                  underlying workflows.
                </p>
              </div>
            </div>

            <!-- Collaboration & Leadership -->
            <div
              class="flex gap-6 p-6 rounded-2xl hover:bg-grey-light dark:hover:bg-[#1a1a1a] transition-all duration-300 group"
              data-aos="fade-up"
              data-aos-delay="300"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center group-hover:bg-wood-accent transition-colors duration-300"
              >
                <svg
                  class="w-6 h-6 text-wood-accent group-hover:text-white"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                  />
                </svg>
              </div>
              <div>
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  Collaboration & Leadership
                </h4>
                <p
                  class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed"
                >
                  Experience coordinating development work and contributing to
                  technical planning.
                </p>
              </div>
            </div>

            <!-- Business Analysis -->
            <div
              class="flex gap-6 p-6 rounded-2xl hover:bg-grey-light dark:hover:bg-[#1a1a1a] transition-all duration-300 group"
              data-aos="fade-up"
              data-aos-delay="400"
            >
              <div
                class="flex-shrink-0 w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center group-hover:bg-wood-accent transition-colors duration-300"
              >
                <svg
                  class="w-6 h-6 text-wood-accent group-hover:text-white"
                  viewBox="0 0 24 24"
                  fill="currentColor"
