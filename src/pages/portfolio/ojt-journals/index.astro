  <!-- 
    COMPONENT: Dark Mode Accessibility Contrast Override Block
    PURPOSE: This scoped CSS block guarantees that all slightly dark texts are perfectly readable 
             in dark mode, conforming to WCAG AA/AAA standards (contrast ratio >= 4.5:1 or 7:1).
             It overrides the pre-compiled global legacy CSS stylesheet rules that conflict with 
             standard Tailwind classes in class-based dark mode (`html.dark`).
    TARGETS:
      - Schema card keys (.font-mono.text-xs li span:first-child) -> zinc-200 (#e4e4e7)
      - Schema card ID subtitles (.text-2xs.font-mono.text-gray-600) -> zinc-400 (#a1a1aa)
      - Table header labels (table th) -> zinc-100 (#f4f4f5)
      - Neutral table data cells (table td.text-gray-700) -> zinc-200 (#e4e4e7)
      - Italicized footnotes/remarks (p.italic.text-xs) -> zinc-300 (#d4d4d8)
  -->
  <style>
    /* Dark mode contrast accessibility overrides to bypass compiled CSS conflicts */
    :global(html.dark) .font-mono.text-xs li span:first-child {
      color: #e4e4e7 !important; /* zinc-200 */
    }
    :global(html.dark) .text-2xs.font-mono.text-gray-600 {
      color: #a1a1aa !important; /* zinc-400 */
    }
    :global(html.dark) table th {
      color: #f4f4f5 !important; /* zinc-100 */
    }
    :global(html.dark) table td.text-gray-700 {
      color: #e4e4e7 !important; /* zinc-200 */
    }
    :global(html.dark) p.italic.text-xs {
      color: #d4d4d8 !important; /* zinc-300 */
    }
  </style>
