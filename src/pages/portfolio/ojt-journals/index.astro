---
/**
 * OJT Daily Journal System Case Study Page
 * Purpose: Presents a high-fidelity, comprehensive case study of the OJT Daily Journal System.
 * Contents: Includes project overview, executive summary, problem statement, solution details, 
 *           architectural pillars (Zero-Cost hosting, native local mailto routing), database schemas, 
 *           compliance models, and key benefits.
 * Fit: Part of the portfolio subpages under '/portfolio/ojt-journals', highlighting full-stack 
 *      engineering capabilities, serverless designs, and production-grade UI design.
 */

import Layout from '../../../layouts/Layout.astro';
const title = 'OJT Daily Journal System Case Study | Jun Alvior';
const description = 'A modern, web-based daily journal system designed for OJT students to log their daily activities and for administrators to monitor progress and compliance.';
---

<Layout title={title} description={description}>
  <main id="main-content" class="flex-grow flex flex-col">
    <!-- ORGANISMS: Project Case Study -->
    <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow transition-colors duration-300">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <div class="mb-8 text-sm text-gray-700 dark:text-gray-300">
          <a
            href="../../portfolio/"
            class="hover:text-wood-accent transition-colors flex items-center gap-1 font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Portfolio
          </a>
        </div>

        <!-- Header -->
        <header class="mb-12" data-aos="fade-up">
          <div class="mb-8 rounded-2xl overflow-hidden shadow-2xl border border-gray-200/50 dark:border-gray-800/50">
            <img
              src="../../assets/ojt-journals.png"
              alt="OJT Journals System Screenshot Mockup"
              class="w-full h-auto object-cover max-h-[500px] hover:scale-101 transition-transform duration-700"
              loading="lazy"
              decoding="async"
              width="800"
              height="450"
            />
          </div>
          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 dark:bg-green-950/50 text-green-700 dark:text-green-400">
              Active Project
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-wood-100 dark:bg-wood-950/50 text-wood-900 dark:text-wood-100">
              Case Study
            </span>
          </div>
          <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
            OJT Daily Journal System
          </h1>
          <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed font-normal">
            Bridging Administrative Efficiency and Modern Intern Tracking with a Zero-Cost Serverless Architecture
          </p>

          <div class="flex flex-wrap gap-2.5 mt-6">
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              JavaScript (ES6+)
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              Firebase Auth
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              Cloud Firestore
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              GitHub Pages
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              Tailwind CSS
            </span>
          </div>
        </header>

        <!-- Project Links (Top CTA) -->
        <div class="flex flex-wrap gap-4 mb-16" data-aos="fade-up" data-aos-delay="50">
          <a
            href="https://property360-2.github.io/ojt-journals/index.html"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Live Demo
          </a>
          <a
            href="https://github.com/property360-2/ojt-journals"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 bg-transparent border-2 border-wood-accent hover:bg-wood-50 dark:hover:bg-[#252528] text-wood-accent dark:text-wood-300 font-semibold rounded-xl shadow-sm hover:shadow-md transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd" />
            </svg>
            View Code
          </a>
        </div>

        <!-- Content Flow -->
        <div class="space-y-16">
          
          <!-- SECTION 1: Executive Summary -->
          <section id="executive-summary" class="bg-white dark:bg-[#252528] border-l-4 border-wood-accent border-y border-r border-gray-200 dark:border-gray-800 rounded-r-2xl p-6 sm:p-8" data-aos="fade-up">
            <div class="flex gap-4">
              <div class="hidden sm:block text-wood-accent">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Executive Summary
                </h2>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                  The <strong>OJT Daily Journal System</strong> is a highly responsive, secure web application designed to digitize the administrative tracking of On-the-Job Training (OJT) student interns. Developed for educational institutions, it replaces traditional, error-prone, manual record-keeping workflows with an automated, role-based platform.
                </p>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed mt-3">
                  By strategically leveraging <strong>GitHub Pages</strong> for frontend hosting, <strong>Firebase (Auth & Firestore)</strong> for database management, and a smart, zero-cost <strong>native local email routing engine (<code class="text-xs px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950/30 text-wood-900 dark:text-wood-300">mailto:</code>)</strong>, the platform achieves a <strong>100% free hosting and operations model</strong> while delivering high-speed, real-time database transactions, bulk reminder workflows, and premium interactive aesthetics.
                </p>
              </div>
            </div>
          </section>

          <!-- SECTION 2: The Problem vs The Solution -->
          <section id="problem-solution" class="grid grid-cols-1 md:grid-cols-2 gap-8" data-aos="fade-up">
            <!-- Problem Card -->
            <div class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 shadow-sm rounded-2xl p-6 sm:p-8 flex flex-col">
              <div class="flex items-center gap-3 mb-6">
                <span class="p-2 bg-red-100 dark:bg-red-950/50 text-red-600 dark:text-red-400 rounded-lg">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </span>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">The Manual Nightmare</h3>
              </div>
              <ul class="space-y-4 text-gray-700 dark:text-gray-300 text-sm leading-relaxed flex-grow">
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">•</span>
                  <span><strong>Mano-Mano Audits:</strong> Coordinators manually compute students' daily activities and verify if weekly hour targets are hit.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">•</span>
                  <span><strong>Delayed Visibility:</strong> Real-time compliance monitoring is non-existent; falling behind is noticed weeks too late.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">•</span>
                  <span><strong>Communication Chaos:</strong> Drafting student reminder emails involves repetitive copy-pasting of missed schedules.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">•</span>
                  <span><strong>Severe Budget Limits:</strong> Zero funds available for server costs, database plans, or third-party transactional email integrations.</span>
                </li>
              </ul>
            </div>

            <!-- Solution Card -->
            <div class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 shadow-sm rounded-2xl p-6 sm:p-8 flex flex-col">
              <div class="flex items-center gap-3 mb-6">
                <span class="p-2 bg-green-100 dark:bg-green-950/50 text-green-600 dark:text-green-400 rounded-lg">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </span>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">The Digital Solution</h3>
              </div>
              <ul class="space-y-4 text-gray-700 dark:text-gray-300 text-sm leading-relaxed flex-grow">
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">•</span>
                  <span><strong>Automated Audits:</strong> The database automates calculations of weeks, daily limits, and compliant hours.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">•</span>
                  <span><strong>Instant Dashboards:</strong> Administrators filter and view progress and status badges instantaneously.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">•</span>
                  <span><strong>1-Click Email Engine:</strong> A smart client-side reminder system builds custom pre-formatted emails in 1-click.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">•</span>
                  <span><strong>100% Free Ecosystem:</strong> Hosted completely serverless on GitHub Pages and Firebase within free caps.</span>
                </li>
              </ul>
            </div>
          </section>

          <!-- SECTION 3: Visual Flow Diagram -->
          <section id="architecture-flow" class="border border-gray-200 dark:border-gray-800 bg-white dark:bg-[#252528] rounded-2xl p-6 sm:p-8" data-aos="fade-up">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 text-center">Interactive System Architecture</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
              <!-- Student Node -->
              <div class="border border-gray-100 dark:border-gray-800 bg-gray-50/50 dark:bg-[#1a1a1a] rounded-xl p-5 text-center flex flex-col justify-between items-center shadow-sm">
                <span class="p-3 bg-wood-100 dark:bg-wood-950/30 text-wood-accent rounded-full mb-3">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                </span>
                <div>
                  <h4 class="font-bold text-gray-900 dark:text-white text-sm">OJT Student</h4>
                  <p class="text-xs text-gray-600 dark:text-gray-300 mt-1">Logs learning records, tracks weekly compliance on mobile or desktop.</p>
                </div>
                <div class="w-full border-t border-gray-100 dark:border-gray-800 mt-4 pt-3 text-2xs text-wood-accent font-mono uppercase tracking-wider">
                  ES6 Frontend client
                </div>
              </div>

              <!-- Firebase Center Node -->
              <div class="border border-wood-100 dark:border-gray-800/60 bg-wood-50/10 dark:bg-[#1a1a1a]/50 rounded-xl p-5 text-center flex flex-col justify-between items-center shadow-md ring-1 ring-wood-accent/20">
                <span class="p-3 bg-amber-100 dark:bg-amber-950/30 text-amber-500 rounded-full mb-3">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                  </svg>
                </span>
                <div>
                  <h4 class="font-bold text-gray-900 dark:text-white text-sm">Firebase Cloud Platform</h4>
                  <p class="text-xs text-gray-600 dark:text-gray-300 mt-1">Real-time user authentication and highly optimized Firestore document indexes.</p>
                </div>
                <div class="w-full border-t border-gray-100 dark:border-gray-800 mt-4 pt-3 text-2xs text-amber-600 dark:text-amber-400 font-mono uppercase tracking-wider">
                  Real-time Database
                </div>
              </div>
 
              <!-- Coordinator Node -->
              <div class="border border-gray-100 dark:border-gray-800 bg-gray-50/50 dark:bg-[#1a1a1a] rounded-xl p-5 text-center flex flex-col justify-between items-center shadow-sm">
                <span class="p-3 bg-blue-100 dark:bg-blue-950/30 text-blue-500 rounded-full mb-3">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                  </svg>
                </span>
                <div>
                  <h4 class="font-bold text-gray-900 dark:text-white text-sm">OJT Coordinator</h4>
                  <p class="text-xs text-gray-600 dark:text-gray-300 mt-1">Monitors interns, inspects statuses, and launches native reminder emails.</p>
                </div>
                <div class="w-full border-t border-gray-100 dark:border-gray-800 mt-4 pt-3 text-2xs text-blue-500 font-mono uppercase tracking-wider">
                  Admin Dashboard
                </div>
              </div>
            </div>
 
            <!-- Subheading inside layout describing mailto loop -->
            <div class="mt-6 text-center text-xs text-gray-600 dark:text-gray-300 border-t border-gray-100 dark:border-gray-800 pt-4 flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
              <span><strong>Zero-Cost Email Workflow:</strong> Firestore computes missing dates &rarr; Admin clicks envelope &rarr; Client opens pre-formatted draft &rarr; Mail client delivers via native email servers without cloud SMTP relays.</span>
            </div>
          </section>

          <!-- SECTION 4: Architecture Pillars -->
          <section id="architecture-pillars" class="space-y-8" data-aos="fade-up">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-800 pb-3 flex items-center gap-2">
              <svg class="w-6 h-6 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
              Core Architecture Pillars
            </h3>
            
            <div class="space-y-6">
              <div>
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
                  <span class="w-1.5 h-6 bg-wood-accent rounded-full"></span>
                  1. Zero-Cost Infrastructure & High Scalability
                </h4>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">
                  To fulfill the strict requirement of **zero operational and hosting cost**, the platform utilizes a serverless Jamstack architecture:
                </p>
                <ul class="list-disc pl-5 mt-2 space-y-2 text-gray-700 dark:text-gray-300 text-sm">
                  <li><strong>Frontend Hosting (GitHub Pages):</strong> The entire static frontend (HTML5, Vanilla CSS3, ES6+ Modules) is hosted on GitHub Pages. This provides global CDN speeds, high availability, custom domain readiness, and automated deployments directly from the Git repository—<strong>completely free of charge</strong>.</li>
                  <li><strong>Database & Auth (Firebase Free Tier):</strong> Using Firebase Auth for secure credentials and Cloud Firestore for document storage ensures the system runs in real-time, scales to hundreds of students, and operates entirely within Firebase’s generous free tier.</li>
                </ul>
              </div>

              <div>
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
                  <span class="w-1.5 h-6 bg-wood-accent rounded-full"></span>
                  2. High-Fidelity Responsive Design & Premium UX
                </h4>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">
                  Students submit journals on-the-go (frequently via mobile phones at their training sites), while administrators monitor records on desktops.
                </p>
                <ul class="list-disc pl-5 mt-2 space-y-2 text-gray-700 dark:text-gray-300 text-sm">
                  <li>Designed with a modern, glassmorphism-inspired interface using refined CSS variables.</li>
                  <li>Micro-animations and responsive flexbox/grid layouts ensure a visual flow that fits any screen size.</li>
                  <li>Harmonized color palettes replace browser defaults to give the system an extremely premium, production-ready aesthetic.</li>
                </ul>
              </div>

              <div>
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
                  <span class="w-1.5 h-6 bg-wood-accent rounded-full"></span>
                  3. Smart, Zero-Cost Email Reminder Engine
                </h4>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">
                  Coordinators need a way to remind students who have missing entries without the system incurring operational costs. Typical solutions require expensive external APIs (e.g., SendGrid, Amazon SES) which require recurring payment plans and complex backend code.
                </p>
                
                <div class="mt-4 bg-zinc-50 dark:bg-[#1a1a1a] border border-zinc-100 dark:border-gray-800 rounded-xl p-5">
                  <h5 class="font-bold text-wood-accent text-sm mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    The Innovative Solution: Personalized Client-Side Routing
                  </h5>
                  <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">
                    The OJT Daily Journal System implements a <strong>Personalized Native <code>mailto:</code> Quick-Reminder workflow</strong>:
                  </p>
                  <ul class="list-disc pl-5 mt-2 space-y-1.5 text-gray-700 dark:text-gray-300 text-sm">
