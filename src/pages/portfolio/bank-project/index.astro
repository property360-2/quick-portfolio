---
import Layout from '../../../layouts/Layout.astro';
const title = 'Bank Management System - Django Finance App | Jun Alvior';
const description = 'Secure Django Bank Management System. Featuring account management, fund transfers, and secure transaction tracking built with Python.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Project Case Study -->
      <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- Breadcrumb -->
          <div class="mb-8 text-sm text-gray-500 dark:text-gray-400">
            <a
              href="../../portfolio/"
              class="hover:text-wood-accent transition-colors"
              ><- Back to Portfolio</a
            >
          </div>

          <!-- Header -->
          <header class="mb-12" data-aos="fade-up">
            <div class="mb-8 rounded-xl overflow-hidden shadow-2xl">
              <img
                src="../../assets/banko.webp"
                alt="Bank Management System"
                class="w-full h-auto object-cover max-h-[500px]"
                loading="lazy"
                decoding="async"
                width="800"
                height="450"
              />
            </div>
            <h1
              class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6"
            >
              Bank Management System
            </h1>
            <div class="flex flex-wrap gap-4 text-sm">
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Django</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Finance</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Web App</span
              >
            </div>
          </header>

          <!-- Content -->
          <div
            class="prose dark:prose-invert prose-lg prose-wood dark:prose-invert prose-wood max-w-none"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <p>
              A comprehensive banking management system built with Django. This
              application streamlines core banking operations including account
              management, transactions, and secure user data handling.
            </p>

            <h3>Key Features</h3>
            <ul>
              <li>
                <strong>Account Management:</strong> Create and manage secure
                user accounts.
              </li>
              <li>
                <strong>Transaction Processing:</strong> Handle deposits,
                withdrawals, and transfers efficiently.
              </li>
              <li>
                <strong>Admin Dashboard:</strong> Detailed oversight for banking
                staff and administrators.
              </li>
            </ul>

            <h3>Project Links</h3>
            <div class="flex gap-4 not-prose mt-6">
              <a
                href="https://github.com/property360-2/simple-bank-management-system-django"
                target="_blank"
                class="px-6 py-3 bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
              >
                <svg
                  class="mr-2 w-5 h-5 mr-2"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path
                    d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                  />
                </svg>
                View Code
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- ORGANISMS: Footer -->
    </main>
</Layout>
