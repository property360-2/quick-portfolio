---
/**
 * Intelligent Knowledge Base & Document Automation Case Study
 * Purpose: Detailed case study for the Intelligent Knowledge Base & Document Automation (Tropang AI).
 * Contains: Project overview, key features, technology stack, and live links.
 * System Role: Provides in-depth information about a specific custom AI and document parsing solution.
 */
import Layout from '../../../layouts/Layout.astro';

const title = 'Intelligent Knowledge Base & Document Automation Case Study | Jun Alvior';
const description = 'Turn dense company PDFs, manuals, and documents into a searchable "Internal Brain." Built with Next.js and Firebase for legal, real estate, and operational teams.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Project Case Study -->
      <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow transition-colors duration-300 relative overflow-hidden">
        <div class="absolute inset-0 -z-10 bg-grid-wood opacity-[0.32] [mask-image:radial-gradient(ellipse_70%_45%_at_30%_0%,black_60%,transparent_110%)]"></div>
        <div class="absolute -top-24 -left-24 w-[520px] h-[520px] bg-wood-300/10 dark:bg-wood-400/5 rounded-full blur-[90px] pointer-events-none hidden md:block"></div>
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- Breadcrumb -->
          <div class="mb-8 text-sm text-gray-700 dark:text-gray-300">
            <a
              href="/quick-portfolio/portfolio/"
              class="hover:text-wood-accent transition-colors flex items-center gap-1 font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Back to Portfolio
            </a>
          </div>

          <!-- Header -->
          <header class="mb-12" data-aos="fade-up">
            <div class="mb-8 rounded-2xl overflow-hidden shadow-2xl border border-gray-200/50 dark:border-white/10/50">
              <img
                src="/quick-portfolio/assets/tropang-ai.png"
                alt="Tropang AI"
                class="w-full h-auto object-cover max-h-[500px] hover:scale-101 transition-transform duration-700"
                loading="lazy"
                decoding="async"
                width="800"
                height="450"
              />
            </div>
            <h1
              class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4"
            >
              Intelligent Knowledge Base & Document Automation (Tropang AI)
            </h1>
            <div class="flex flex-wrap gap-2.5 mt-6">
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >Next.js 15</span
              >
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >Tailwind CSS 4</span
              >
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >Firebase</span
              >
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >Groq</span
              >
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >LangChain</span
              >
            </div>
          </header>

          <!-- Project Links (Top) -->
          <div class="flex flex-wrap gap-4 mb-12" data-aos="fade-up" data-aos-delay="50">
            <a
              href="https://tropangai.vercel.app/"
              target="_blank"
              class="px-6 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                />
              </svg>
              Live Demo
            </a>
          </div>

          <!-- At-a-Glance Summary -->
          <section class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 rounded-2xl p-6 sm:p-8 mb-12" data-aos="fade-up">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-5 flex items-center gap-2">
              <svg class="w-5 h-5 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              At a Glance
            </h2>
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 text-sm">
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Problem</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Teams waste hours hunting through PDFs, manuals, and spreadsheets.</dd></div>
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Role</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Built the RAG pipeline — ingest, BM25 ranking, and conversational retrieval.</dd></div>
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Solution</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Knowledge base that turns company documents into a searchable internal brain.</dd></div>
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Result</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Sub-second answers from corporate archives with multi-format parsing.</dd></div>
              <div class="md:col-span-2"><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Proof</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Live demo and architecture below.</dd></div>
            </dl>
          </section>

          <!-- Content -->
          <div
            class="prose dark:prose-invert prose-lg prose-wood max-w-none"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <h2>Overview</h2>
            <p>
              Tropang AI is an enterprise-ready <strong>Retrieval-Augmented Generation (RAG)</strong> knowledge base system that transforms dense company PDFs, operational manuals, legal contracts, and spreadsheets into a searchable "Internal Brain." Designed for industries like legal, real estate, and high-volume customer service, this system replaces hours of manual research with conversational queries, bringing accurate answers from corporate archives in seconds.
            </p>

            <h2>The Problem It Solves</h2>
            <p>
              Teams lose countless expensive billable hours when employees manually sift through disorganized documentation, long compliance reports, and technical guides. Tropang AI eliminates this administrative drag. By indexing multi-format corporate archives, it isolates documents securely per team or user and allows personnel to query complex guidelines, extract high-fidelity summaries, and retrieve cross-referenced answers in sub-second response times.
            </p>

            <h3>Key Features</h3>
            <ul>
              <li>
                <strong>Lightning-Fast RAG:</strong> Optimized with Groq's high-speed inference and a custom BM25 ranking engine for instant responses.
              </li>
              <li>
                <strong>Multi-Format Support:</strong> Seamlessly parses and indexes PDFs, Word documents (DOCX), and Excel spreadsheets (XLSX).
              </li>
              <li>
                <strong>Premium UI/UX:</strong> A sleek glassmorphism interface built with Tailwind CSS 4 and Framer Motion for smooth animations.
              </li>
              <li>
                <strong>Robust Failover:</strong> Intelligent model switching between Llama 3.1, Mixtral, and Gemma to ensure continuous availability.
              </li>
              <li>
                <strong>Secure Auth:</strong> Integrated with Firebase Auth for personal document isolation and security.
              </li>
            </ul>

            <h3>Meet TropangAI</h3>
            <p>
              Unlike typical robotic assistants, TropangAI is tuned for natural conversation. It prioritizes clarity and directness, acting more like a smart colleague than a data auditor. It can summarize complex financial reports, explain technical specs, and handle multiple documents simultaneously for cross-referencing.
            </p>

            <!-- Conversion CTA Block -->
            <section class="py-12 bg-gray-50 dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-white/10 p-8 text-center my-12" data-aos="fade-up">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Want to build high-performance PWAs or full-stack platforms?</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-xl mx-auto">Let's coordinate to build custom software, offline-first mobile webapps, or high-throughput databases.</p>
              <a href="/quick-portfolio/contact/" class="inline-flex items-center px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl transition-all shadow-md">
                Get in Touch &rarr;
              </a>
            </section>

            <!-- Next Case Study Footer -->
            <div class="flex justify-between items-center border-t border-gray-200 dark:border-white/10 pt-8 mt-8">
              <a href="/quick-portfolio/portfolio/" class="text-sm text-gray-500 hover:text-wood-accent transition-colors">&larr; Back to Portfolio</a>
              <a href="/quick-portfolio/portfolio/gym-project/" class="text-sm font-bold text-wood-accent hover:text-wood-700 transition-colors">Next Case Study &rarr;</a>
            </div>
          </div>

          <!-- Conversion CTA Block -->
          

          <!-- Conversion CTA Block -->
          <section class="py-12 bg-gray-50 dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-white/10 p-8 text-center my-12" data-aos="fade-up">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Want a tool like this?</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-xl mx-auto">Let's build a custom version for your workflow — fast, reliable, and tailored to your team.</p>
            <a href="/quick-portfolio/contact/" class="inline-flex items-center px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl transition-all shadow-md">
              Get in Touch &rarr;
            </a>
          </section>

          <!-- Next Case Study Footer -->
          <div class="flex justify-between items-center border-t border-gray-200 dark:border-white/10 pt-8 mt-8">
            <a href="/quick-portfolio/portfolio/" class="text-sm text-gray-500 hover:text-wood-accent transition-colors">&larr; Back to Portfolio</a>
            <a href="/quick-portfolio/portfolio/gym-project/" class="text-sm font-bold text-wood-accent hover:text-wood-700 transition-colors">Next Case Study &rarr;</a>
          </div>
        </div>
      </article>

      <!-- ORGANISMS: Footer -->
    </main>
</Layout>
