---
/**
 * HelpDesk Ticketing System (ASP.NET Core + React) Case Study Page
 * Purpose: Presents a comprehensive case study of the HelpDesk ticketing system.
 * Contents: Project overview, executive summary, problem statement, solution details,
 *           role-based access control, ticket lifecycle, database schema, REST API surface,
 *           and key benefits.
 * Fit: Part of the portfolio subpages under '/portfolio/helpdesk-ticketing-system', highlighting
 *      full-stack .NET engineering, relational schema design, and production-grade service desk workflows.
 */

import Layout from '../../../layouts/Layout.astro';
import Carousel from '../../../components/Carousel.astro';

const title = 'HelpDesk Ticketing System Case Study | Jun Alvior';
const description = 'A full-stack help desk ticketing system built with ASP.NET Core and React, featuring role-based access, JWT authentication, and a complete ticket lifecycle.';
---

<Layout title={title} description={description}>
  <main id="main-content" class="flex-grow flex flex-col">
    <!-- ORGANISMS: Project Case Study -->
    <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow transition-colors duration-300">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <div class="mb-8 text-sm text-gray-700 dark:text-gray-300">
          <a
            href="../../portfolio/"
            class="hover:text-wood-accent transition-colors flex items-center gap-1 font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Portfolio
          </a>
        </div>

        <!-- Header -->
        <header class="mb-12" data-aos="fade-up">
          <div class="mb-8 rounded-2xl overflow-hidden shadow-2xl border border-gray-200/50 dark:border-gray-800/50">
            <Carousel prefix="helpdesk" slideCount={3} autoplayInterval={6000}>
              <div class="w-full h-full flex-shrink-0 relative">
                <img
                  src="/quick-portfolio/assets/helpdesk-ticketing-system/dashboard.png"
                  alt="HelpDesk ticketing system dashboard with live ticket metrics"
                  class="w-full h-full object-cover"
                  loading="eager"
                  decoding="async"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-6 text-white">
                  <h4 class="text-lg font-bold">1. Dashboard</h4>
                  <p class="text-xs text-gray-300">Live ticket totals, open/in-progress/resolved counts, and critical-ticket highlights at a glance.</p>
                </div>
              </div>

              <div class="w-full h-full flex-shrink-0 relative">
                <img
                  src="/quick-portfolio/assets/helpdesk-ticketing-system/tickets.png"
                  alt="HelpDesk ticket queue with priority and status filters"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-6 text-white">
                  <h4 class="text-lg font-bold">2. Ticket Queue</h4>
                  <p class="text-xs text-gray-300">Filterable ticket table with priority, status, assignment, and search across the full ticket backlog.</p>
                </div>
              </div>

              <div class="w-full h-full flex-shrink-0 relative">
                <img
                  src="/quick-portfolio/assets/helpdesk-ticketing-system/ticket-details.png"
                  alt="HelpDesk ticket detail view with comments and activity timeline"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-6 text-white">
                  <h4 class="text-lg font-bold">3. Ticket Detail</h4>
                  <p class="text-xs text-gray-300">Description, comment thread, attachments, and a full activity timeline for a single ticket.</p>
                </div>
              </div>
            </Carousel>
          </div>

          <div class="flex items-center gap-2 mb-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 dark:bg-green-950/50 text-green-700 dark:text-green-400">
              Active Project
            </span>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-wood-100 dark:bg-wood-950/50 text-wood-900 dark:text-wood-100">
              Case Study
            </span>
          </div>
          <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
            HelpDesk Ticketing System
          </h1>
          <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300 leading-relaxed font-normal">
            A Full-Stack ASP.NET Core + React Service Desk with Role-Based Access, JWT Authentication, and a Complete Ticket Lifecycle
          </p>

          <div class="flex flex-wrap gap-2.5 mt-6">
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              ASP.NET Core (.NET 10)
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              EF Core
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              Identity + JWT
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              React
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              TypeScript
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              Vite
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              Tailwind CSS
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              TanStack Query
            </span>
            <span class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300">
              SQLite / PostgreSQL
            </span>
          </div>
        </header>

        <!-- Project Links (Top CTA) -->
        <div class="flex flex-wrap gap-4 mb-16" data-aos="fade-up" data-aos-delay="50">
          <a
            href="https://ticketing-system-for-portfolio.vercel.app/login"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Live Demo
          </a>
          <a
            href="https://github.com/property360-2/ticketing-system-for-portfolio"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 bg-transparent border-2 border-wood-accent hover:bg-wood-50 dark:hover:bg-[#252528] text-wood-accent dark:text-wood-300 font-semibold rounded-xl shadow-sm hover:shadow-md transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z" clip-rule="evenodd" />
            </svg>
            View Code
          </a>
        </div>

        <!-- Content Flow -->
        <div class="space-y-16">

          <!-- SECTION 0: At-a-Glance Summary -->
          <section id="summary" class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-2xl p-6 sm:p-8" data-aos="fade-up">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-5 flex items-center gap-2">
              <svg class="w-5 h-5 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              At a Glance
            </h2>
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 text-sm">
              <div>
                <dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Problem</dt>
                <dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Support requests scattered across email and chat, with no ownership, status, or audit trail.</dd>
              </div>
              <div>
                <dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Role</dt>
                <dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Designed and built the full-stack system: ASP.NET Core API, React frontend, schema, JWT auth, and role-based access.</dd>
              </div>
              <div>
                <dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Solution</dt>
                <dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">A structured help desk with three roles, a defined ticket lifecycle, and a complete activity ledger.</dd>
              </div>
              <div>
                <dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Result</dt>
                <dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Every ticket is owned, assigned, and audited end-to-end, with role-aware dashboards for backlog and turnaround.</dd>
              </div>
              <div class="md:col-span-2">
                <dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Proof</dt>
                <dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Live demo, GitHub repository, screenshots, and the schema and API documentation below.</dd>
              </div>
            </dl>
          </section>

          <!-- SECTION 1: Executive Summary -->
          <section id="executive-summary" class="bg-white dark:bg-[#252528] border-l-4 border-wood-accent border-y border-r border-gray-200 dark:border-gray-800 rounded-r-2xl p-6 sm:p-8" data-aos="fade-up">
            <div class="flex gap-4">
              <div class="hidden sm:block text-wood-accent">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  Executive Summary
                </h2>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
                  <strong>HelpDesk</strong> is a production-ready help desk ticketing system built on <strong>ASP.NET Core (.NET 10)</strong> with a <strong>React + TypeScript</strong> frontend. It replaces scattered email threads and spreadsheets with a structured service desk: employees raise tickets, technicians resolve them, and admins manage users, departments, and categories.
                </p>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed mt-3">
                  Access is enforced by <strong>JWT authentication</strong> and three roles (<code class="text-xs px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950/30 text-wood-900 dark:text-wood-300">Employee</code>, <code class="text-xs px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950/30 text-wood-900 dark:text-wood-300">Technician</code>, <code class="text-xs px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950/30 text-wood-900 dark:text-wood-300">Admin</code>). Every ticket moves through a defined lifecycle while a <code class="text-xs px-1.5 py-0.5 rounded bg-amber-100 dark:bg-amber-950/30 text-wood-900 dark:text-wood-300">ticket_activity_logs</code> ledger records who did what, making the entire support workflow traceable.
                </p>
              </div>
            </div>
          </section>

          <!-- SECTION 2: The Problem vs The Solution -->
          <section id="problem-solution" class="grid grid-cols-1 md:grid-cols-2 gap-8" data-aos="fade-up">
            <!-- Problem Card -->
            <div class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 shadow-sm rounded-2xl p-6 sm:p-8 flex flex-col">
              <div class="flex items-center gap-3 mb-6">
                <span class="p-2 bg-red-100 dark:bg-red-950/50 text-red-600 dark:text-red-400 rounded-lg">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                </span>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">The Support Chaos</h3>
              </div>
              <ul class="space-y-4 text-gray-700 dark:text-gray-300 text-sm leading-relaxed flex-grow">
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">&bull;</span>
                  <span><strong>Lost Requests:</strong> Issues submitted over email and chat disappear into inboxes with no single source of truth.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">&bull;</span>
                  <span><strong>No Ownership:</strong> Nobody knows who is working on what, and duplicate or unassigned tickets fall through the cracks.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">&bull;</span>
                  <span><strong>No Audit Trail:</strong> Status changes, reassignments, and resolutions happen silently with no record of who did what.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-red-500 font-bold">&bull;</span>
                  <span><strong>No Visibility:</strong> Managers lack metrics on backlog, turnaround, and workload per department.</span>
                </li>
              </ul>
            </div>

            <!-- Solution Card -->
            <div class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 shadow-sm rounded-2xl p-6 sm:p-8 flex flex-col">
              <div class="flex items-center gap-3 mb-6">
                <span class="p-2 bg-green-100 dark:bg-green-950/50 text-green-600 dark:text-green-400 rounded-lg">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </span>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white">The Structured Service Desk</h3>
              </div>
              <ul class="space-y-4 text-gray-700 dark:text-gray-300 text-sm leading-relaxed flex-grow">
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">&bull;</span>
                  <span><strong>Centralized Tickets:</strong> Every request becomes a ticket with title, category, department, priority, and status.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">&bull;</span>
                  <span><strong>Clear Ownership:</strong> Admins assign technicians; technicians see their queue and resolve tickets with full accountability.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">&bull;</span>
                  <span><strong>Full Activity Log:</strong> Creation, assignment, status/priority changes, and comments are all recorded on a timeline.</span>
                </li>
                <li class="flex gap-2">
                  <span class="text-green-500 font-bold">&bull;</span>
                  <span><strong>Role-Based Dashboards:</strong> Live metrics for open, in-progress, resolved, and critical tickets per department and category.</span>
                </li>
              </ul>
            </div>
          </section>

          <!-- SECTION 3: Architecture -->
          <section id="architecture" class="space-y-8" data-aos="fade-up">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-800 pb-3 flex items-center gap-2">
              <svg class="w-6 h-6 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
              </svg>
              Core Architecture
            </h3>

            <div class="space-y-6">
              <div>
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
                  <span class="w-1.5 h-6 bg-wood-accent rounded-full"></span>
                  1. ASP.NET Core API + EF Core
                </h4>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">
                  A versioned <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">/api/v1</code> JSON API powers the React frontend. Entity Framework Core maps seven normalized tables, and ASP.NET Core Identity handles password hashing while JWT bearer tokens secure every protected route.
                </p>
                <ul class="list-disc pl-5 mt-2 space-y-2 text-gray-700 dark:text-gray-300 text-sm">
                  <li>Role-based <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">[Authorize]</code> guards enforce Employee, Technician, and Admin boundaries.</li>
                  <li>Tickets are treated as stateful resources; assignment, status, and priority changes flow through dedicated <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">PATCH</code> endpoints.</li>
                  <li>Attachments use <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">multipart/form-data</code> with size, MIME, and metadata validation stored in the DB.</li>
                </ul>
              </div>

              <div>
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
                  <span class="w-1.5 h-6 bg-wood-accent rounded-full"></span>
                  2. React + TypeScript Frontend
                </h4>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">
                  Built with <strong>Vite</strong> and <strong>Tailwind CSS</strong>, the client uses <strong>TanStack Query</strong> for server-state caching and <strong>React Hook Form + Zod</strong> for validated forms:
                </p>
                <ul class="list-disc pl-5 mt-2 space-y-2 text-gray-700 dark:text-gray-300 text-sm">
                  <li>Role-aware sidebar and protected routes via React Router.</li>
                  <li>Ticket queue with search, filters (status, priority, category, department), and pagination.</li>
                  <li>Ticket detail view combining description, comment thread, attachments, and an activity timeline.</li>
                  <li>Automatic Axios <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">Authorization: Bearer</code> injection from the auth store.</li>
                </ul>
              </div>

              <div>
                <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2 flex items-center gap-2">
                  <span class="w-1.5 h-6 bg-wood-accent rounded-full"></span>
                  3. Ticket Lifecycle &amp; Activity Audit
                </h4>
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed text-sm">
                  Tickets progress through <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">OPEN &rarr; IN_PROGRESS &rarr; RESOLVED &rarr; CLOSED</code>, with <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">REOPENED</code> as a recovery path. Priorities range from <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">LOW</code> to <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">CRITICAL</code>. Every meaningful event writes a <code class="text-xs px-1.5 py-0.5 rounded bg-zinc-200 dark:bg-zinc-800 font-mono">ticket_activity_logs</code> entry with old/new values, giving a complete, chronological audit of each ticket.
                </p>
              </div>
            </div>
          </section>

          <!-- SECTION 4: Database & Schema Design -->
          <section id="database-design" class="space-y-6" data-aos="fade-up">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white border-b border-gray-200 dark:border-gray-800 pb-3 flex items-center gap-2">
              <svg class="w-6 h-6 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
