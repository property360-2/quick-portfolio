---
/**
 * Client Management & Progress Tracking Dashboard Case Study
 * Purpose: Detailed case study for the Client Management & Progress Tracking Dashboard (Gym Project).
 * Contains: Project overview, key features, technology stack, and live links.
 * System Role: Provides in-depth information about a specific client portal solution.
 */
import Layout from '../../../layouts/Layout.astro';
const title = 'Client Management & Progress Tracking Dashboard Case Study | Jun Alvior';
const description = 'A secure, database-driven portal that tracks user metrics and performance. Built with Django and Tailwind CSS for fitness businesses, personal trainers, or rehab clinics.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Project Case Study -->
      <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- Breadcrumb -->
          <div class="mb-8 text-sm text-gray-500 dark:text-gray-400">
            <a
              href="../../portfolio/"
              class="hover:text-wood-accent transition-colors"
              >&lt;- Back to Portfolio</a
            >
          </div>

          <!-- Header -->
          <header class="mb-12" data-aos="fade-up">
            <div class="mb-8 rounded-xl overflow-hidden shadow-2xl">
              <img
                src="../../assets/gym-ng-mga-supersaiyan.webp"
                alt="Gym Project"
                class="w-full h-auto object-cover max-h-[500px]"
                loading="lazy"
                decoding="async"
                width="800"
                height="450"
              />
            </div>
            <h1
              class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6"
            >
              Client Management & Progress Tracking Dashboard (Gym Project)
            </h1>
            <div class="flex flex-wrap gap-4 text-sm">
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Django</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Python</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Tailwind CSS</span
              >
            </div>
          </header>

          <!-- Project Links (Top) -->
          <div class="flex flex-wrap gap-4 mb-12" data-aos="fade-up" data-aos-delay="50">
            <a
              href="https://vibe-kbvc.onrender.com/login/?next=/"
              target="_blank"
              class="px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
            >
              <svg
                class="mr-2 w-5 h-5 mr-2"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                />
              </svg>
              Live Demo
            </a>
            <a
              href="https://github.com/property360-2/vibe"
              target="_blank"
              class="px-6 py-3 bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
            >
              <svg
                class="mr-2 w-5 h-5 mr-2"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                />
              </svg>
              View Code
            </a>
          </div>

          <!-- Content -->
          <div
            class="prose dark:prose-invert prose-lg prose-wood dark:prose-invert prose-wood max-w-none"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <h2>Overview</h2>
            <p>
              This project is a secure, database-driven client portal designed to track user performance metrics and membership states. While originally created for a fitness facility context, the architecture is directly applicable to physical therapy clinics, coaching businesses, and member-based centers seeking to eliminate paperwork and digitize progress tracking.
            </p>

            <h2>The Problem It Solves</h2>
            <p>
              Service-based operations and fitness businesses lose hours to manual tracking sheets, Excel tracking hacks, and disjointed client communication. This portal replaces paper-based charts with a secure, centralized dashboard. By tracking individual client metrics over time and automating membership status checking, it eliminates operational leakages, reduces human error, and delivers clear progress insights directly to the user.
            </p>

            <h3>Key Features</h3>
            <ul>
              <li>
                <strong>User Authentication:</strong> Secure login and
                registration flows.
              </li>
              <li>
                <strong>Membership Management:</strong> Track member details and
                subscription statuses.
              </li>
              <li>
                <strong>Responsive Design:</strong> Built with Tailwind CSS for
                a seamless mobile and desktop experience.
              </li>
            </ul>

            <!-- Conversion CTA Block -->
            <section class="py-12 bg-gray-50 dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-gray-800 p-8 text-center my-12">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Need to automate a similar bottleneck in your business?</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-xl mx-auto">Let's scour the inefficiencies and design a high-performance system customized for your exact operations.</p>
              <a href="/quick-portfolio/rate/" class="inline-flex items-center px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl transition-all shadow-md">
                Book a Free 15-Minute Strategy Call &rarr;
              </a>
            </section>

            <!-- Next Case Study Footer -->
            <div class="flex justify-between items-center border-t border-gray-200 dark:border-gray-800 pt-8 mt-8">
              <a href="/quick-portfolio/portfolio/" class="text-sm text-gray-500 hover:text-wood-accent transition-colors">&lt;- Back to Portfolio</a>
              <a href="/quick-portfolio/portfolio/iot-automation-integration/" class="text-sm font-bold text-wood-accent hover:text-wood-700 transition-colors">Next Case Study &rarr;</a>
            </div>
          </div>
        </div>
      </article>

      <!-- ORGANISMS: Footer -->
    </main>
</Layout>
