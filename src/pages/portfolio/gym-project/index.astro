---
/**
 * Client Management & Progress Tracking Dashboard Case Study
 * Purpose: Detailed case study for the Client Management & Progress Tracking Dashboard (Gym Project).
 * Contains: Project overview, key features, technology stack, and live links.
 * System Role: Provides in-depth information about a specific client portal solution.
 */
import Layout from '../../../layouts/Layout.astro';
const title = 'Fitness CRM & Client Metrics Dashboard Case Study | Jun Alvior';
const description = 'A secure, database-driven portal that tracks user metrics and performance. Built with Django and Tailwind CSS for fitness businesses, personal trainers, or rehab clinics.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Project Case Study -->
      <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow transition-colors duration-300 relative overflow-hidden">
        <div class="absolute inset-0 -z-10 bg-grid-wood opacity-[0.32] [mask-image:radial-gradient(ellipse_70%_45%_at_30%_0%,black_60%,transparent_110%)]"></div>
        <div class="absolute -top-24 -left-24 w-[520px] h-[520px] bg-wood-300/10 dark:bg-wood-400/5 rounded-full blur-[90px] pointer-events-none hidden md:block"></div>
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- Breadcrumb -->
          <div class="mb-8 text-sm text-gray-700 dark:text-gray-300">
            <a
              href="/quick-portfolio/portfolio/"
              class="hover:text-wood-accent transition-colors flex items-center gap-1 font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Back to Portfolio
            </a>
          </div>

          <!-- Header -->
          <header class="mb-12" data-aos="fade-up">
            <div class="mb-8 rounded-2xl overflow-hidden shadow-2xl border border-gray-200/50 dark:border-white/10/50">
              <img
                src="/quick-portfolio/assets/gym-ng-mga-supersaiyan.webp"
                alt="Gym Project"
                class="w-full h-auto object-cover max-h-[500px] hover:scale-101 transition-transform duration-700"
                loading="lazy"
                decoding="async"
                width="800"
                height="450"
              />
            </div>
            <h1
              class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4"
            >
              Fitness CRM & Client Metrics Dashboard (Gym Project)
            </h1>
            <div class="flex flex-wrap gap-2.5 mt-6">
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >Django</span
              >
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >Python</span
              >
              <span
                class="px-3 py-1 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-wood-900 dark:text-wood-100 rounded-full text-xs font-semibold tracking-wide shadow-sm transition-colors duration-300"
                >Tailwind CSS</span
              >
            </div>
          </header>

          <!-- Project Links (Top) -->
          <div class="flex flex-wrap gap-4 mb-12" data-aos="fade-up" data-aos-delay="50">
            <a
              href="https://vibe-kbvc.onrender.com/login/?next=/"
              target="_blank"
              class="px-6 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                />
              </svg>
              Live Demo
            </a>
            <a
              href="https://github.com/property360-2/vibe"
              target="_blank"
              class="px-6 py-3.5 bg-transparent border-2 border-wood-accent hover:bg-wood-50 dark:hover:bg-[#252528] text-wood-accent dark:text-wood-300 font-semibold rounded-xl shadow-sm hover:shadow-md transition-all transform hover:-translate-y-0.5 flex items-center gap-2"
            >
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                />
              </svg>
              View Code
            </a>
          </div>

          <!-- At-a-Glance Summary -->
          <section class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 rounded-2xl p-6 sm:p-8 mb-12" data-aos="fade-up">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-5 flex items-center gap-2">
              <svg class="w-5 h-5 text-wood-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              At a Glance
            </h2>
            <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-5 text-sm">
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Problem</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Gym ops scattered across notebooks — memberships, payments, and scheduling disconnected.</dd></div>
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Role</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Built the Django CRM — membership, billing, and ops in one system.</dd></div>
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Solution</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Centralized Fitness CRM with role-based access and reporting.</dd></div>
              <div><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Result</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Single source of truth for members, revenue, and operations.</dd></div>
              <div class="md:col-span-2"><dt class="font-bold text-wood-accent uppercase tracking-widest text-xs">Proof</dt><dd class="mt-1 text-gray-700 dark:text-gray-300 leading-relaxed">Live demo and GitHub above.</dd></div>
            </dl>
          </section>

          <!-- Content -->
          <div
            class="prose dark:prose-invert prose-lg prose-wood dark:prose-invert prose-wood max-w-none"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <h2>Overview</h2>
            <p>
              This project is a secure, database-driven client portal designed to track user performance metrics and membership states. While originally created for a fitness facility context, the architecture is directly applicable to physical therapy clinics, coaching businesses, and member-based centers seeking to eliminate paperwork and digitize progress tracking.
            </p>

            <h2>The Problem It Solves</h2>
            <p>
              Service-based operations and fitness businesses lose hours to manual tracking sheets, Excel tracking hacks, and disjointed client communication. This portal replaces paper-based charts with a secure, centralized dashboard. By tracking individual client metrics over time and automating membership status checking, it eliminates operational leakages, reduces human error, and delivers clear progress insights directly to the user.
            </p>

            <h3>Key Features</h3>
            <ul>
              <li>
                <strong>User Authentication:</strong> Secure login and
                registration flows.
              </li>
              <li>
                <strong>Membership Management:</strong> Track member details and
                subscription statuses.
              </li>
              <li>
                <strong>Responsive Design:</strong> Built with Tailwind CSS for
                a seamless mobile and desktop experience.
              </li>
            </ul>
          </div>

          <!-- Conversion CTA Block -->
          <section class="py-12 bg-gray-50 dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-white/10 p-8 text-center my-12" data-aos="fade-up">
            <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Want a tool like this?</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-xl mx-auto">Let's build a custom version for your workflow — fast, reliable, and tailored to your team.</p>
            <a href="/quick-portfolio/contact/" class="inline-flex items-center px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl transition-all shadow-md">
              Get in Touch &rarr;
            </a>
          </section>

          <!-- Next Case Study Footer -->
          <div class="flex justify-between items-center border-t border-gray-200 dark:border-white/10 pt-8 mt-8">
            <a href="/quick-portfolio/portfolio/" class="text-sm text-gray-500 hover:text-wood-accent transition-colors">&larr; Back to Portfolio</a>
            <a href="/quick-portfolio/portfolio/attendance-management-system-school/" class="text-sm font-bold text-wood-accent hover:text-wood-700 transition-colors">Next Case Study &rarr;</a>
          </div>
        </div>
      </article>

      <!-- ORGANISMS: Footer -->
    </main>
</Layout>
