                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
