---
/**
 * Portfolio Index Page
 * Purpose: Showcases a gallery of selected projects with filtering capabilities.
 * Contains: Filterable project cards for Fullstack, Frontend, Tools, and GameDev projects.
 * System Role: The main hub for exploring the developer's work, including direct links to live demos and case studies.
 */
import Layout from '../../layouts/Layout.astro';
import Carousel from '../../components/Carousel.astro';
const title = 'Strategic Portfolio | AI Automation & Full Stack Solutions | Jun Alvior';
const description = "Explore professional AI automation systems, enterprise-grade software portals, and high-performance digital solutions designed to scale business operations.";
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Portfolio -->
      <section
        id="portfolio"
        class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16 max-w-3xl mx-auto">
            <h2
              class="text-sm font-bold tracking-widest text-wood-accent uppercase gs-reveal"
            >
              Problems Solved & Results Delivered
            </h2>
            <h3
              class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl gs-reveal"
            >
              Case Studies: Real Proof of Pain Fixed
            </h3>
            <p class="mt-4 text-base text-gray-600 dark:text-gray-400 gs-reveal leading-relaxed">
              I don’t just write code; I design systems that eliminate business friction. Whether you're an agency needing a high-velocity developer to ship an MVP or a business losing hours to manual spreadsheets, here is direct proof of custom software built to save time, reduce costs, and scale operations.
            </p>
          </div>

          <!-- Project Filters -->
          <div
            class="flex flex-wrap justify-center gap-4 mb-12 gs-reveal"
            id="portfolio-filters"
          >
            <button
              class="filter-btn active px-6 py-2 rounded-full bg-wood-accent text-white font-medium transition-colors"
              data-filter="all"
            >
              All
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="fullstack"
            >
              Full-Stack
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="iot"
            >
              IoT & Systems
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="automation"
            >
              Automation & Tools
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="gamedev"
            >
              GameDev
            </button>
          </div>

          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-8"
            id="portfolio-grid"
          >
            <!-- Project: Ano Pong Ulam? Heirloom Recipe Sharing PWA -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-category="fullstack"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/ano-po-ulam/desktop-ano-po-ulam.png"
                  alt="Ano Pong Ulam? Heirloom Recipe Sharing & Meal Planning PWA"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/ano-po-ulam/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://ano-pong-ulam.vercel.app/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                    <a
                      href="https://github.com/property360-2/ano-pong-ulam"
                      target="_blank"
                      class="text-white bg-gray-800 px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-gray-900 transition-colors"
                      >GitHub</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/ano-po-ulam/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Ano Pong Ulam? Heirloom Recipe Sharing PWA
                </h4>
                <div class="flex flex-wrap gap-1.5 mt-2 mb-3">
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Next.js 15 (App Router)</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Tailwind CSS v4</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Prisma</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">PostgreSQL</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">PWA (Offline SW)</span>
                </div>
                <p class="text-xs font-semibold text-wood-accent mt-1 italic">
                  Pain Fixed: Loss of offline recipe drafts, slow load times, and fragmented community review feeds.
                </p>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-2 leading-relaxed">
                  Engineered a feature-rich Progressive Web App for preserving Filipino heirloom recipes. Features a multi-step recipe draft wizard with localStorage auto-save, a visual-first consolidated social feed, drag-and-drop meal planning calendar, and offline-first capabilities using custom service workers.
                </p>
              </a>
            </div>

            <!-- Project: Automation Pick-up Service -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-category="fullstack"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/automation-showcase.png"
                  alt="Automation Pick-up Service"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/automation-pick-up-service/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="http://automation-pick-up-service.vercel.app/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                    <a
                      href="https://github.com/property360-2/automation-pick-up-service"
                      target="_blank"
                      class="text-white bg-gray-800 px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-gray-900 transition-colors"
                      >GitHub</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/automation-pick-up-service/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Automation Pick-up Service
                </h4>
                <div class="flex flex-wrap gap-1.5 mt-2 mb-3">
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Node.js</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Express.js</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Google Sheets API</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Nodemailer</span>
                </div>
                <p class="text-xs font-semibold text-wood-accent mt-1 italic">
                  Pain Fixed: Manual spreadsheet tracking, stock sync delays & operational drag.
                </p>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-2 leading-relaxed">
                  Replaced slow, error-prone manual spreadsheets with a high-performance inventory system. Reduced administrative overhead by 90% via automated Google Sheets synchronization and real-time email notifications.
                </p>
              </a>
            </div>

            <!-- Project: RFID IoT Membership Scanner & Automation Integration -->
