            >
              <div class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end">
                <img
                  src="/quick-portfolio/assets/gym-ng-mga-supersaiyan.webp"
                  alt="Gym Project"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
              </div>
              <div class="mt-4">
                <h4 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors">
                  Fitness CRM
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-2 leading-relaxed">
                  Centralized gym membership, customer, and operational workflows into a single management system.
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-3">
                  <span class="font-semibold text-gray-600 dark:text-gray-300">Built with:</span>
                  Django · PostgreSQL · Bootstrap · Chart.js
