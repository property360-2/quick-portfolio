                      src="/quick-portfolio/assets/iot-automation-integration/localhost.png"
                      alt="RFID IoT Membership Scanner - Staff Scan Dashboard"
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="w-full h-full flex-shrink-0">
                    <img
                      src="/quick-portfolio/assets/iot-automation-integration/online.png"
                      alt="RFID IoT Membership Scanner - Public Status Portal"
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="w-full h-full flex-shrink-0">
                    <img
                      src="/quick-portfolio/assets/iot-automation-integration/workflow.png"
                      alt="RFID IoT Membership Scanner - n8n Workflow"
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="w-full h-full flex-shrink-0">
                    <img
                      src="/quick-portfolio/assets/iot-automation-integration/IMG_20260605_154927.jpg"
                      alt="RFID IoT Membership Scanner - Physical Hardware Setup"
                      class="w-full h-full object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </Carousel>

                <!-- Hover Overlay -->
                <div
