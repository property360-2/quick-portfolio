                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/tagforge/" class="block mt-4">
