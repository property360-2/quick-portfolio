---
/**
 * Portfolio Index Page
 * Purpose: Showcases a gallery of selected projects with filtering capabilities.
 * Structure: Problem → Outcome → Technology, with featured projects prioritized.
 * Contains: Filterable project cards for Fullstack, IoT, Automation, and GameDev projects.
 */
import Layout from '../../layouts/Layout.astro';
const title = 'Selected Projects | Jun Alvior | Full Stack Developer';
const description = 'Selected full-stack applications, automation systems, AI tools, and IoT projects built by Jun Alvior to solve practical problems.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <section
        id="portfolio"
        class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16 max-w-3xl mx-auto">
            <h2
              class="text-sm font-bold tracking-widest text-wood-accent uppercase gs-reveal"
            >
              Selected Projects
            </h2>
            <h3
              class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl gs-reveal"
            >
              Work That Solves Practical Problems
            </h3>
            <p class="mt-4 text-base text-gray-600 dark:text-gray-400 gs-reveal leading-relaxed">
              A collection of full-stack applications, automation systems, AI tools, and IoT projects built to solve practical problems.
            </p>
          </div>

          <div
            class="flex flex-wrap justify-center gap-2 sm:gap-3 md:gap-4 mb-12 gs-reveal"
            id="portfolio-filters"
          >
            <button
              class="filter-btn active px-3 py-1.5 sm:px-5 sm:py-2 rounded-full bg-wood-accent text-white font-medium text-xs sm:text-sm md:text-base transition-colors"
              data-filter="all"
            >
              All
            </button>
            <button
              class="filter-btn px-3 py-1.5 sm:px-5 sm:py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white font-medium text-xs sm:text-sm md:text-base transition-colors"
              data-filter="fullstack"
            >
              Full-Stack
            </button>
            <button
              class="filter-btn px-3 py-1.5 sm:px-5 sm:py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white font-medium text-xs sm:text-sm md:text-base transition-colors"
              data-filter="iot"
            >
              IoT & Systems
            </button>
            <button
              class="filter-btn px-3 py-1.5 sm:px-5 sm:py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white font-medium text-xs sm:text-sm md:text-base transition-colors"
              data-filter="automation"
            >
              Automation & Tools
            </button>
            <button
              class="filter-btn px-3 py-1.5 sm:px-5 sm:py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white font-medium text-xs sm:text-sm md:text-base transition-colors"
              data-filter="gamedev"
            >
              GameDev
            </button>
          </div>

          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-8"
            id="portfolio-grid"
          >
            <!-- ============================================================
                 FEATURED PROJECTS (Tier 1)
                 ============================================================ -->

            <!-- Featured: Automation Pick-up Service -->
            <div
              class="project-card group md:col-span-2"
              data-aos="fade-up"
              data-category="fullstack"
            >
              <div class="grid grid-cols-1 md:grid-cols-2 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm overflow-hidden hover:border-wood-accent/40 hover:shadow-2xl transition-all duration-300">
                <div class="relative overflow-hidden aspect-video md:aspect-auto md:min-h-[260px] bg-gray-200">
                  <img
                    src="/quick-portfolio/assets/automation-showcase.png"
                    alt="Automation Pick-up Service"
                    class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="450"
                  />
                  <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-wood-accent text-white shadow-lg">Featured</span>
                </div>
                <div class="p-6 md:p-8 flex flex-col justify-center">
                  <h4 class="text-2xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors">
                    Automation Pick-up Service
                  </h4>
                  <p class="text-gray-600 dark:text-gray-400 text-base mt-3 leading-relaxed">
                    Replaced manual inventory tracking with an automated workflow that synchronizes data and notifications across business operations.
                  </p>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-4">
                    <span class="font-semibold text-gray-600 dark:text-gray-300">Built with:</span>
                    Node.js · Express.js · Google Sheets API · Nodemailer
                  </p>
                  <div class="flex flex-wrap gap-2 mt-5">
                    <a href="/quick-portfolio/portfolio/automation-pick-up-service/" class="inline-flex items-center px-4 py-2 bg-wood-accent hover:bg-wood-700 text-white text-xs font-semibold rounded-full transition-colors shadow-sm">View Details &rarr;</a>
                    <a href="http://automation-pick-up-service.vercel.app/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 border border-wood-accent text-wood-accent dark:text-wood-300 hover:bg-wood-50 dark:hover:bg-[#1a1a1a] text-xs font-semibold rounded-full transition-colors">Live Demo</a>
                    <a href="https://github.com/property360-2/automation-pick-up-service" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-gray-400 dark:hover:border-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 text-xs font-semibold rounded-full transition-colors">GitHub</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- Featured: RFID IoT Membership Scanner -->
            <div
              class="project-card group md:col-span-2"
              data-aos="fade-up"
              data-category="fullstack iot"
            >
              <div class="grid grid-cols-1 md:grid-cols-2 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm overflow-hidden hover:border-wood-accent/40 hover:shadow-2xl transition-all duration-300">
                <div class="relative overflow-hidden aspect-video md:aspect-auto md:min-h-[260px] bg-gray-200">
                  <img
                    src="/quick-portfolio/assets/iot-automation-integration/localhost.png"
                    alt="RFID IoT Membership Scanner - Staff Scan Dashboard"
                    class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="450"
                  />
                  <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-wood-accent text-white shadow-lg">Featured</span>
                </div>
                <div class="p-6 md:p-8 flex flex-col justify-center">
                  <h4 class="text-2xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors">
                    RFID IoT Membership Scanner
                  </h4>
                  <p class="text-gray-600 dark:text-gray-400 text-base mt-3 leading-relaxed">
                    Automated membership check-ins and attendance tracking using an offline-capable RFID system.
                  </p>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-4">
                    <span class="font-semibold text-gray-600 dark:text-gray-300">Built with:</span>
                    ESP32 · C++ · RFID · Supabase · n8n · Telegram API
                  </p>
                  <div class="flex flex-wrap gap-2 mt-5">
                    <a href="/quick-portfolio/portfolio/iot-automation-integration/" class="inline-flex items-center px-4 py-2 bg-wood-accent hover:bg-wood-700 text-white text-xs font-semibold rounded-full transition-colors shadow-sm">View Details &rarr;</a>
                    <a href="https://github.com/property360-2/quick-portfolio" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:border-gray-400 dark:hover:border-gray-500 hover:bg-gray-50 dark:hover:bg-gray-800 text-xs font-semibold rounded-full transition-colors">GitHub</a>
