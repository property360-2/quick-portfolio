---
/**
 * Portfolio Index Page
 * Purpose: Showcases a gallery of selected projects with filtering capabilities.
 * Contains: Filterable project cards for Fullstack, Frontend, Tools, and GameDev projects.
 * System Role: The main hub for exploring the developer's work, including direct links to live demos and case studies.
 */
import Layout from '../../layouts/Layout.astro';
import { RENDER_COLD_START_NOTE } from '../../utils/constants';
const title = 'Portfolio & Projects | Jun Alvior | Full Stack Software Developer';
const description = "Explore Jun Alvior's web development projects, including Gym Systems, Finance Trackers, and Cloud-integrated apps built with Supabase and Django.";
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Portfolio -->
      <section
        id="portfolio"
        class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2
              class="text-sm font-bold tracking-widest text-wood-accent uppercase gs-reveal"
            >
              Portfolio
            </h2>
            <h3
              class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl gs-reveal"
            >
              Selected Work
            </h3>
          </div>

          <!-- Project Filters -->
          <div
            class="flex flex-wrap justify-center gap-4 mb-12 gs-reveal"
            id="portfolio-filters"
          >
            <button
              class="filter-btn active px-6 py-2 rounded-full bg-wood-accent text-white font-medium transition-colors"
              data-filter="all"
            >
              All
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="fullstack"
            >
              Fullstack
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="frontend"
            >
              Frontend
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="tools"
            >
              Tools
            </button>
            <button
              class="filter-btn px-6 py-2 rounded-full bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-wood-accent hover:text-white transition-colors"
              data-filter="gamedev"
            >
              GameDev
            </button>
          </div>

          <div
            class="grid grid-cols-1 md:grid-cols-2 gap-8"
            id="portfolio-grid"
          >
            <!-- Project: Automation Pick-up Service -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-category="fullstack"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/automation-showcase.png"
                  alt="Automation Pick-up Service"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/automation-pick-up-service/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="http://automation-pick-up-service.vercel.app/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                    <a
                      href="https://docs.google.com/spreadsheets/d/1YDC6X73PJHPYlcC_4H1PIFmwk91Nng_UoCbuDzGnJHg/edit?usp=sharing"
                      target="_blank"
                      class="text-white bg-green-600 px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-green-700 transition-colors"
                      >Google DB</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/automation-pick-up-service/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Automation Pick-up Service
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  A professional web application streamlining inventory and order fulfillment for local businesses.
                </p>
              </a>
            </div>

            <!-- Project: OJT Daily Journal System -->


            <div
              class="project-card group"
              data-aos="fade-up"
              data-category="tools"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/ojt-journals.png"
                  alt="OJT Daily Journal System"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/ojt-journals/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://property360-2.github.io/ojt-journals/index.html"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/ojt-journals/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  OJT Daily Journal System
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  A modern, web-based daily journal system designed for OJT students to log their daily activities.
                </p>
              </a>
            </div>

            <!-- Project: DocuMind AI (Tropang AI) -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-aos-delay="100"
              data-category="fullstack"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/tropang-ai.png"
                  alt="DocuMind AI"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/documind-ai/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://tropangai.vercel.app/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/documind-ai/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  DocuMind AI
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  A professional-grade RAG platform for chatting with documents (PDF, DOCX, XLSX) using high-speed AI.
                </p>
              </a>
            </div>

            <!-- Project: Gym Project -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-aos-delay="200"
              data-category="fullstack"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/gym-ng-mga-supersaiyan.webp"
                  alt="Gym Project"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/gym-project/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://vibe-kbvc.onrender.com/login/?next=/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                  <p class="text-[10px] text-gray-300 px-6 italic leading-tight">
                    {RENDER_COLD_START_NOTE}
                  </p>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/gym-project/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Gym Project
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  A full-featured gym management and membership system.
                </p>
                <p class="text-[10px] text-gray-500 dark:text-gray-500 mt-2 italic leading-tight">
                  {RENDER_COLD_START_NOTE}
                </p>
              </a>
            </div>

            <!-- Project: Tagawasak ng Syudad -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-aos-delay="300"
              data-category="gamedev"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/tagawasak-ng-syudad.webp"
                  alt="Tagawasak ng Syudad"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/inside-portfolio-game/tagasira-ng-syudad/index.html"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="http://localhost:4321/quick-portfolio/portfolio/inside-portfolio-game/tagasira-ng-syudad/index.html"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                </div>
              </div>
              <a
                href="/quick-portfolio/portfolio/tagawasak-ng-syudad/"
                class="block mt-4"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Tagawasak ng Syudad
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  An interactive 3D city destruction sandbox mini-game with custom procedural Web Audio sound effects.
                </p>
              </a>
            </div>

            <!-- Project: Precision Scrollytelling Gallery -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-aos-delay="400"
              data-category="frontend"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/scrollytelling-gallery.png"
                  alt="Precision Scrollytelling Gallery"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/scrollytelling-gallery/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://next-js-on-scroll-animation.vercel.app/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/scrollytelling-gallery/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Precision Scrollytelling Gallery
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  An immersive scrollytelling experience with interactive video assembly sequences.
                </p>
              </a>
            </div>

            <!-- Project: Study Time Tracker -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-aos-delay="500"
              data-category="tools"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/study-time-tracker.webp"
                  alt="Study Time Tracker"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/study-time-tracker/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://simple-study-time-tracker.onrender.com/journal/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                  <p class="text-[10px] text-gray-300 px-6 italic leading-tight">
                    {RENDER_COLD_START_NOTE}
                  </p>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/study-time-tracker/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Study Time Tracker
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  A productivity tool for tracking study sessions.
                </p>
                <p class="text-[10px] text-gray-500 dark:text-gray-500 mt-2 italic leading-tight">
                  {RENDER_COLD_START_NOTE}
                </p>
              </a>
            </div>

            <!-- Project: Mind Map Maker -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-aos-delay="600"
              data-category="tools"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/mind-map-maker.webp"
                  alt="Mind Map Maker"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/mind-map-maker/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://property360-2.github.io/mind-map/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/mind-map-maker/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Mind Map Maker
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  An interactive mind mapping tool that asynchronously saves your ideas locally.
                </p>
              </a>
            </div>

            <!-- Project: Solar System -->
            <div
              class="project-card group"
              data-aos="fade-up"
              data-aos-delay="700"
              data-category="frontend"
            >
              <div
                class="relative overflow-hidden rounded-xl shadow-lg aspect-video bg-gray-200 flex flex-col justify-end"
              >
                <img
                  src="../assets/solar-system.webp"
                  alt="Solar System"
                  class="absolute inset-0 object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="800"
                  height="450"
                />
                <div
                  class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col items-center justify-center p-8 gap-4 z-10 text-center"
                >
                  <div class="flex flex-wrap justify-center gap-4">
                    <a
                      href="/quick-portfolio/portfolio/solar-system-showcase/"
                      class="text-white border px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-white hover:text-black transition-colors"
                      >View Details</a
                    >
                    <a
                      href="https://property360-2.github.io/planets-blog/"
                      target="_blank"
                      class="text-white bg-wood-accent px-4 py-2 rounded-full text-sm font-medium tracking-wide hover:bg-wood-700 transition-colors"
                      >Live Demo</a
                    >
                  </div>
                </div>
              </div>
              <a href="/quick-portfolio/portfolio/solar-system-showcase/" class="block mt-4">
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-wood-accent transition-colors"
                >
                  Solar System
                </h4>
                <p class="text-gray-600 dark:text-gray-400 text-sm mt-1">
                  An immersive interactive web experience exploring our solar system through procedural SVG art and fluid motion.
                </p>
              </a>
            </div>



          </div>

          <!-- More Projects Coming Soon -->
          <div
            class="mt-16 text-center"
            data-aos="fade-up"
            data-aos-delay="300"
          >
            <p
              class="text-lg text-gray-600 dark:text-gray-400 font-medium italic"
            >
              "More exciting projects are coming soon. Stay tuned!"
            </p>
            <div class="mt-4 flex justify-center">
              <span
                class="inline-block w-16 h-1 bg-wood-accent rounded-full opacity-50"
              ></span>
            </div>
          </div>
        </div>
      </section>

      <!-- ORGANISMS: Footer -->
    </main>
</Layout>
