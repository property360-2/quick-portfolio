                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">GitHub Pages</span>
                  <span class="px-2 py-0.5 bg-gray-150 dark:bg-gray-800 text-gray-800 dark:text-gray-300 rounded text-[10px] font-bold tracking-wide">Tailwind CSS</span>
