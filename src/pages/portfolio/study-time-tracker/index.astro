---
/**
 * Study Time Tracker Case Study Page
 * Purpose: Detailed case study for the Study Time Tracker productivity app.
 * Contains: Project highlights, technical details, and direct access links.
 * System Role: Showcases a specific tool built to solve student productivity challenges.
 */
import Layout from '../../../layouts/Layout.astro';
import { RENDER_COLD_START_NOTE } from '../../../utils/constants';
const title = 'Study Time Tracker: Productivity App for Students | Jun Alvior';
const description = 'Boost your productivity with the Study Time Tracker. Log sessions, visualize progress, and manage academic goals with this Django-powered web tool.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Project Case Study -->
      <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- Breadcrumb -->
          <div class="mb-8 text-sm text-gray-500 dark:text-gray-400">
            <a
              href="../../portfolio/"
              class="hover:text-wood-accent transition-colors"
              ><- Back to Portfolio</a
            >
          </div>

          <!-- Header -->
          <header class="mb-12" data-aos="fade-up">
            <div class="mb-8 rounded-xl overflow-hidden shadow-2xl">
              <img
                src="../../assets/study-time-tracker.webp"
                alt="Study Time Tracker"
                class="w-full h-auto object-cover max-h-[500px]"
                loading="lazy"
                decoding="async"
                width="800"
                height="450"
              />
            </div>
            <h1
              class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6"
            >
              Study Time Tracker
            </h1>
            <div class="flex flex-wrap gap-4 text-sm">
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Django</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Productivity</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent text-wood-accent rounded-full font-medium"
                >Web App</span
              >
            </div>
          </header>

          <!-- Project Links (Top) -->
          <div class="flex flex-wrap gap-4 mb-12" data-aos="fade-up" data-aos-delay="50">
            <a
              href="https://simple-study-time-tracker.onrender.com/journal/"
              target="_blank"
              class="px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
            >
              <svg
                class="mr-2 w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                />
              </svg>
              Live Demo
            </a>
            <a
              href="https://github.com/property360-2/kay-jm"
              target="_blank"
              class="px-6 py-3 bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
            >
              <svg
                class="mr-2 w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                />
              </svg>
              View Code
            </a>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 italic mb-12" data-aos="fade-up" data-aos-delay="60">
            {RENDER_COLD_START_NOTE}
          </p>

          <!-- Content -->
          <div
            class="prose dark:prose-invert prose-lg prose-wood max-w-none"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <h2>Overview</h2>
            <p>
              A simple and effective web application designed to help students and professionals track their study sessions and manage their time more efficiently.
            </p>

            <h2>The Problem It Solves</h2>
            <p>
              Students and professionals frequently lose track of their net academic effort due to multitasking and visual fatigue. Distracted workflows lead to poor time management and lack of accountability. This productivity tool solves this by providing a distraction-free, robust logger that logs, aggregates, and renders clean progress reports to keep learners accountable and highly motivated.
            </p>

            <h3>Key Features</h3>
            <ul>
              <li>
                <strong>Session Tracking:</strong> Log start and end times for study sessions.
              </li>
              <li>
                <strong>Progress Visualization:</strong> View daily and weekly study statistics.
              </li>
              <li>
                <strong>Goal Setting:</strong> Set and track personal study goals.
              </li>
            </ul>
          </div>
        </div>
      </article>

      <!-- ORGANISMS: Footer -->
    </main>
</Layout>
