---
/**
 * Automation Pick-up Service Case Study
 * Purpose: Provides a detailed breakdown of the Automation Pick-up Service project.
 * Contains: Project overview, technical stack, key features, and links to the live demo and source code.
 * System Role: A case study page within the portfolio to showcase fullstack and automation capabilities.
 */
import Layout from '../../../layouts/Layout.astro';
const title = 'Automation Pick-up Service | Smart Inventory & Fulfillment';
const description = 'A professional web application designed to streamline inventory management and order fulfillment for local businesses using Google Sheets as a database.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Project Case Study -->
      <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- Breadcrumb -->
          <div class="mb-8 text-sm text-gray-500 dark:text-gray-400">
            <a
              href="/quick-portfolio/portfolio/"
              class="hover:text-wood-accent transition-colors"
            >
              &larr; Back to Portfolio
            </a>
          </div>

          <!-- Header -->
          <header class="mb-12" data-aos="fade-up">
            <div class="mb-8 rounded-xl overflow-hidden shadow-2xl">
              <img
                src="/quick-portfolio/assets/automation-showcase.png"
                alt="Automation Pick-up Service"
                class="w-full h-auto object-cover max-h-[500px]"
                loading="lazy"
                decoding="async"
                width="800"
                height="450"
              />
            </div>
            <h1
              class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6"
            >
              Automation Pick-up Service
            </h1>
            <div class="flex flex-wrap gap-4 text-sm">
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent rounded-full font-medium"
                >React</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent rounded-full font-medium"
                >Google Sheets API</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent rounded-full font-medium"
                >Firebase</span
              >
              <span
                class="px-3 py-1 bg-wood-100 dark:bg-wood-900 text-wood-accent rounded-full font-medium"
                >Tailwind CSS 4</span
              >
            </div>
          </header>
          
          <!-- Project Links (Top) -->
          <div class="flex flex-wrap gap-4 mb-12" data-aos="fade-up" data-aos-delay="50">
            <a
              href="http://automation-pick-up-service.vercel.app/"
              target="_blank"
              class="px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
            >
              <svg
                class="mr-2 w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                />
              </svg>
              Live Demo
            </a>
            <a
              href="https://github.com/property360-2/automation-pick-up-service"
              target="_blank"
              class="px-6 py-3 bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-900 dark:text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
            >
              <svg
                class="mr-2 w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                />
              </svg>
              View Code
            </a>
            <a
              href="https://docs.google.com/spreadsheets/d/1YDC6X73PJHPYlcC_4H1PIFmwk91Nng_UoCbuDzGnJHg/edit?usp=sharing"
              target="_blank"
              class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg shadow-md transition-all transform hover:-translate-y-0.5 flex items-center"
            >
              <svg
                class="mr-2 w-5 h-5"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                 <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13Z" />
              </svg>
              Google Sheets DB
            </a>
          </div>

          <!-- Content -->
          <div
            class="prose dark:prose-invert prose-lg prose-wood max-w-none"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            <h2>Overview</h2>
            <p>
              The Automation Pick-up Service is a high-performance web application designed to bridge the gap between traditional manual inventory management and modern digital workflows. By leveraging Google Sheets as a lightweight, real-time database, it allows business owners to manage their stock effortlessly while providing customers with a sleek, real-time ordering experience.
            </p>

            <h2>The Problem It Solves</h2>
            <p>
              Many local businesses and growing service operations struggle with manual spreadsheet coordination, stock discrepancies, and delayed customer pickup notifications. This app replaces manual entry by building an automated public catalog synced in real-time with Google Sheets, notifying customers instantly when their order is ready, and reducing administrative overhead by 90%.
            </p>

            <h3>Core Features</h3>
            <ul>
              <li>
                <strong>Public Inventory System:</strong> A high-performance product catalog pulled directly from Google Sheets, ensuring data consistency without complex database overhead.
              </li>
              <li>
                <strong>Secure Ordering Workflow:</strong> Integrated with Firebase Authentication for secure customer accounts and order tracking.
              </li>
              <li>
                <strong>Admin Fulfillment Hub:</strong> A dedicated dashboard for store owners to manage pending orders, update fulfillment status, and monitor business performance.
              </li>
              <li>
                <strong>Automated Event Triggers:</strong> Real-time email notifications powered by Resend, alerting customers when orders are placed and ready for pickup.
              </li>
              <li>
                <strong>Glassmorphic UI:</strong> Built with Tailwind CSS 4 and Framer Motion for a premium, responsive aesthetic that feels alive.
              </li>
            </ul>

            <h3>Technical Architecture</h3>
            <p>
              The system operates on four technology pillars:
            </p>
            <ol>
              <li><strong>Identity:</strong> Secure user management via Firebase Auth.</li>
              <li><strong>Database:</strong> Google Sheets API for a flexible, collaborative data source.</li>
              <li><strong>Automation:</strong> Vercel Serverless Functions orchestrating order flows and email triggers.</li>
              <li><strong>Frontend:</strong> React + Vite for a blazing-fast user experience.</li>
            </ol>

            <!-- Conversion CTA Block -->
            <section class="py-12 bg-gray-50 dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-gray-800 p-8 text-center my-12">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">Need to automate a similar bottleneck in your business?</h3>
              <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-xl mx-auto">Let's scour the inefficiencies and design a high-performance system customized for your exact operations.</p>
              <a href="/quick-portfolio/rate/" class="inline-flex items-center px-6 py-3 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl transition-all shadow-md">
                Book a Free 15-Minute Strategy Call &rarr;
              </a>
            </section>

            <!-- Next Case Study Footer -->
            <div class="flex justify-between items-center border-t border-gray-200 dark:border-gray-800 pt-8 mt-8">
              <a href="/quick-portfolio/portfolio/" class="text-sm text-gray-500 hover:text-wood-accent transition-colors">&larr; Back to Portfolio</a>
              <a href="/quick-portfolio/portfolio/documind-ai/" class="text-sm font-bold text-wood-accent hover:text-wood-700 transition-colors">Next Case Study &rarr;</a>
            </div>
          </div>
        </div>
      </article>
    </main>
</Layout>
