---
/**
 * Contact and Resume Page Component
 * Visual revamp to match homepage system: grid bg, Sora, pill header, 2-col sticky layout.
 */
import Layout from "../../layouts/Layout.astro";

const title = "Contact & Resume | Dionisio Alvior | Full Stack Software Developer";
const description = "Get in touch with Dionisio Alvior, Full Stack Software Developer. View the latest resume online or download a PDF, and send direct inquiries.";
---

<Layout title={title} description={description}>
  <main id="main-content" class="flex-grow flex flex-col">
    <section id="contact-hub" class="section-py bg-grey-light dark:bg-[#1a1a1a] w-full relative overflow-hidden transition-colors duration-300">
      <!-- Subtle grid + wash - matches homepage -->
      <div class="absolute inset-0 -z-10 bg-grid-wood opacity-[0.45] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,black_70%,transparent_110%)]"></div>
      <div class="absolute -top-24 -left-24 w-[520px] h-[520px] bg-wood-300/12 dark:bg-wood-400/8 rounded-full blur-[90px] pointer-events-none hidden md:block"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Header -->
        <div class="text-center mb-10 sm:mb-12 max-w-2xl mx-auto">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white dark:bg-[#252528] border border-wood-100 dark:border-white/10 shadow-sm">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-[11px] font-bold tracking-[0.14em] uppercase text-wood-700 dark:text-wood-300">Usually replies in 1–2 business days</span>
          </span>
          <h1 class="mt-4 font-display text-4xl sm:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white text-balance">
            Let's Work Together
          </h1>
          <p class="max-w-xl mx-auto mt-3 text-base sm:text-lg text-gray-600 dark:text-gray-400 leading-relaxed text-pretty">
            Open to software development opportunities, freelance projects, and collaborations.
          </p>
        </div>

        <div class="grid lg:grid-cols-5 gap-6 lg:gap-8 items-start">
          <!-- Left sticky -->
          <div class="lg:col-span-2 space-y-6 lg:sticky lg:top-24">
            <div class="p-7 sm:p-8 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 rounded-2xl shadow-sm">
              <div class="flex items-center gap-3 mb-6">
                <span class="w-10 h-10 rounded-xl bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent ring-1 ring-wood-accent/10">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                </span>
                <div>
                  <h2 class="font-display text-lg font-bold text-gray-900 dark:text-white leading-none">Contact</h2>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Pick what works for you</p>
                </div>
              </div>

              <div class="space-y-5">
                <!-- Email -->
                <div class="group flex items-start gap-4 p-3 -m-3 rounded-xl hover:bg-grey-light/70 dark:hover:bg-white/[0.04] transition-colors">
                  <span class="w-10 h-10 rounded-xl bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent shrink-0 ring-1 ring-wood-accent/10 group-hover:bg-wood-accent group-hover:text-white transition-colors">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xs font-bold tracking-widest uppercase text-gray-500 dark:text-gray-400">Email</h3>
                    <a href="mailto:junalvior.dev@gmail.com" class="mt-1 block text-sm font-semibold text-gray-900 dark:text-white hover:text-wood-accent dark:hover:text-wood-300 break-all">junalvior.dev@gmail.com</a>
                    <a href="mailto:junalvior.dev@gmail.com" class="mt-1 inline-flex text-xs font-semibold text-wood-accent hover:text-wood-700 dark:text-wood-300">Send email →</a>
                  </div>
                  <button type="button" data-copy="junalvior.dev@gmail.com" class="copy-btn hidden sm:inline-flex p-2 rounded-lg bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 text-gray-500 hover:text-wood-accent hover:border-wood-accent/30 transition-colors" aria-label="Copy email">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                  </button>
                </div>

                <!-- Phone -->
                <div class="group flex items-start gap-4 p-3 -m-3 rounded-xl hover:bg-grey-light/70 dark:hover:bg-white/[0.04] transition-colors">
                  <span class="w-10 h-10 rounded-xl bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent shrink-0 ring-1 ring-wood-accent/10">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xs font-bold tracking-widest uppercase text-gray-500 dark:text-gray-400">Phone</h3>
                    <a href="tel:+639167545563" class="mt-1 block text-sm font-semibold text-gray-900 dark:text-white hover:text-wood-accent">0916 754 5563</a>
                    <span class="mt-1 block text-xs text-gray-500 dark:text-gray-400">Viber / WhatsApp</span>
                  </div>
                  <button type="button" data-copy="09167545563" class="copy-btn hidden sm:inline-flex p-2 rounded-lg bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 text-gray-500 hover:text-wood-accent hover:border-wood-accent/30 transition-colors" aria-label="Copy phone">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                  </button>
                </div>

                <!-- Location -->
                <div class="flex items-start gap-4 p-3 -m-3 rounded-xl">
                  <span class="w-10 h-10 rounded-xl bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent shrink-0 ring-1 ring-wood-accent/10">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  </span>
                  <div>
                    <h3 class="text-xs font-bold tracking-widest uppercase text-gray-500 dark:text-gray-400">Location</h3>
                    <p class="mt-1 text-sm font-semibold text-gray-900 dark:text-white">Bulacan, Philippines</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Open to remote & hybrid</p>
                  </div>
                </div>

                <!-- LinkedIn -->
                <div class="flex items-start gap-4 p-3 -m-3 rounded-xl hover:bg-grey-light/70 dark:hover:bg-white/[0.04] transition-colors">
                  <span class="w-10 h-10 rounded-xl bg-[#0A66C2]/10 flex items-center justify-center text-[#0A66C2] shrink-0 ring-1 ring-[#0A66C2]/10">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xs font-bold tracking-widest uppercase text-gray-500 dark:text-gray-400">LinkedIn</h3>
                    <a href="https://www.linkedin.com/in/dionisio-jun-alvior-732987364/" target="_blank" rel="noopener noreferrer" class="mt-1 block text-sm font-semibold text-gray-900 dark:text-white hover:text-wood-accent break-words">Jun Alvior</a>
                    <a href="https://www.linkedin.com/in/dionisio-jun-alvior-732987364/" target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-wood-accent hover:text-wood-700">View profile →</a>
                  </div>
                </div>
              </div>
            </div>

            <div class="p-6 sm:p-7 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 rounded-2xl shadow-sm">
              <h3 class="text-xs font-bold tracking-[0.14em] uppercase text-wood-700 dark:text-wood-300">Elsewhere</h3>
              <div class="mt-4 flex flex-wrap gap-2.5">
                <a href="https://www.linkedin.com/in/dionisio-jun-alvior-732987364/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 hover:border-wood-accent/30 hover:text-wood-accent hover:shadow-sm transition-all">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" /></svg>
                  LinkedIn
                </a>
                <a href="https://github.com/property360-2" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 hover:border-wood-accent/30 hover:text-wood-accent hover:shadow-sm transition-all">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z" /></svg>
                  GitHub
                </a>
                <a href={`mailto:junalvior.dev@gmail.com`} class="inline-flex items-center gap-2 px-4 py-2.5 bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm font-semibold text-gray-700 dark:text-gray-300 hover:border-wood-accent/30 hover:text-wood-accent hover:shadow-sm transition-all">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                  Email
                </a>
              </div>
              <p class="mt-4 text-xs text-gray-500 dark:text-gray-400">Fastest is email — I check LinkedIn too.</p>
            </div>
          </div>

          <!-- Right -->
          <div class="lg:col-span-3 space-y-6">
            <div id="resume" class="p-7 sm:p-8 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 rounded-2xl shadow-sm">
              <div class="flex items-start gap-4 mb-5">
                <span class="w-10 h-10 rounded-xl bg-wood-accent text-white flex items-center justify-center shadow-sm shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                </span>
                <div class="min-w-0 flex-1">
                  <h2 class="font-display text-lg font-bold text-gray-900 dark:text-white">Official Resume</h2>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">View online or grab a PDF — same file, your choice.</p>
                  <p class="mt-2 inline-flex flex-wrap gap-1.5 text-xs">
                    <span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 font-medium text-gray-600 dark:text-gray-300">PDF</span>
                    <span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 font-medium text-gray-600 dark:text-gray-300">Updated 2025</span>
                    <span class="px-2 py-1 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200/50 dark:border-emerald-500/20 font-semibold text-emerald-700 dark:text-emerald-300">Hiring-ready</span>
                  </p>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-3">
                <a
                  href="/quick-portfolio/assets/Jun-Alvior.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex items-center justify-center gap-2 px-5 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg shadow-wood-accent/20 hover:shadow-xl hover:-translate-y-0.5 transition-all text-sm flex-1"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                  View Resume
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                </a>
                <a
                  href="/quick-portfolio/assets/Jun-Alvior.pdf"
                  download="Jun-Alvior.pdf"
                  id="download-resume-btn"
                  class="inline-flex items-center justify-center gap-2 px-5 py-3.5 bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 text-gray-900 dark:text-white font-semibold rounded-xl shadow-sm hover:bg-gray-50 dark:hover:bg-white/5 hover:border-gray-300 hover:-translate-y-0.5 transition-all text-sm flex-1"
                >
                  <svg class="w-5 h-5 text-wood-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                  Download PDF
                </a>
              </div>
            </div>

            <!-- Trigger -->
            <div id="form-trigger-container" class="text-center">
              <button
                id="toggle-contact-form"
                class="group w-full px-5 py-4 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-gray-900 dark:text-white hover:border-wood-accent/30 hover:shadow-md hover:-translate-y-0.5 font-bold rounded-xl transition-all shadow-sm text-sm flex items-center justify-center gap-2"
              >
                <span class="w-8 h-8 rounded-lg bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                </span>
                <span>Send a Message</span>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-wood-accent transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </button>
              <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">Opens inline — no new page</p>
            </div>

            <!-- Form -->
            <div id="contact-form-card" class="hidden opacity-0 transform translate-y-4 transition-all duration-500 ease-out">
              <div class="p-7 sm:p-8 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 rounded-2xl shadow-sm">
                <div class="flex items-center justify-between mb-6">
                  <h2 class="font-display text-lg font-bold text-gray-900 dark:text-white">Send a Message</h2>
                  <span class="text-xs px-2.5 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-gray-600 dark:text-gray-400">All fields required</span>
                </div>

                <form id="contact-form" class="space-y-5">
                  <div class="grid sm:grid-cols-2 gap-5">
                    <div>
                      <label for="contact-name" class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest mb-2">Name</label>
                      <input type="text" id="contact-name" name="name" required maxlength="100" placeholder="Juan Dela Cruz" class="w-full px-4 py-3 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:border-wood-accent focus:ring-2 focus:ring-wood-accent/20 transition-all" />
                      <p id="name-error" class="hidden text-xs text-red-500 mt-1"></p>
                    </div>
                    <div>
                      <label for="contact-email" class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest mb-2">Email</label>
                      <input type="email" id="contact-email" name="email" required placeholder="juan@company.com" class="w-full px-4 py-3 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:border-wood-accent focus:ring-2 focus:ring-wood-accent/20 transition-all" />
                      <p id="email-error" class="hidden text-xs text-red-500 mt-1"></p>
                    </div>
                  </div>

                  <div>
                    <label for="contact-type" class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest mb-2">Type of Inquiry</label>
                    <select id="contact-type" name="type" class="w-full px-4 py-3 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm text-gray-900 dark:text-white focus:outline-none focus:border-wood-accent focus:ring-2 focus:ring-wood-accent/20 transition-all">
                      <option value="Full-time / team role">Full-time / team role</option>
                      <option value="Freelance / contract work">Freelance / contract work</option>
                      <option value="Project / consultation">Project / consultation</option>
                      <option value="Other">Other</option>
                    </select>
                  </div>

                  <div>
                    <label for="contact-subject" class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest mb-2">Subject</label>
                    <input type="text" id="contact-subject" name="subject" required maxlength="200" placeholder="Job Inquiry / Project Opportunity" class="w-full px-4 py-3 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:border-wood-accent focus:ring-2 focus:ring-wood-accent/20 transition-all" />
                    <p id="subject-error" class="hidden text-xs text-red-500 mt-1"></p>
                  </div>

                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <label for="contact-message" class="block text-xs font-bold text-gray-700 dark:text-gray-300 uppercase tracking-widest">Message</label>
                      <span id="message-count" class="text-xs text-gray-500 dark:text-gray-400">0 / 2000</span>
                    </div>
                    <textarea id="contact-message" name="message" required rows="5" maxlength="2000" placeholder="Tell me about the role, timeline, or the workflow you want to simplify..." class="w-full px-4 py-3 bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-white/10 rounded-xl text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:border-wood-accent focus:ring-2 focus:ring-wood-accent/20 transition-all resize-none"></textarea>
                    <p id="message-error" class="hidden text-xs text-red-500 mt-1"></p>
                  </div>

                  <div class="pt-1">
                    <button type="submit" id="submit-contact" class="group w-full px-5 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg shadow-wood-accent/20 hover:shadow-xl hover:-translate-y-0.5 transition-all text-sm flex items-center justify-center gap-2">
                      <span>Send Message</span>
                      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                    </button>
                    <p class="mt-2 text-center text-xs text-gray-500 dark:text-gray-400">Opens your email app — no data stored on site.</p>
                  </div>
                </form>

                <div id="contact-success-toast" class="hidden mt-6 p-4 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 rounded-xl text-sm text-emerald-800 dark:text-emerald-300 flex items-start gap-3">
                  <svg class="w-5 h-5 text-emerald-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <div>
                    <h4 class="font-bold">Check your email app</h4>
                    <p class="mt-1 text-xs text-emerald-700 dark:text-emerald-400">
                      Draft ready with your message. If it didn't open, email <a href="mailto:junalvior.dev@gmail.com" class="underline decoration-emerald-500/30 hover:decoration-emerald-500">junalvior.dev@gmail.com</a> directly.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../../scripts/contact-form.js';
</script>

<script is:inline>
  // Copy buttons
  document.querySelectorAll('.copy-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var text = btn.getAttribute('data-copy') || '';
      if (!text) return;
      navigator.clipboard.writeText(text).then(function(){
        var orig = btn.innerHTML;
        btn.innerHTML = '<svg class="w-4 h-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>';
        setTimeout(function(){ btn.innerHTML = orig; }, 1400);
      });
    });
  });
  // Char count
  var msg = document.getElementById('contact-message');
  var cnt = document.getElementById('message-count');
  if (msg && cnt) {
    msg.addEventListener('input', function(){ cnt.textContent = msg.value.length + ' / 2000'; });
  }
</script>
