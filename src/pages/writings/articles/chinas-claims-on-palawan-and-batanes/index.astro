---
import Layout from '../../../../layouts/Layout.astro';
import { Content } from '../../../../../raw-writings/chinas-claims-on-palawan-and-batanes.md';

const title = "China's Claims on Palawan and Batanes: Philippine Position | Jun Alvior";
const description = 'A legal and historical analysis of China\'s territorial claims on Palawan and Batanes, and why the Philippine position is stronger under international law.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <article class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow relative overflow-hidden">
        <div class="absolute inset-0 -z-10 bg-grid-wood opacity-[0.32] [mask-image:radial-gradient(ellipse_70%_45%_at_50%_0%,black_60%,transparent_110%)] pointer-events-none"></div>
        <div class="absolute -top-24 -left-24 w-[520px] h-[520px] bg-wood-300/8 dark:bg-wood-400/5 rounded-full blur-[90px] pointer-events-none hidden md:block"></div>
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- Breadcrumb -->
          <div class="mb-8 text-sm text-gray-700 dark:text-gray-300">
            <a
              href="/quick-portfolio/writings/"
              class="hover:text-wood-accent transition-colors flex items-center gap-1 font-medium"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
              Back to Writings
            </a>
          </div>

          <!-- Header -->
          <header class="mb-12" data-aos="fade-up">
            <div class="mb-8 rounded-xl overflow-hidden shadow-lg border border-gray-100 dark:border-white/10">
              <img
                src="/quick-portfolio/assets/China%27s%20Claims%20on%20Palawan%20and%20Batanes.png"
                alt="China's Claims on Palawan and Batanes"
                class="w-full h-auto object-cover max-h-[500px] hover:scale-101 transition-transform duration-700"
                loading="lazy"
                decoding="async"
                width="800"
                height="450"
              />
            </div>
            <h1
              class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4"
            >
              China's Claims on Palawan and Batanes: Bakit Mas Malakas ang Philippine Position Base sa International Law
            </h1>
            <div
              class="flex items-center text-sm text-gray-500 dark:text-gray-300 space-x-4"
            >
              <span>Jul 10, 2026</span>
              <span>&bull;</span>
              <span>By Jun Alvior</span>
              <span>&bull;</span>
              <span>Geopolitics & International Law</span>
            </div>
          </header>

          <div
            class="prose dark:prose-invert prose-lg prose-wood max-w-none text-gray-700 dark:text-gray-300 leading-relaxed markdown-content"
            data-aos="fade-up"
          >
            <Content />
          </div>
        </div>
      </article>
    </main>
</Layout>
