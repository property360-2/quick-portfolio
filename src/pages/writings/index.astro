                    3D Graphics
                  </span>
                  <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200"
                  >
                    Portfolio Showcase
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Articles Content Block (Shifted to hidden by default) -->
          <div
            id="articles"
            class="tab-content hidden animate-fade-in space-y-8"
          >
            <!-- Article: Bayanihan Scaffolding Plan -->
