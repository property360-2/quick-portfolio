---
import Layout from '../../layouts/Layout.astro';
const title = 'Writings & Tutorials | Jun Alvior | Full Stack Software Developer';
const description = 'Read articles on web development, accessibility, and tech analysis by Jun Alvior. Full Stack Software Developer sharing insights on Python, React, and modern web standards.';
---

<Layout title={title} description={description}>
<main id="main-content" class="flex-grow flex flex-col">
      <!-- ORGANISMS: Writings -->
      <section id="writings" class="py-24 bg-white dark:bg-[#1f1f1f] flex-grow">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div
            class="flex flex-col md:flex-row justify-between items-end mb-12 border-b border-gray-200 dark:border-gray-700 pb-4"
          >
            <div data-aos="fade-right">
              <h2
                class="text-sm font-bold tracking-widest text-wood-accent uppercase"
              >
                Writings
              </h2>
              <h3
                class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
              >
                Thoughts & Tutorials
              </h3>
            </div>

            <!-- MOLECULES: Tabs -->
            <div class="flex space-x-1 mt-6 md:mt-0" data-aos="fade-left">
              <button
                class="tab-btn active px-6 py-2 rounded-t-lg text-sm font-medium transition-colors border-b-2 border-wood-accent text-wood-accent text-wood-accent"
                data-target="articles"
              >
                Articles
              </button>
              <button
                class="tab-btn px-6 py-2 rounded-t-lg text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors border-b-2 border-transparent"
                data-target="blogs"
              >
                Blogs
              </button>
            </div>
          </div>

          <div
            id="articles"
            class="tab-content block animate-fade-in space-y-8"
          >
            <!-- New Article -->
            <div
              class="flex flex-col md:flex-row gap-6 items-start"
              data-aos="fade-up"
            >
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >Mar 20, 2026</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a
                    href="articles/exceptional-human-performance/"
                    class="hover:text-wood-accent"
                    >The Science of Exceptional Human Performance: A Comprehensive Guide to Optimization</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  An exhaustive analysis of fourteen core domains of human performance, detailing biological mechanisms and evidence-based protocols for optimization.
                </p>
                <div class="mt-4 flex gap-2">
                  <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200"
                  >
                    Performance Science
                  </span>
                </div>
              </div>
            </div>

            <!-- Article 1 -->
            <div
              class="flex flex-col md:flex-row gap-6 items-start"
              data-aos="fade-up"
            >
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >Mar 05, 2026</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a
                    href="articles/freelance-developer-pricing-guide/"
                    class="hover:text-wood-accent"
                    >Freelance Software Development Pricing in the Philippines:
                    2026 Stack-Specific Market Dynamics</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  A comprehensive analysis of freelance software development
                  pricing in the Philippines for 2026, covering market dynamics,
                  tech stacks (Python, JavaScript, PHP), databases, and total
                  cost of ownership.
                </p>
                <div class="mt-4 flex gap-2">
                  <span
                    class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200"
                  >
                    Tech & Engineering
                  </span>
                </div>
              </div>
            </div>

            <!-- Article 2 -->
            <div
              class="flex flex-col md:flex-row gap-6 items-start"
              data-aos="fade-up"
            >
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >Feb 21, 2026</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a
                    href="articles/legal-kit-ni-juan/"
                    class="hover:text-wood-accent"
                    >Book Report: The Democratization of Philippine
                    Jurisprudence (Legal Kit ni Juan)</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  An exhaustive analysis of the democratization of Philippine
                  jurisprudence through Atty. Christian D. Sorongon's seminal
                  work.
                </p>
              </div>
            </div>
            <!-- Article 2 -->
            <div
              class="flex flex-col md:flex-row gap-6 items-start"
              data-aos="fade-up"
              data-aos-delay="50"
            >
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >Feb 12, 2026</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a
                    href="articles/sovereign-imperatives/"
                    class="hover:text-wood-accent"
                    >Sovereign Imperatives: The Kalayaan Island Group & WPS</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  A comprehensive analysis of the legal, historical, and
                  geopolitical foundations establishing Philippine sovereignty
                  over the Kalayaan Island Group.
                </p>
              </div>
            </div>
            <!-- Article 3 -->
            <div
              class="flex flex-col md:flex-row gap-6 items-start"
              data-aos="fade-up"
              data-aos-delay="100"
            >
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >Feb 11, 2026</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a
                    href="articles/accessibility-semantic-html-aria/"
                    class="hover:text-wood-accent"
                    >Accessibility First: Semantic HTML and ARIA</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  Why semantic HTML is the bedrock of a usable web and how to
                  implement ARIA roles correctly.
                </p>
              </div>
            </div>
            <!-- Article 4 -->
            <div
              class="flex flex-col md:flex-row gap-6 items-start"
              data-aos="fade-up"
              data-aos-delay="150"
            >
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >Feb 06, 2026</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a
                    href="articles/how-to-read-people/"
                    class="hover:text-wood-accent"
                    >Book Report: How to Read People Like a Book</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  A deep dive into understanding human behavior, motivation, and
                  non-verbal communication.
                </p>
              </div>
            </div>
          </div>

          <div id="blogs" class="tab-content hidden animate-fade-in space-y-8">
            <!-- Blog: Solar System Showcase -->
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >May 14, 2026</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a href="/quick-portfolio/portfolio/solar-system-showcase/index.html" class="hover:text-wood-accent"
                    >The Solar System</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  Exploring the intersection of educational technology and interactive 3D graphics in my latest portfolio project.
                </p>
              </div>
            </div>

            <!-- Blog 1 -->
            <div class="flex flex-col md:flex-row gap-6 items-start">
              <div class="w-full md:w-1/4">
                <span class="text-sm text-gray-400 font-mono"
                  >Aug 15, 2023</span
                >
              </div>
              <div
                class="w-full md:w-3/4 hover:translate-x-2 transition-transform duration-300"
              >
                <h4
                  class="text-xl font-bold text-gray-900 dark:text-white mb-2"
                >
                  <a href="#" class="hover:text-wood-accent"
                    >My Journey into Tech</a
                  >
                </h4>
                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                  Reflecting on 5 years of software engineering and lessons
                  learned along the way.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ORGANISMS: Footer -->
    </main>
</Layout>
