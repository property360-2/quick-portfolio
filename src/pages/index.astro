---
/**
 * Home Page / Hero Section Component
 * Purpose: Serves as the high-impact landing page showcasing Jun Alvior's core value proposition,
 * premium interactive aesthetics, and primary navigation calls-to-action.
 * Contains: Catchy headline messaging, customizable CTA buttons, dynamic ambient glowing lighting effects,
 * and a highly sophisticated interactive premium SVG cybernetic/anime cat visualization responsive to user input.
 * System Role: The root entry point of the application designed to wow visitors with performance, beauty, and smooth client-side interactions.
 */
import Layout from '../layouts/Layout.astro';
const title = 'Jun Alvior | High-Performance Web Apps & Automated Workflows';
const description = 'I build high-performance web applications and automated workflows that help startups scale faster. Specialized in React, Django, and Supabase.';
---

<Layout title={title} description={description}>
      <!-- SECTION 1: The Premium Hero Section -->
      <section
        id="home"
        class="flex-grow flex items-center relative overflow-hidden pt-20"
      >
        <!-- Ambient Glows -->
        <div
          class="absolute top-0 left-1/4 w-96 h-96 bg-wood-300/20 dark:bg-wood-400/10 rounded-full mix-blend-multiply dark:mix-blend-lighten filter blur-[100px] opacity-70 animate-pulse hidden md:block"
        ></div>
        <div
          class="absolute bottom-0 right-1/4 w-96 h-96 bg-wood-accent/20 dark:bg-wood-accent/10 rounded-full mix-blend-multiply dark:mix-blend-lighten filter blur-[100px] opacity-70 animate-pulse hidden md:block"
          style="animation-delay: 2s"
        ></div>

        <!-- Background Elements -->
        <div
          class="absolute top-0 right-0 w-1/3 h-full bg-wood-50 dark:bg-gray-800/20 -z-10 skew-x-12 transform origin-top-right hidden lg:block"
        ></div>

        <div
          class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20 lg:py-16 relative z-10"
        >
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
            <div class="hero-content space-y-8 text-center lg:text-left">
              <div class="space-y-4">
                <h2
                  class="text-wood-accent font-bold tracking-wider uppercase text-xs sm:text-sm gs-reveal"
                >
                  Full Stack Software Engineer & Automation Architect
                </h2>
                <h1
                  class="text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-white leading-tight gs-reveal"
                >
                  Stop fighting slow software and manual workflow chaos. I build <span class="text-wood-accent">high-velocity</span> web apps and self-healing automations that scale startups.
                </h1>
                <p
                  class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-xl mx-auto lg:mx-0 leading-relaxed gs-reveal"
                >
                  Specializing in React frontends, scalable Django backends, and real-time Supabase infrastructures. You get production-ready, international-grade code that solves your exact operational bottlenecks—fast.
                </p>
              </div>

              <!-- ATOMS: Primary CTA Button -->
              <div
                class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start gs-reveal"
              >
                <a
                  href="/quick-portfolio/rate/"
                  aria-label="Book a Free 15-Minute Strategy Call with Jun Alvior"
                  class="inline-flex items-center justify-center px-8 py-4 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg hover:shadow-wood-accent/40 hover:shadow-2xl transition-all transform hover:-translate-y-1 focus:ring-2 focus:ring-wood-accent focus:ring-offset-2 dark:focus:ring-offset-[#1a1a1a] focus:outline-none w-full sm:w-auto"
                >
                  Book a Free 15-Minute Strategy Call
                </a>
              </div>
            </div>

            <!-- Mock IDE Code Editor Visual -->
            <div class="hero-visual relative hidden md:block gs-reveal-img h-[480px]">
              <!-- Ambient Pulsing Glow behind IDE -->
              <div class="absolute -inset-4 bg-wood-accent/10 dark:bg-wood-accent/5 rounded-3xl blur-2xl opacity-70 animate-pulse"></div>
              
              <!-- VS Code Box Container -->
              <div class="relative w-full h-full bg-[#1e1e2e] dark:bg-[#11111b] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-2xl flex flex-col overflow-hidden font-mono text-sm leading-relaxed transition-colors duration-300">
                <!-- Window Command Top Bar -->
                <div class="flex items-center justify-between px-4 py-3 bg-[#181825] dark:bg-[#0b0b11] border-b border-gray-200/10">
                  <!-- macOS Style Window Control Buttons -->
                  <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-[#ff5f56] block"></span>
                    <span class="w-3 h-3 rounded-full bg-[#ffbd2e] block"></span>
                    <span class="w-3 h-3 rounded-full bg-[#27c93f] block"></span>
                  </div>
                  
                  <!-- Tab title and stack label -->
                  <div class="flex items-center gap-2 bg-[#1e1e2e] dark:bg-[#11111b] px-4 py-1.5 border-x border-t border-gray-200/10 rounded-t-lg text-xs text-gray-400 mt-2 -mb-3 relative z-10">
                    <span class="text-wood-accent font-bold">TS</span>
                    <span class="font-medium text-gray-300 dark:text-gray-400">AutomationPipeline.tsx</span>
                  </div>
                  
                  <!-- Status Dots -->
                  <div class="w-4 h-4 rounded-full bg-wood-accent/20 flex items-center justify-center">
                    <span class="w-1.5 h-1.5 rounded-full bg-wood-accent animate-ping"></span>
                  </div>
                </div>
                
                <!-- Editor Body Content -->
                <div class="flex flex-grow p-5 overflow-auto">
                  <!-- Code Lines Numbers Panel (VS Code style) -->
                  <div class="flex flex-col text-right pr-4 text-gray-500 border-r border-gray-200/10 mr-4 select-none text-xs leading-6">
                    <span>1</span>
                    <span>2</span>
                    <span>3</span>
                    <span>4</span>
                    <span>5</span>
                    <span>6</span>
                    <span>7</span>
                    <span>8</span>
                    <span>9</span>
                    <span>10</span>
                    <span>11</span>
                    <span>12</span>
                    <span>13</span>
                    <span>14</span>
                    <span>15</span>
                  </div>
                  
                  <!-- Syntax Highlighted Code Segment -->
                  <div class="flex-grow text-left text-xs leading-6 overflow-x-auto select-all text-gray-300">
                    <span class="text-purple-400">import</span> &#123; <span class="text-blue-400">useState</span> &#125; <span class="text-purple-400">from</span> <span class="text-emerald-400">'react'</span>;
                    <br />
                    <span class="text-purple-400">import</span> &#123; <span class="text-blue-400">djangoAPI</span> &#125; <span class="text-purple-400">from</span> <span class="text-emerald-400">'@services/django'</span>;
                    <br />
                    <br />
                    <span class="text-purple-400">export function</span> <span class="text-yellow-300">WorkflowAutomation</span>(&#123; <span class="text-orange-400">startupId</span> &#125;) &#123;
                    <br />
                    &nbsp;&nbsp;<span class="text-purple-400">const</span> [status, setStatus] = <span class="text-yellow-300">useState</span>(<span class="text-emerald-400">'idle'</span>);
                    <br />
                    &nbsp;&nbsp;<span class="text-purple-400">const</span> [savings, setSavings] = <span class="text-yellow-300">useState</span>(<span class="text-orange-400">0</span>);
                    <br />
                    <br />
                    &nbsp;&nbsp;<span class="text-purple-400">const</span> <span class="text-yellow-300">optimize</span> = <span class="text-purple-400">async</span> () =&gt; &#123;
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-yellow-300">setStatus</span>(<span class="text-emerald-400">'optimizing'</span>);
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;<span class="text-purple-400">try</span> &#123;
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-purple-400">const</span> res = <span class="text-purple-400">await</span> <span class="text-blue-400">djangoAPI</span>.<span class="text-yellow-300">post</span>(<span class="text-emerald-400">`/scale/$&#123;startupId&#125;/`</span>);
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-yellow-300">setSavings</span>(res.<span class="text-blue-400">data</span>.<span class="text-orange-400">hourly_usd_saved</span>);
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-yellow-300">setStatus</span>(<span class="text-emerald-400">'success'</span>);
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&#125; <span class="text-purple-400">catch</span> (err) &#123;
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-blue-400">console</span>.<span class="text-yellow-300">error</span>(<span class="text-emerald-400">"Workflow failed"</span>, err);
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-yellow-300">setStatus</span>(<span class="text-emerald-400">'failed'</span>);
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&#125;
                    <br />
                    &nbsp;&nbsp;&#125;;
                    <br />
                    <br />
                    &nbsp;&nbsp;<span class="text-purple-400">return</span> (
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&lt;<span class="text-blue-400">button</span> <span class="text-purple-400">onClick</span>=&#123;optimize&#125;&gt;
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&#123;status === <span class="text-emerald-400">'success'</span> ? <span class="text-emerald-400">`Saved $&#123;savings&#125;/hr`</span> : <span class="text-emerald-400">'Scale System'</span>&#125;
                    <br />
                    &nbsp;&nbsp;&nbsp;&nbsp;&lt;/<span class="text-blue-400">button</span>&gt;
                    <br />
                    &nbsp;&nbsp;);
                    <br />
                    &#125;
                  </div>
                </div>
                
                <!-- Bottom Status Bar (VS Code style) -->
                <div class="h-6 bg-wood-accent flex items-center justify-between px-4 text-[10px] text-white font-medium select-none">
                  <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.933 12.8a1 1 0 000-1.6L6.6 7.2A1 1 0 005 8v8a1 1 0 001.6.8l5.333-4zM19.933 12.8a1 1 0 000-1.6l-5.33-4A1 1 0 0013 8v8a1 1 0 001.6.8l5.333-4z"/>
                      </svg>
                      Main
                    </span>
                    <span>LF</span>
                    <span>UTF-8</span>
                  </div>
                  <div>TypeScript JSX</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 2: Proof & Authority Grid -->
      <section class="py-10 bg-grey-light dark:bg-[#1a1a1a] border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <p class="text-center text-xs font-semibold tracking-wider text-gray-400 dark:text-gray-500 uppercase mb-6">
            Trusted Tech Stack & Engineering Foundations
          </p>
          <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-60 dark:opacity-40 grayscale hover:grayscale-0 transition-all duration-500">
            <!-- React Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#61DAFB]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <ellipse rx="10" ry="4.5" transform="rotate(0)"></ellipse>
                <ellipse rx="10" ry="4.5" transform="rotate(60)"></ellipse>
                <ellipse rx="10" ry="4.5" transform="rotate(120)"></ellipse>
                <circle r="2" fill="currentColor"></circle>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">React</span>
            </div>
            <!-- Python Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#3776AB]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.25.18a3.54 3.54 0 0 0-2.28.65l-.94.66a2.1 2.1 0 0 0-.8 1.62v1.65h5V6.3h-7a4.13 4.13 0 0 0-4.13 4.13v3a4.13 4.13 0 0 0 4.13 4.13h1.38v-2.07a2.07 2.07 0 0 1 2.07-2.07h5.52a2.07 2.07 0 0 0 2.07-2.07V6a5.79 5.79 0 0 0-5.79-5.79zm-7 24a3.54 3.54 0 0 0 2.28-.65l.94-.66a2.1 2.1 0 0 0 .8-1.62v-1.65h-5v-1.53h7A4.13 4.13 0 0 0 17.4 13.6v-3a4.13 4.13 0 0 0-4.13-4.13h-1.38v2.07a2.07 2.07 0 0 1 2.07 2.07H4.3a2.07 2.07 0 0 0-2.07 2.07V18A5.79 5.79 0 0 0 8 23.82z"/>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">Python</span>
            </div>
            <!-- Django Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#092E20]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"></path>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">Django</span>
            </div>
            <!-- Supabase Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#3ECF8E]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.4 11.6l-8.3-9.5C12.7 1.6 12 2 12 2.7v7.3H3.6c-.9 0-1.3.9-.7 1.5l8.3 9.5c.4.5 1.1.1 1.1-.6v-7.3h8.4c.9 0 1.3-.9.7-1.5z"/>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">Supabase</span>
            </div>
            <!-- PostgreSQL Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#336791]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 4.02 2 6.5v11c0 2.48 4.48 4.5 10 4.5s10-2.02 10-4.5v-11C22 4.02 17.52 2 12 2zm0 3c4.97 0 8 1.54 8 2s-3.03 2-8 2-8-1.54-8-2 3.03-2 8-2zm0 14c-4.97 0-8-1.54-8-2v-2.5c1.86 1.05 4.79 1.5 8 1.5s6.14-.45 8-1.5V17c0 .46-3.03 2-8 2zm0-5c-4.97 0-8-1.54-8-2v-2.5c1.86 1.05 4.79 1.5 8 1.5s6.14-.45 8-1.5V12c0 .46-3.03 2-8 2z"></path>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">PostgreSQL</span>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 3: How I Can Help Your Business (Solutions Grid) -->
      <section
        id="services"
        class="py-24 bg-white dark:bg-[#1f1f1f] border-t border-gray-100 dark:border-gray-800"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2
              class="text-sm font-bold tracking-widest text-wood-accent uppercase"
            >
              Tailored Solutions
            </h2>
            <h3
              class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
            >
              How I Can Help Your Business
            </h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <!-- MVP Development -->
            <div
              class="flex flex-col p-8 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm hover:border-wood-accent/40 hover:shadow-2xl hover:shadow-wood-accent/5 transition-all duration-300 transform hover:-translate-y-1 group"
            >
              <div
                class="w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors duration-300 mb-6"
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-1">
                Rapid Product & MVP Development
              </h4>
              <p class="text-xs font-semibold text-wood-accent mb-3 italic">
                Pain Fixed: Stalled engineering & missing market opportunities.
              </p>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                Get your complex web application or AI SaaS from raw concept to active users in weeks, not months. I construct responsive, highly secure React + Supabase MVPs pre-optimized for early traction and investor reviews.
              </p>
              <div class="mt-auto pt-2">
                <a href="/quick-portfolio/portfolio/documind-ai/" class="text-xs font-bold text-wood-accent group-hover:text-wood-500 transition-colors flex items-center gap-1">
                  View Proof Case: DocuMind AI &rarr;
                </a>
              </div>
            </div>

            <!-- Operation Automation -->
            <div
              class="flex flex-col p-8 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm hover:border-wood-accent/40 hover:shadow-2xl hover:shadow-wood-accent/5 transition-all duration-300 transform hover:-translate-y-1 group"
            >
              <div
                class="w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors duration-300 mb-6"
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-1">
                Operation Automation & Workflows
              </h4>
              <p class="text-xs font-semibold text-wood-accent mb-3 italic">
                Pain Fixed: Drowning in manual spreadsheets and admin tracking.
              </p>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                I replace manual, error-prone data entries, tracking sheets, and notification tasks with self-healing API integrations. Keeping your operations running at 10x speed with 0% administrative drag.
              </p>
              <div class="mt-auto pt-2">
                <a href="/quick-portfolio/portfolio/automation-pick-up-service/" class="text-xs font-bold text-wood-accent group-hover:text-wood-500 transition-colors flex items-center gap-1">
                  View Proof Case: Automation Pick-up &rarr;
                </a>
              </div>
            </div>

            <!-- Backend Optimization -->
            <div
              class="flex flex-col p-8 bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 shadow-sm hover:border-wood-accent/40 hover:shadow-2xl hover:shadow-wood-accent/5 transition-all duration-300 transform hover:-translate-y-1 group"
            >
              <div
                class="w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors duration-300 mb-6"
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.58 4 8 4s8-1.79 8-4M4 7c0-2.21 3.58-4 8-4s8 1.79 8 4m0 5c0 2.21-3.58 4-8 4s-8-1.79-8-4" />
                </svg>
              </div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-1">
                API & Scalable Backend Architecture
              </h4>
              <p class="text-xs font-semibold text-wood-accent mb-3 italic">
                Pain Fixed: Slow response times, database bottlenecks & leaks.
              </p>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                I audit, secure, and accelerate sluggish legacy backends. By designing scalable Django pipelines and highly optimized PostgreSQL databases, your web platform stays snappy, secure, and cost-efficient.
              </p>
              <div class="mt-auto pt-2">
                <a href="/quick-portfolio/portfolio/gym-project/" class="text-xs font-bold text-wood-accent group-hover:text-wood-500 transition-colors flex items-center gap-1">
                  View Proof Case: Gym Management Portal &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4: The Ultimate Call-To-Action (CTA) Footer -->
      <section
        id="cta"
        class="py-24 bg-white dark:bg-[#1f1f1f] relative overflow-hidden"
      >
        <!-- Subtle Background Glows -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-wood-accent/10 dark:bg-wood-accent/5 rounded-full filter blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-wood-accent/10 dark:bg-wood-accent/5 rounded-full filter blur-3xl pointer-events-none"></div>

        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-3xl p-12 md:p-16 text-center shadow-2xl relative overflow-hidden group">
            <!-- Pulsing soft glow inside card -->
            <div class="absolute inset-0 bg-gradient-to-r from-wood-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
            
            <h2 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-6 leading-tight max-w-3xl mx-auto relative z-10">
              Looking for a reliable developer for your next project? Let’s talk.
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed relative z-10">
              Let's discuss how we can build high-performance web applications, scale your database infrastructure, or automate business workflows to solve your critical bottlenecks.
            </p>
            <div class="flex justify-center relative z-10">
              <a
                href="/quick-portfolio/rate/"
                class="inline-flex items-center px-10 py-5 bg-wood-accent hover:bg-wood-500 text-white text-lg font-bold rounded-2xl shadow-xl hover:shadow-wood-accent/40 shadow-wood-accent/10 transition-all transform hover:-translate-y-1 focus:ring-2 focus:ring-wood-accent focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-800 focus:outline-none"
              >
                <svg class="w-6 h-6 mr-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" />
                </svg>
