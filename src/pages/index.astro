---
/**
 * Home Page / Hero Section Component
 * Purpose: Serves as the high-impact landing page showcasing Jun Alvior's core value proposition,
 * premium interactive aesthetics, and primary navigation calls-to-action.
 * Contains: Catchy headline messaging, customizable CTA buttons, dynamic ambient glowing lighting effects,
 * and a highly sophisticated interactive premium SVG cybernetic/anime cat visualization responsive to user input.
 * System Role: The root entry point of the application designed to wow visitors with performance, beauty, and smooth client-side interactions.
 */
import Layout from '../layouts/Layout.astro';
const title = 'Jun Alvior | Custom Software & Operational Automation Architect';
const description = 'Ditch the spreadsheet and manual workflow chaos. Scale your operations with custom software and automated workflows.';
---

<Layout title={title} description={description}>
      <!-- SECTION 1: The Premium Hero Section -->
      <section
        id="home"
        class="flex-grow flex items-center relative overflow-hidden pt-20"
      >
        <!-- Ambient Glows -->
        <div
          class="absolute top-0 left-1/4 w-96 h-96 bg-wood-300/20 dark:bg-wood-400/10 rounded-full mix-blend-multiply dark:mix-blend-lighten filter blur-[100px] opacity-70 animate-pulse hidden md:block"
        ></div>
        <div
          class="absolute bottom-0 right-1/4 w-96 h-96 bg-wood-accent/20 dark:bg-wood-accent/10 rounded-full mix-blend-multiply dark:mix-blend-lighten filter blur-[100px] opacity-70 animate-pulse hidden md:block"
          style="animation-delay: 2s"
        ></div>

        <!-- Background Elements -->
        <div
          class="absolute top-0 right-0 w-1/3 h-full bg-wood-50 dark:bg-gray-800/20 -z-10 skew-x-12 transform origin-top-right hidden lg:block"
        ></div>

        <div
          class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20 lg:py-16 relative z-10"
        >
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
            <div class="hero-content space-y-8 text-center lg:text-left">
              <div class="space-y-4">
                <h2
                  class="text-wood-accent font-bold tracking-wider uppercase text-xs sm:text-sm gs-reveal"
                >
                  Full Stack Software Engineer & Automation Architect
                </h2>
                <h1
                  class="text-4xl lg:text-5xl font-extrabold text-gray-900 dark:text-white leading-tight gs-reveal"
                >
                  Ditch the spreadsheet and manual workflow chaos. Scale your operations with <span class="text-wood-accent">custom software</span>.
                </h1>
                <p
                  class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-xl mx-auto lg:mx-0 leading-relaxed gs-reveal"
                >
                  I build high-velocity frontends, robust backends, and smart AI automations. Get production-ready engineering designed to eliminate your operational bottlenecks—fast.
                </p>
              </div>

              <!-- ATOMS: Primary CTA Button -->
              <div
                class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start gs-reveal"
              >
                <a
                  href="/quick-portfolio/rate/"
                  aria-label="Book a Free 15-Minute Strategy Call with Jun Alvior"
                  class="inline-flex items-center justify-center px-8 py-4 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg hover:shadow-wood-accent/40 hover:shadow-2xl transition-all transform hover:-translate-y-1 focus:ring-2 focus:ring-wood-accent focus:ring-offset-2 dark:focus:ring-offset-[#1a1a1a] focus:outline-none w-full sm:w-auto"
                >
                  Book a Free 15-Minute Strategy Call
                </a>
              </div>
            </div>

            <!-- Operations Control Center (GUI B2B Dashboard Demo) -->
            <div class="hero-visual relative hidden md:block gs-reveal-img h-[480px]">
              <!-- Ambient Glowing Aura -->
              <div class="absolute -inset-4 bg-wood-accent/15 dark:bg-wood-accent/15 rounded-3xl blur-2xl opacity-80 animate-pulse"></div>
              
              <!-- Premium Dashboard Window Container -->
              <div class="relative w-full h-full bg-white dark:bg-[#1e1e21] border border-gray-200 dark:border-gray-800 rounded-2xl shadow-2xl flex flex-col overflow-hidden font-sans text-sm leading-relaxed transition-colors duration-300">
                <!-- Window Top Header Bar -->
                <div class="flex items-center justify-between px-5 py-3.5 bg-gray-50 dark:bg-[#252528] border-b border-gray-200 dark:border-gray-800">
                  <!-- macOS Window Control Dot Buttons -->
                  <div class="flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-[#ff5f56] block shadow shadow-red-500/20"></span>
                    <span class="w-3 h-3 rounded-full bg-[#ffbd2e] block shadow shadow-amber-500/20"></span>
                    <span class="w-3 h-3 rounded-full bg-[#27c93f] block shadow shadow-emerald-500/20"></span>
                  </div>
                  
                  <!-- Dashboard Header Title -->
                  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-gray-700 dark:text-gray-300 font-mono">
                    <svg class="w-3.5 h-3.5 text-wood-accent animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Operations Control Center</span>
                  </div>
                  
                  <!-- Pulsing Status Led -->
                  <div id="system-status-pill" class="flex items-center gap-1.5 bg-amber-500/10 border border-amber-500/20 text-[10px] font-bold text-amber-600 dark:text-amber-500 px-2 py-0.5 rounded-full select-none font-mono tracking-wide">
                    <span id="system-status-led" class="w-1.5 h-1.5 rounded-full bg-amber-500 block animate-pulse"></span>
                    <span id="system-status-txt">SYSTEM: IDLE</span>
                  </div>
                </div>
                
                <!-- Main Dashboard Panel Content -->
                <div class="flex-grow p-5 flex flex-col justify-between space-y-4">
                  <!-- 3 Column Metrics Cards Grid -->
                  <div class="grid grid-cols-3 gap-3.5">
                    <!-- Metric Card 1: Admin Tasks -->
                    <div class="relative p-3.5 bg-gray-50 dark:bg-[#1a1a1a]/80 border border-gray-200 dark:border-gray-800 rounded-xl flex flex-col justify-between overflow-hidden shadow-inner group">
                      <div class="absolute -right-6 -bottom-6 w-16 h-16 bg-amber-500/5 rounded-full filter blur-xl transition-all duration-500 group-hover:scale-150"></div>
                      <div class="text-[10px] uppercase font-bold text-gray-500 dark:text-gray-400 tracking-wider">Pending Admin Tasks</div>
                      <div class="my-3 text-3xl font-extrabold text-amber-600 dark:text-amber-500 tracking-tight font-mono">
                        <span id="metric-tasks-val">42</span>
                      </div>
                      <div class="flex items-center gap-1.5 mt-0.5">
                        <span id="metric-tasks-badge" class="px-1.5 py-0.5 text-[9px] font-bold rounded bg-amber-500/10 border border-amber-500/20 text-amber-600 dark:text-amber-500 font-mono">Spreadsheet Chaos</span>
                      </div>
                    </div>

                    <!-- Metric Card 2: Operating Cost -->
                    <div class="relative p-3.5 bg-gray-50 dark:bg-[#1a1a1a]/80 border border-gray-200 dark:border-gray-800 rounded-xl flex flex-col justify-between overflow-hidden shadow-inner group">
                      <div class="absolute -right-6 -bottom-6 w-16 h-16 bg-rose-500/5 rounded-full filter blur-xl transition-all duration-500 group-hover:scale-150"></div>
                      <div class="text-[10px] uppercase font-bold text-gray-500 dark:text-gray-400 tracking-wider">Operating Cost</div>
                      <div class="my-3 text-3xl font-extrabold text-gray-800 dark:text-gray-100 tracking-tight font-mono">
                        $<span id="metric-cost-val">120</span><span class="text-xs text-gray-500 dark:text-gray-400 font-normal">/hr</span>
                      </div>
                      <div class="flex items-center gap-1.5 mt-0.5">
                        <span id="metric-cost-badge" class="px-1.5 py-0.5 text-[9px] font-bold rounded bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 font-mono">Unoptimized Flow</span>
                      </div>
                    </div>

                    <!-- Metric Card 3: Saved Overhead -->
                    <div class="relative p-3.5 bg-gray-50 dark:bg-[#1a1a1a]/80 border border-gray-200 dark:border-gray-800 rounded-xl flex flex-col justify-between overflow-hidden shadow-inner group">
                      <div class="absolute -right-6 -bottom-6 w-16 h-16 bg-emerald-500/5 rounded-full filter blur-xl transition-all duration-500 group-hover:scale-150"></div>
                      <div class="text-[10px] uppercase font-bold text-gray-500 dark:text-gray-400 tracking-wider">Saved Overhead</div>
                      <div class="my-3 text-3xl font-extrabold text-gray-400 dark:text-gray-500 tracking-tight font-mono transition-all duration-300" id="saved-value-container">
                        $<span id="metric-saved-val">0</span><span class="text-xs text-gray-500 dark:text-gray-400 font-normal">/hr</span>
                      </div>
                      <div class="flex items-center gap-1.5 mt-0.5" id="saved-badge-container">
                        <span id="metric-saved-badge" class="px-1.5 py-0.5 text-[9px] font-bold rounded bg-gray-200 dark:bg-gray-700 text-gray-500 dark:text-gray-400 border border-gray-300 dark:border-gray-800 font-mono font-bold">Direct ROI Demo</span>
                      </div>
                    </div>
                  </div>

                  <!-- Central Automation Trigger Interface -->
                  <div class="p-4 bg-gray-50 dark:bg-[#1a1a1a]/40 border border-gray-200 dark:border-gray-800 rounded-xl text-center space-y-3">
                    <p class="text-xs text-gray-600 dark:text-gray-400">
                      Click the trigger below to simulate a real B2B custom database & workflow automation setup:
                    </p>
                    
                    <div class="flex justify-center items-center">
                      <!-- GLOWING OPTIMIZATION TRIGGER BUTTON -->
                      <button 
                        id="dashboard-trigger-btn" 
                        class="relative flex items-center justify-center gap-2.5 px-8 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg hover:shadow-wood-accent/30 hover:shadow-2xl border border-wood-400/20 cursor-pointer select-none transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none w-full max-w-sm group"
                      >
                        <span class="absolute -inset-0.5 bg-wood-accent/20 rounded-xl blur opacity-30 group-hover:opacity-60 transition-opacity duration-300"></span>
                        <svg class="w-4 h-4 text-white relative z-10 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        <span class="relative z-10 tracking-wide">Optimize & Scale System</span>
                      </button>

                      <!-- GLOWING SUCCESS BANNER (INITIALLY HIDDEN) -->
                      <div 
                        id="dashboard-success-banner" 
                        class="hidden w-full max-w-sm p-3 bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 font-bold rounded-xl shadow-lg shadow-emerald-500/5 items-center justify-center gap-2 select-none animate-bounce"
                      >
                        <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="tracking-wide">System Fully Optimized!</span>
                      </div>
                    </div>
                  </div>

                  <!-- Collapsible Log Console Screen -->
                  <div id="ide-terminal" class="h-0 opacity-0 border border-gray-200 dark:border-gray-800 bg-slate-950 rounded-xl transition-all duration-500 ease-in-out overflow-hidden flex flex-col font-mono">
                    <div class="flex items-center justify-between px-4 py-2 bg-slate-900 border-b border-slate-800 text-[10px] text-slate-400 select-none">
                      <div class="flex items-center gap-2">
                        <span class="text-emerald-400 w-2.5 h-2.5 rounded-full animate-pulse bg-emerald-400"></span>
                        <span class="font-bold text-slate-200">Live Agent Console (python_optimizer_daemon)</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <button id="terminal-reset" class="hover:text-emerald-400 text-slate-400 transition-colors hidden text-[9px] uppercase tracking-wider font-bold cursor-pointer select-none">Reset Demo</button>
                        <span class="text-slate-700" id="reset-sep">|</span>
                        <span class="text-[9px] uppercase tracking-wider text-emerald-400 font-bold">Active</span>
                      </div>
                    </div>
                    <div id="terminal-body" class="flex-grow p-4 text-[10px] sm:text-xs text-slate-300 overflow-y-auto space-y-1.5 scrollbar-thin select-all">
                      <!-- Dynamically Staggered Console Logs Output -->
                    </div>
                  </div>
                </div>

                <!-- Bottom Status Details Bar -->
                <div class="h-7 bg-gray-50 dark:bg-[#252528] flex items-center justify-between px-4 text-[10px] text-gray-500 dark:text-gray-400 font-medium select-none border-t border-gray-200 dark:border-gray-800">
                  <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400 block animate-pulse"></span>
                      Postgres DB Status: Active
                    </span>
                    <span>API Response: 12ms</span>
                  </div>
                  <div>ROI Demo Framework v1.0</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 2: Proof & Authority Grid -->
      <section class="py-10 bg-grey-light dark:bg-[#1a1a1a] border-y border-gray-200 dark:border-gray-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <p class="text-center text-xs font-semibold tracking-wider text-gray-400 dark:text-gray-500 uppercase mb-6">
            Trusted Tech Stack & Engineering Foundations
          </p>
          <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-60 dark:opacity-40 grayscale hover:grayscale-0 transition-all duration-500">
            <!-- React Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#61DAFB]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <ellipse rx="10" ry="4.5" transform="rotate(0)"></ellipse>
                <ellipse rx="10" ry="4.5" transform="rotate(60)"></ellipse>
                <ellipse rx="10" ry="4.5" transform="rotate(120)"></ellipse>
                <circle r="2" fill="currentColor"></circle>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">React</span>
            </div>
            <!-- Python Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#3776AB]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14.25.18a3.54 3.54 0 0 0-2.28.65l-.94.66a2.1 2.1 0 0 0-.8 1.62v1.65h5V6.3h-7a4.13 4.13 0 0 0-4.13 4.13v3a4.13 4.13 0 0 0 4.13 4.13h1.38v-2.07a2.07 2.07 0 0 1 2.07-2.07h5.52a2.07 2.07 0 0 0 2.07-2.07V6a5.79 5.79 0 0 0-5.79-5.79zm-7 24a3.54 3.54 0 0 0 2.28-.65l.94-.66a2.1 2.1 0 0 0 .8-1.62v-1.65h-5v-1.53h7A4.13 4.13 0 0 0 17.4 13.6v-3a4.13 4.13 0 0 0-4.13-4.13h-1.38v2.07a2.07 2.07 0 0 1 2.07 2.07H4.3a2.07 2.07 0 0 0-2.07 2.07V18A5.79 5.79 0 0 0 8 23.82z"/>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">Python</span>
            </div>
            <!-- Django Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#092E20]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"></path>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">Django</span>
            </div>
            <!-- Supabase Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#3ECF8E]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.4 11.6l-8.3-9.5C12.7 1.6 12 2 12 2.7v7.3H3.6c-.9 0-1.3.9-.7 1.5l8.3 9.5c.4.5 1.1.1 1.1-.6v-7.3h8.4c.9 0 1.3-.9.7-1.5z"/>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">Supabase</span>
            </div>
            <!-- PostgreSQL Badge -->
            <div class="flex items-center gap-2 hover:opacity-100 transition-opacity">
              <svg class="w-5 h-5 text-[#336791]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 4.02 2 6.5v11c0 2.48 4.48 4.5 10 4.5s10-2.02 10-4.5v-11C22 4.02 17.52 2 12 2zm0 3c4.97 0 8 1.54 8 2s-3.03 2-8 2-8-1.54-8-2 3.03-2 8-2zm0 14c-4.97 0-8-1.54-8-2v-2.5c1.86 1.05 4.79 1.5 8 1.5s6.14-.45 8-1.5V17c0 .46-3.03 2-8 2zm0-5c-4.97 0-8-1.54-8-2v-2.5c1.86 1.05 4.79 1.5 8 1.5s6.14-.45 8-1.5V12c0 .46-3.03 2-8 2z"></path>
              </svg>
              <span class="font-bold text-sm text-gray-800 dark:text-gray-200 tracking-wide">PostgreSQL</span>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 3: How I Can Help Your Business (Solutions Grid) -->
      <section
        id="services"
        class="py-24 bg-white dark:bg-[#1f1f1f] border-t border-gray-100 dark:border-gray-800"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <h2
              class="text-sm font-bold tracking-widest text-wood-accent uppercase"
            >
              Tailored Solutions
            </h2>
            <h3
              class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl"
            >
              How I Can Help Your Business
            </h3>
          </div>

          <!--
            COMPONENT: Services Solutions Grid
            PURPOSE: Renders a three-column grid highlighting Jun Alvior's key business service offerings.
            REBRANDED CONTEXT: Transitioned from technical stacks to high-value business solutions (Custom Software, Workflow Automation, Tech Strategy).
            PROPS/INPUTS: None (Static Astro/HTML block).
            RETURNS/RENDERS: A responsive grid layout featuring service descriptions, exact pain points resolved, and outbound case study links.
          -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <!-- Custom Software & Internal Tools -->
            <div
              class="flex flex-col p-8 bg-white dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm hover:border-wood-accent/40 hover:shadow-2xl hover:shadow-wood-accent/5 transition-all duration-300 transform hover:-translate-y-1 group"
            >
              <div
                class="w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors duration-300 mb-6"
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-1">
                Custom Software & Internal Tools
              </h4>
              <p class="text-xs font-semibold text-wood-accent mb-3 italic">
                Pain Fixed: Drowning in manual spreadsheets and admin tracking.
              </p>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                Replace spreadsheet chaos with custom dashboards, client portals, and robust internal software. Built with modern, secure databases and intuitive interfaces tailored to your exact business operations and teams.
              </p>
              <div class="mt-auto pt-2">
                <a href="/quick-portfolio/portfolio/documind-ai/" class="text-xs font-bold text-wood-accent group-hover:text-wood-500 transition-colors flex items-center gap-1">
                  View Proof Case: DocuMind AI &rarr;
                </a>
              </div>
            </div>

            <!-- Workflow Automation & AI Integration -->
            <div
              class="flex flex-col p-8 bg-white dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm hover:border-wood-accent/40 hover:shadow-2xl hover:shadow-wood-accent/5 transition-all duration-300 transform hover:-translate-y-1 group"
            >
              <div
                class="w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors duration-300 mb-6"
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-1">
                Workflow Automation & AI Integration
              </h4>
              <p class="text-xs font-semibold text-wood-accent mb-3 italic">
                Pain Fixed: Hours wasted on repetitive data entry and manual follow-ups.
              </p>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                Connect your existing software, automate emails, sync sheets, and deploy smart AI agents to handle document parsing or client inquiries. Keep your business running 24/7 with zero administrative drag.
              </p>
              <div class="mt-auto pt-2">
                <a href="/quick-portfolio/portfolio/automation-pick-up-service/" class="text-xs font-bold text-wood-accent group-hover:text-wood-500 transition-colors flex items-center gap-1">
                  View Proof Case: Automation Pick-up &rarr;
                </a>
              </div>
            </div>

            <!-- Operations & Tech Strategy -->
            <div
              class="flex flex-col p-8 bg-white dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm hover:border-wood-accent/40 hover:shadow-2xl hover:shadow-wood-accent/5 transition-all duration-300 transform hover:-translate-y-1 group"
            >
              <div
                class="w-12 h-12 bg-wood-accent/10 rounded-xl flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors duration-300 mb-6"
              >
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.58 4 8 4s8-1.79 8-4M4 7c0-2.21 3.58-4 8-4s8 1.79 8 4m0 5c0 2.21-3.58 4-8 4s-8-1.79-8-4" />
                </svg>
              </div>
              <h4 class="text-xl font-bold text-gray-900 dark:text-white mb-1">
                Operations & Tech Strategy
              </h4>
              <p class="text-xs font-semibold text-wood-accent mb-3 italic">
                Pain Fixed: Unsure which tech path is right or inherited tech debt holding you back.
              </p>
              <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-4">
                I audit your current operational workflows, systems, and databases to draft a clear, ROI-focused technical roadmap. Get executive-level engineering expertise to secure, scale, and optimize your systems.
              </p>
              <div class="mt-auto pt-2">
                <a href="/quick-portfolio/portfolio/gym-project/" class="text-xs font-bold text-wood-accent group-hover:text-wood-500 transition-colors flex items-center gap-1">
                  View Proof Case: Gym Management Portal &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4: The Ultimate Call-To-Action (CTA) Footer -->
      <section
        id="cta"
        class="py-24 bg-white dark:bg-[#1f1f1f] relative overflow-hidden"
      >
        <!-- Subtle Background Glows -->
        <div class="absolute -top-24 -left-24 w-96 h-96 bg-wood-accent/10 dark:bg-wood-accent/5 rounded-full filter blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-wood-accent/10 dark:bg-wood-accent/5 rounded-full filter blur-3xl pointer-events-none"></div>

        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div class="bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-3xl p-12 md:p-16 text-center shadow-2xl relative overflow-hidden group">
            <!-- Pulsing soft glow inside card -->
            <div class="absolute inset-0 bg-gradient-to-r from-wood-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"></div>
            
            <h2 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-6 leading-tight max-w-3xl mx-auto relative z-10">
              Looking for a reliable developer for your next project? Let’s talk.
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-300 mb-10 max-w-2xl mx-auto leading-relaxed relative z-10">
              Let's discuss how we can build high-performance web applications, scale your database infrastructure, or automate business workflows to solve your critical bottlenecks.
            </p>
            <div class="flex justify-center relative z-10">
              <a
                href="/quick-portfolio/rate/"
                class="inline-flex items-center px-10 py-5 bg-wood-accent hover:bg-wood-500 text-white text-lg font-bold rounded-2xl shadow-xl hover:shadow-wood-accent/40 shadow-wood-accent/10 transition-all transform hover:-translate-y-1 focus:ring-2 focus:ring-wood-accent focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-gray-800 focus:outline-none"
              >
                <svg class="w-6 h-6 mr-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v12a2 2 0 002 2z" />
                </svg>
                Book a Free 15-Minute Strategy Call
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Dynamic Micro-Interaction Script for the Hero GUI Dashboard Optimizer Simulation -->
      <script is:inline>
        /**
         * Orchestrates the dynamic client-side dashboard ROI simulation.
         * Triggered when the user clicks 'Optimize & Scale System'.
         * Updates status indicators, count downs pending tasks, counts down operating costs,
         * counts up savings, expands the live log terminal, and writes sequential B2B operations logs.
         */
        document.addEventListener('DOMContentLoaded', () => {
          const triggerBtn = document.getElementById('dashboard-trigger-btn');
          const successBanner = document.getElementById('dashboard-success-banner');
          const terminal = document.getElementById('ide-terminal');
          const terminalBody = document.getElementById('terminal-body');
          const resetBtn = document.getElementById('terminal-reset');
          
          // Status elements
          const statusPill = document.getElementById('system-status-pill');
          const statusLed = document.getElementById('system-status-led');
          const statusTxt = document.getElementById('system-status-txt');
          
          // Metric display targets
          const tasksVal = document.getElementById('metric-tasks-val');
          const tasksBadge = document.getElementById('metric-tasks-badge');
          
          const costVal = document.getElementById('metric-cost-val');
          const costBadge = document.getElementById('metric-cost-badge');
          
          const savedVal = document.getElementById('metric-saved-val');
          const savedBadge = document.getElementById('metric-saved-badge');
          const savedValContainer = document.getElementById('saved-value-container');
          
          if (!triggerBtn || !successBanner || !terminal || !terminalBody || !resetBtn) return;

          let isRunning = false;

          // Sequential automation system steps
          const logs = [
            { text: '&gt; python automation_daemon.py --target=business_operations --verbose', color: 'text-slate-400' },
            { text: '[SYSTEM] Initializing strategic operations pipeline...', color: 'text-amber-500 font-bold' },
            { text: '[SYSTEM] POST /api/v1/optimize/demo-client/ -&gt; Django Backend [CONNECTED]', color: 'text-blue-400' },
            { text: '[CRM] Connecting to HubSpot CRM and Gmail API triggers...', color: 'text-slate-300' },
            { text: '[CRM] - Scanning outdated manual entry database rows...', color: 'text-slate-400' },
            { text: '[CRM] - Success. 42 manual spreadsheets converted into relational models.', color: 'text-emerald-400 font-medium' },
            { text: '[INTEGRATION] Staging AI Document Parser Agent for automated invoice reads...', color: 'text-slate-300' },
            { text: '[INTEGRATION] - AI agent connected. Queue response speed -&gt; 0.8s.', color: 'text-emerald-400 font-medium' },
            { text: '[DATABASE] Triggering PostgreSQL vacuum & strategic indexing optimization...', color: 'text-slate-300' },
            { text: '[DATABASE] - Query speed improved from 320ms to 12ms under full load.', color: 'text-emerald-400 font-medium' },
            { text: '[SYSTEM] INITIATING REAL-TIME FINANCIAL ROI REPORT...', color: 'text-amber-500 font-bold animate-pulse' },
            { text: '[ROI] - Active admin bottlenecks fully resolved: 42 -&gt; 0.', color: 'text-emerald-400 font-medium' },
            { text: '[ROI] - Hourly cost reduction calculated: $120/hr -&gt; $75/hr.', color: 'text-emerald-400 font-medium' },
            { text: '[SYSTEM] METRIC RESULT: Saved $45/hr in human labor overhead.', color: 'text-emerald-400 font-extrabold underline decoration-emerald-500' }
          ];

          /**
           * Animates counters smoothly over a duration using high-performance requestAnimationFrame.
           * @param {HTMLElement} element - The target element to update.
           * @param {number} start - The starting numerical value.
           * @param {number} end - The ending numerical value.
           * @param {number} duration - Animation duration in milliseconds.
           * @param {string} prefix - Optional string prefix (e.g. '$').
           * @param {string} suffix - Optional string suffix (e.g. '/hr').
           * @returns {Promise<void>}
           */
          function animateValue(element, start, end, duration, prefix = '', suffix = '') {
            return new Promise((resolve) => {
              try {
                const startTime = performance.now();
                
                function update(currentTime) {
                  try {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    
                    // EaseOutQuad smoothing
                    const ease = progress * (2 - progress);
                    const current = Math.floor(start + (end - start) * ease);
                    
                    element.innerHTML = `${prefix}${current}${suffix}`;
                    
                    if (progress < 1) {
                      requestAnimationFrame(update);
                    } else {
                      element.innerHTML = `${prefix}${end}${suffix}`;
                      resolve();
                    }
                  } catch (err) {
                    console.error("Frame update failed", err);
                    element.innerHTML = `${prefix}${end}${suffix}`;
                    resolve();
                  }
                }
                
                requestAnimationFrame(update);
              } catch (err) {
                console.error("Animate value error", err);
                element.innerHTML = `${prefix}${end}${suffix}`;
                resolve();
              }
            });
          }

          async function startSimulation() {
            try {
              if (isRunning) return;
              isRunning = true;

              // 1. Update button to loading state
              triggerBtn.innerHTML = `
                <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white inline" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Processing Optimization...
              `;
              triggerBtn.disabled = true;
              triggerBtn.classList.remove('hover:shadow-wood-accent/30', 'hover:-translate-y-0.5');
              triggerBtn.classList.add('cursor-wait', 'opacity-90');

              // Update top bar system pill to running
              statusPill.className = "flex items-center gap-1.5 bg-blue-500/10 border border-blue-500/20 text-[10px] font-bold text-blue-400 px-2 py-0.5 rounded-full select-none font-mono tracking-wide";
              statusLed.className = "w-1.5 h-1.5 rounded-full bg-blue-400 block animate-ping";
              statusTxt.innerText = "SYSTEM: OPTIMIZING";

              // 2. Open Console terminal sliding panel
              terminal.classList.remove('h-0', 'opacity-0');
              terminal.classList.add('h-44', 'opacity-100');
              terminalBody.innerHTML = '';
              resetBtn.classList.add('hidden');

              // 3. Staggered sequential execution of logs
              for (let i = 0; i < logs.length; i++) {
                // If it is the pending tasks count down point
                if (i === 5) {
                  // Begin count down for Pending Admin Tasks card (42 -> 0)
                  animateValue(tasksVal, 42, 0, 1500).then(() => {
                    try {
                      tasksVal.className = "text-emerald-400 font-extrabold";
                      tasksBadge.className = "px-1.5 py-0.5 text-[9px] font-bold rounded bg-emerald-500/15 text-emerald-400 font-mono";
                      tasksBadge.innerText = "0 Active Bottlenecks";
                    } catch (e) {
                      console.error("Card 1 success transition error", e);
                    }
                  });
                }

                // If it is the cost & saved count transition point
                if (i === 10) {
                  // Animate Card 2 and Card 3 synchronously
                  animateValue(costVal, 120, 75, 1200).then(() => {
                    try {
                      costBadge.className = "px-1.5 py-0.5 text-[9px] font-bold rounded bg-emerald-500/15 text-emerald-400 font-mono";
                      costBadge.innerText = "Target Cost Achieved";
                    } catch (e) {
                      console.error("Card 2 success transition error", e);
                    }
                  });
                  animateValue(savedVal, 0, 45, 1200).then(() => {
                    try {
                      savedValContainer.className = "my-3 text-3xl font-extrabold text-emerald-400 tracking-tight font-mono shadow-sm";
                      savedBadge.className = "px-1.5 py-0.5 text-[9px] font-bold rounded bg-emerald-500/15 text-emerald-400 font-mono animate-pulse";
                      savedBadge.innerText = "Saved $45/hr";
                    } catch (e) {
                      console.error("Card 3 success transition error", e);
                    }
                  });
                }

                await new Promise((resolve) => {
                  try {
                    setTimeout(resolve, i === 0 ? 250 : i < 3 ? 400 : i < 7 ? 600 : 800);
                  } catch (e) {
                    console.error("Simulated timeout error", e);
                    resolve();
                  }
                });

                const line = document.createElement('div');
                line.className = `leading-5 ${logs[i].color} font-mono`;
                line.innerHTML = logs[i].text;
                terminalBody.appendChild(line);
                terminalBody.scrollTop = terminalBody.scrollHeight;
              }

              // 4. Update elements to completed optimized success state
              triggerBtn.classList.add('hidden');
              successBanner.classList.remove('hidden');
              successBanner.classList.add('flex');

              statusPill.className = "flex items-center gap-1.5 bg-emerald-500/10 border border-emerald-500/20 text-[10px] font-bold text-emerald-400 px-2 py-0.5 rounded-full select-none font-mono tracking-wide";
              statusLed.className = "w-1.5 h-1.5 rounded-full bg-emerald-400 block animate-pulse";
              statusTxt.innerText = "SYSTEM: OPTIMIZED";

              resetBtn.classList.remove('hidden');
            } catch (err) {
              console.error("Dashboard optimization simulation failed", err);
            } finally {
              isRunning = false;
            }
          }

          function resetSimulation() {
            try {
              if (isRunning) return;

              // Hide success states
              successBanner.classList.add('hidden');
              successBanner.classList.remove('flex', 'animate-bounce');

              // Restore trigger button
              triggerBtn.innerHTML = `
                <svg class="w-4 h-4 text-white relative z-10 animate-pulse inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span class="relative z-10 tracking-wide">Optimize & Scale System</span>
              `;
              triggerBtn.disabled = false;
              triggerBtn.className = "relative flex items-center justify-center gap-2.5 px-8 py-3.5 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg hover:shadow-wood-accent/30 hover:shadow-2xl border border-wood-400/20 cursor-pointer select-none transition-all duration-300 transform hover:-translate-y-0.5 focus:outline-none w-full max-w-sm group";
              triggerBtn.classList.remove('hidden');

              // Reset System Status Pill
              statusPill.className = "flex items-center gap-1.5 bg-amber-500/10 border border-amber-500/20 text-[10px] font-bold text-amber-500 px-2 py-0.5 rounded-full select-none font-mono tracking-wide";
              statusLed.className = "w-1.5 h-1.5 rounded-full bg-amber-500 block animate-pulse";
              statusTxt.innerText = "SYSTEM: IDLE";

              // Reset Metric Cards to defaults
              tasksVal.innerText = "42";
              tasksVal.className = "text-amber-500";
              tasksBadge.className = "px-1.5 py-0.5 text-[9px] font-bold rounded bg-amber-500/15 text-amber-500 font-mono";
              tasksBadge.innerText = "Spreadsheet Chaos";

              costVal.innerText = "120";
              costBadge.className = "px-1.5 py-0.5 text-[9px] font-bold rounded bg-rose-500/15 text-rose-400 font-mono";
              costBadge.innerText = "Unoptimized Flow";

              savedVal.innerText = "0";
              savedValContainer.className = "my-3 text-3xl font-extrabold text-slate-500 tracking-tight font-mono transition-all duration-300";
              savedBadge.className = "px-1.5 py-0.5 text-[9px] font-bold rounded bg-slate-700/30 text-slate-500 font-mono";
              savedBadge.innerText = "Direct ROI Demo";

              // Collapse terminal logs panel
              terminal.classList.remove('h-44', 'opacity-100');
              terminal.classList.add('h-0', 'opacity-0');
              terminalBody.innerHTML = '';
              resetBtn.classList.add('hidden');
            } catch (err) {
              console.error("Dashboard reset operation failed", err);
            }
          }

          triggerBtn.addEventListener('click', startSimulation);
          resetBtn.addEventListener('click', resetSimulation);
        });
      </script>
</Layout>
