---
import Layout from '../layouts/Layout.astro';
import CoverflowCarousel from '../components/CoverflowCarousel.astro';
const title = 'Dionisio "Jun" Alvior | Full Stack Software Developer';
const description = 'Full Stack Software Developer building web applications, automation systems, and AI-powered tools that solve real operational problems.';
const coverflowItems = [
  { src: '/quick-portfolio/assets/tagForge.webp', alt: 'tagForge AI SEO Suite', label: 'tagForge · AI SaaS', href: '/quick-portfolio/portfolio/tagforge/' },
  { src: '/quick-portfolio/assets/helpdesk-ticketing-system/dashboard.png', alt: 'HelpDesk Ticketing System dashboard', label: 'HelpDesk · Ticketing', href: '/quick-portfolio/portfolio/helpdesk-ticketing-system/' },
  { src: '/quick-portfolio/assets/pos/pos.png', alt: 'StockFlow POS checkout', label: 'StockFlow POS', href: '/quick-portfolio/portfolio/stockflow-pos/' },
  { src: '/quick-portfolio/assets/nba-analytics/overview.png', alt: 'Lakers Analytics Dashboard', label: 'Lakers Analytics', href: '/quick-portfolio/portfolio/nba-analytics/' },
  { src: '/quick-portfolio/assets/automation-showcase.png', alt: 'Automation Pick-up Service', label: 'Automation Pick-up', href: '/quick-portfolio/portfolio/automation-pick-up-service/' },
  { src: '/quick-portfolio/assets/iot-automation-integration/localhost.png', alt: 'RFID IoT Membership Scanner dashboard', label: 'RFID IoT Scanner', href: '/quick-portfolio/portfolio/iot-automation-integration/' },
  { src: '/quick-portfolio/assets/ojt-journals.png', alt: 'Academic Compliance & Audit Portal', label: 'OJT Audit Portal', href: '/quick-portfolio/portfolio/ojt-journals/' },
  { src: '/quick-portfolio/assets/tropang-ai.png', alt: 'Tropang AI RAG assistant', label: 'Tropang AI', href: '/quick-portfolio/portfolio/tropang-ai/' },
  { src: '/quick-portfolio/assets/gym-ng-mga-supersaiyan.webp', alt: 'Fitness CRM gym management', label: 'Fitness CRM', href: '/quick-portfolio/portfolio/gym-project/' },
  { src: '/quick-portfolio/assets/school-attendance-system/prototype.jpg', alt: 'Local-First Attendance System prototype', label: 'Attendance System', href: '/quick-portfolio/portfolio/attendance-management-system-school/' },
  { src: '/quick-portfolio/assets/web-scraper.webp', alt: 'Client Acquisition Scraper', label: 'Client Scraper', href: '/quick-portfolio/portfolio/web-scraper-for-client-acquisition/' },
  { src: '/quick-portfolio/assets/ano-po-ulam/desktop-ano-po-ulam.png', alt: 'Ano Pong Ulam recipe PWA', label: 'Ano Pong Ulam', href: '/quick-portfolio/portfolio/ano-po-ulam/' },
  { src: '/quick-portfolio/assets/tagawasak-ng-syudad.webp', alt: 'Tagawasak ng Syudad 3D game', label: 'Tagawasak ng Syudad', href: '/quick-portfolio/portfolio/tagawasak-ng-syudad/' },
];
---

<Layout title={title} description={description}>
  <main id="main-content" class="flex-grow flex flex-col">
    <section
      id="home"
      class="flex-grow flex items-center relative overflow-hidden pt-16 lg:pt-20"
    >
      <!-- Subtle grid + warm wash -->
      <div class="absolute inset-0 -z-10 bg-grey-light dark:bg-[#1a1a1a]"></div>
      <div class="absolute inset-0 -z-10 bg-grid-wood opacity-[0.55] [mask-image:radial-gradient(ellipse_80%_60%_at_50%_0%,black_70%,transparent_110%)]"></div>
      <div class="absolute -top-24 -left-24 w-[520px] h-[520px] bg-wood-300/18 dark:bg-wood-400/10 rounded-full blur-[90px] pointer-events-none hidden md:block"></div>
      <div class="absolute -bottom-32 -right-16 w-[480px] h-[480px] bg-wood-accent/14 dark:bg-wood-accent/8 rounded-full blur-[100px] pointer-events-none hidden md:block"></div>
      <div class="absolute top-0 right-0 w-[38%] h-full bg-white/70 dark:bg-white/[0.02] -z-10 skew-x-12 origin-top-right hidden lg:block border-l border-wood-100/40 dark:border-white/5"></div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-14 sm:py-16 lg:py-20 relative z-10">
        <div class="grid lg:grid-cols-12 gap-8 lg:gap-6 items-center">
          <!-- Copy -->
          <div class="lg:col-span-7 text-center lg:text-left">
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white dark:bg-[#252528] border border-wood-100 dark:border-white/10 shadow-sm gs-reveal">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-[11px] font-bold tracking-[0.14em] uppercase text-wood-700 dark:text-wood-300">Available for freelance & collaborations</span>
            </div>

            <p class="mt-5 text-wood-accent-strong dark:text-wood-300 font-bold tracking-[0.18em] uppercase text-xs gs-reveal">
              Full Stack Software Developer
            </p>
            <h1 class="mt-3 font-display text-4xl sm:text-5xl lg:text-[3.4rem] font-extrabold text-gray-900 dark:text-white leading-[1.05] text-balance gs-reveal">
              Building software that <span class="relative inline-block"><span class="relative z-10 text-wood-accent">solves real problems</span><span class="absolute bottom-1 left-0 w-full h-3 bg-wood-accent/15 dark:bg-wood-accent/20 -z-0 hidden sm:block"></span></span>.
            </h1>
            <p class="mt-5 text-lg md:text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl mx-auto lg:mx-0 text-pretty gs-reveal">
              I build web applications, automation systems, and AI-powered tools that streamline workflows, reduce manual work, and turn business requirements into practical software.
            </p>

            <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center lg:justify-start gs-reveal">
              <a
                href="/quick-portfolio/portfolio/"
                aria-label="View Jun Alvior's selected projects"
                class="group inline-flex items-center justify-center gap-2 px-7 py-4 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg shadow-wood-accent/20 hover:shadow-wood-accent/30 hover:shadow-xl transition-all hover:-translate-y-0.5 focus:ring-2 focus:ring-wood-accent focus:ring-offset-2 dark:focus:ring-offset-[#1a1a1a] focus:outline-none w-full sm:w-auto"
              >
                View Selected Work
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
              </a>
              <a
                href="/quick-portfolio/contact/"
                aria-label="Contact Jun Alvior"
                class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-white dark:bg-[#252528] border border-gray-200 dark:border-white/10 text-gray-900 dark:text-white font-semibold rounded-xl shadow-sm hover:bg-gray-50 dark:hover:bg-[#2a2a2e] hover:border-gray-300 dark:hover:border-white/15 hover:shadow-md transition-all hover:-translate-y-0.5 focus:ring-2 focus:ring-wood-accent focus:ring-offset-2 dark:focus:ring-offset-[#1a1a1a] focus:outline-none w-full sm:w-auto"
              >
                Get in Touch
                <svg class="w-4 h-4 text-wood-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
              </a>
            </div>
            <p class="mt-3 text-center lg:text-left text-xs text-gray-500 dark:text-gray-400">
              Prefer a PDF? <a href="/quick-portfolio/assets/Jun-Alvior.pdf" target="_blank" rel="noopener noreferrer" class="font-semibold text-wood-accent hover:text-wood-700 dark:text-wood-300 underline underline-offset-4 decoration-wood-accent/30 hover:decoration-wood-accent">View Resume</a>
            </p>

            <!-- Trust row - no personal photo -->
            <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start gs-reveal">
              <div class="flex -space-x-2">
                <span class="w-8 h-8 rounded-full border-2 border-white dark:border-[#1a1a1a] bg-wood-accent text-white flex items-center justify-center text-[10px] font-bold">JA</span>
                <span class="w-8 h-8 rounded-full border-2 border-white dark:border-[#1a1a1a] bg-wood-100 dark:bg-[#252528] flex items-center justify-center text-[10px] font-bold text-wood-700 dark:text-wood-300">10+</span>
                <span class="w-8 h-8 rounded-full border-2 border-white dark:border-[#1a1a1a] bg-gray-900 text-white flex items-center justify-center">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>
                </span>
              </div>
              <div class="text-center sm:text-left">
                <div class="flex items-center justify-center sm:justify-start gap-1 text-amber-500">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                  <span class="ml-1 text-xs font-semibold text-gray-600 dark:text-gray-300">Trusted by clients · 7 testimonials</span>
                </div>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Full-stack · Automation · AI — Bulacan, PH · Remote</p>
              </div>
            </div>
          </div>

          <!-- Visual - Draggable Coverflow (WebTech Buddie style, no extra text) -->
          <div class="lg:col-span-5 relative lg:pl-2 gs-reveal">
            <div class="relative overflow-visible">
              <CoverflowCarousel items={coverflowItems} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-8 sm:py-10 bg-white dark:bg-[#1f1f1f] border-y border-gray-200 dark:border-white/10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-gray-200 dark:divide-white/10">
          <div class="gs-reveal text-center px-4 py-4 md:py-2 flex flex-col items-center">
            <span class="w-8 h-8 rounded-lg bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent mb-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.5V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7.5M16 17a4 4 0 11-8 0"/></svg></span>
            <div class="text-3xl font-display font-extrabold tracking-tight text-gray-900 dark:text-white tabular-nums">7 <span class="text-lg font-bold text-wood-accent">months</span></div>
            <p class="mt-1 text-xs font-semibold tracking-wide uppercase text-gray-500 dark:text-gray-400">Team experience</p>
          </div>
          <div class="gs-reveal text-center px-4 py-4 md:py-2 flex flex-col items-center">
            <span class="w-8 h-8 rounded-lg bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent mb-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></span>
            <div class="text-3xl font-display font-extrabold tracking-tight text-gray-900 dark:text-white tabular-nums">3+ <span class="text-lg font-bold text-wood-accent">years</span></div>
            <p class="mt-1 text-xs font-semibold tracking-wide uppercase text-gray-500 dark:text-gray-400">Freelance · 2022–2025</p>
          </div>
          <div class="gs-reveal text-center px-4 py-4 md:py-2 flex flex-col items-center">
            <span class="w-8 h-8 rounded-lg bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent mb-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg></span>
            <div class="text-3xl font-display font-extrabold tracking-tight text-gray-900 dark:text-white tabular-nums">10+</div>
            <p class="mt-1 text-xs font-semibold tracking-wide uppercase text-gray-500 dark:text-gray-400">Shipped systems</p>
          </div>
          <div class="gs-reveal text-center px-4 py-4 md:py-2 flex flex-col items-center">
            <span class="w-8 h-8 rounded-lg bg-wood-accent/10 dark:bg-white/5 flex items-center justify-center text-wood-accent mb-2"><svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg></span>
            <div class="text-3xl font-display font-extrabold tracking-tight text-gray-900 dark:text-white">BSIS</div>
            <p class="mt-1 text-xs font-semibold tracking-wide uppercase text-gray-500 dark:text-gray-400">Information Systems</p>
          </div>
        </div>
      </div>
    </section>

    <section id="what-i-build" class="section-py bg-white dark:bg-[#1f1f1f]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10 sm:mb-12 max-w-2xl mx-auto">
          <span class="inline-flex px-3 py-1 rounded-full bg-wood-accent/10 dark:bg-white/5 border border-wood-accent/15 dark:border-white/10 text-xs font-bold tracking-[0.14em] text-wood-700 dark:text-wood-300 uppercase">What I Build</span>
          <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white">
            Software That Gets Work Done
          </h2>
          <p class="mt-3 text-sm sm:text-base text-gray-600 dark:text-gray-400 leading-relaxed">Focused on internal tools and automation — not flashy demos. Built for the way work actually happens.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
          <div class="group flex flex-col p-7 sm:p-8 bg-white dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-white/10 shadow-sm hover:border-wood-accent/30 hover:shadow-xl hover:shadow-wood-accent/5 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-wood-accent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-12 h-12 bg-wood-accent/10 dark:bg-white/5 rounded-xl flex items-center justify-center text-wood-accent group-hover:bg-wood-accent group-hover:text-white transition-colors duration-300 mb-5 ring-1 ring-wood-accent/10">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3 class="font-display text-lg font-bold text-gray-900 dark:text-white mb-2">Full-Stack Applications</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              Dashboards, portals, business systems, and web apps that turn messy ops into practical software.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">React</span><span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">ASP.NET</span><span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">Laravel</span>
            </div>
          </div>

          <div class="group flex flex-col p-7 sm:p-8 bg-white dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-white/10 shadow-sm hover:border-emerald-500/20 hover:shadow-xl hover:shadow-emerald-500/5 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-emerald-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-12 h-12 bg-emerald-500/10 dark:bg-emerald-500/10 rounded-xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 group-hover:bg-emerald-500 group-hover:text-white transition-colors duration-300 mb-5 ring-1 ring-emerald-500/10">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            </div>
            <h3 class="font-display text-lg font-bold text-gray-900 dark:text-white mb-2">Automation &amp; Integrations</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              API integrations, workflow automation, notifications, and data pipelines that kill repetitive work.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">n8n</span><span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">Webhooks</span><span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">APIs</span>
            </div>
          </div>

          <div class="group flex flex-col p-7 sm:p-8 bg-white dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-white/10 shadow-sm hover:border-amber-500/20 hover:shadow-xl hover:shadow-amber-500/5 hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-amber-500 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            <div class="w-12 h-12 bg-amber-500/10 dark:bg-amber-500/10 rounded-xl flex items-center justify-center text-amber-600 dark:text-amber-400 group-hover:bg-amber-500 group-hover:text-white transition-colors duration-300 mb-5 ring-1 ring-amber-500/10">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
            </div>
            <h3 class="font-display text-lg font-bold text-gray-900 dark:text-white mb-2">AI-Powered Systems</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
              RAG apps, AI assistants, document processing, and intelligent search that actually helps.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">RAG</span><span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">AI APIs</span><span class="px-2 py-1 rounded-full bg-grey-light dark:bg-white/5 border border-gray-200 dark:border-white/10 text-xs font-medium text-gray-600 dark:text-gray-300">Search</span>
            </div>
          </div>
        </div>

        <div class="text-center mt-10">
          <a href="/quick-portfolio/portfolio/" class="group inline-flex items-center gap-1.5 text-sm font-bold text-wood-accent hover:text-wood-700 dark:text-wood-300 transition-colors">Explore My Projects <span class="transition-transform group-hover:translate-x-1">→</span></a>
        </div>
      </div>
