---
/**
 * Rate page for the quick portfolio site.
 * This file renders service pricing as a visitor reference and provides an accessible project idea modal.
 * The modal form validates visitor input and sends project ideas directly to Firestore for admin follow-up.
 */
import Layout from "../../layouts/Layout.astro";

const title = "Web Development Rates & Services | Jun Alvior | Full Stack Software Developer";
const description =
  "Affordable and professional web development services. View rates and send a project idea to Jun Alvior, a Full Stack Software Developer.";

const services = [
  {
    projectType: "Simple Portfolio / Personal Site",
    features: "1-3 pages, dark/light toggle, responsive, basic animations",
    min: 100,
    max: 160,
    hasPlus: false,
  },
  {
    projectType: "Portfolio + Projects / Blog",
    features: "5-7 pages, modular sections, project cards, blog (static markdown), basic UI",
    min: 160,
    max: 260,
    hasPlus: false,
  },
  {
    projectType: "Business / Company Website",
    features: "5-10 pages, forms (contact), dynamic project cards, dark/light, polished UI",
    min: 260,
    max: 455,
    hasPlus: false,
  },
  {
    projectType: "Dashboard / Management System",
    features: "CRUD-ish UI, tables, dashboards, filters, charts (no backend)",
    min: 325,
    max: 585,
    hasPlus: false,
  },
  {
    projectType: "Full Stack / Dynamic with AI/ML",
    features: "Backend integration (Node.js / Django / PHP), AI/automation, dynamic data, real-time interactions",
    min: 520,
    max: 975,
    hasPlus: true,
  },
];
---

<Layout title={title} description={description}>
  <main id="main-content" class="flex-grow flex flex-col">
    <section id="rate" class="py-24 bg-white dark:bg-[#1f1f1f] flex-grow">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12 relative" data-aos="fade-up">
          <span class="text-wood-accent font-bold tracking-widest uppercase text-sm mb-4 block">Services</span>
          <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
            What I Offer & Rates
          </h1>
          <p class="max-w-2xl mx-auto text-gray-600 dark:text-gray-400">
            Use the rates as a starting point, then send the project idea you want to discuss.
          </p>
          <div class="w-24 h-1 bg-wood-accent mx-auto rounded-full mt-6"></div>
        </div>

        <div class="space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4" data-aos="fade-up">
              <button
                type="button"
                id="send-project-idea-btn"
                aria-haspopup="dialog"
                aria-controls="project-idea-modal"
                aria-expanded="false"
                class="px-4 md:px-6 py-3 bg-wood-accent text-white font-bold rounded-xl shadow-lg hover:bg-wood-700 hover:shadow-xl transition-all inline-flex items-center group min-h-[52px]"
              >
                Send Project Idea
                <svg class="ml-2 transform group-hover:translate-x-1 transition-transform text-white w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path>
                </svg>
              </button>

              <div class="flex items-center gap-4 bg-white dark:bg-black/20 p-3 px-5 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm min-h-[52px] w-fit">
                <span class="text-sm font-medium text-gray-500 dark:text-gray-400 whitespace-nowrap" id="label-usdt">USDT ($)</span>
                
                <button
                  id="currency-toggle"
                  class="relative flex items-center justify-center w-14 h-8 rounded-full cursor-pointer focus:outline-none focus:ring-2 focus:ring-wood-accent bg-gray-200 dark:bg-gray-700 overflow-hidden"
                  role="switch"
                  aria-checked="true"
                  type="button"
                >
                  <span class="sr-only">Toggle currency</span>
                  <!-- Toggle background (animated color) -->
                  <div id="toggle-bg" class="absolute inset-0 bg-wood-accent opacity-100"></div>
                  <!-- SVG Track and Thumb -->
                  <svg width="56" height="32" viewBox="0 0 56 32" class="absolute inset-0 pointer-events-none z-10">
                    <rect x="0" y="0" width="56" height="32" rx="16" fill="none" stroke="currentColor" stroke-width="2" class="text-transparent" />
                    <!-- The thumb -->
                    <circle id="toggle-thumb-svg" cx="40" cy="16" r="12" fill="#fff" class="drop-shadow-md" />
                    <!-- SVG icons inside thumb -->
                    <g id="toggle-icon-php" transform="translate(34, 10) scale(0.5)" opacity="1">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1.44 14.8c-.2.2-.45.3-.78.3-.33 0-.59-.1-.78-.3-.19-.19-.29-.46-.29-.81 0-.35.1-.62.29-.81.2-.2.45-.3.78-.3.33 0 .59.1.78.3.19.2.29.47.29.81s-.1.62-.29.81z" fill="#d4a373"/>
                    </g>
                    <g id="toggle-icon-usdt" transform="translate(34, 10) scale(0.5)" opacity="0">
                      <path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="#4ade80"/>
                    </g>
                  </svg>
                </button>

                <span class="text-sm font-bold text-gray-900 dark:text-white whitespace-nowrap" id="label-php">PHP</span>
              </div>
            </div>

            <div class="overflow-x-auto shadow-xl rounded-2xl border border-gray-200 dark:border-gray-700" data-aos="fade-up" data-aos-delay="100">
              <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 responsive-table">
                <thead class="bg-gray-50 dark:bg-gray-900/50">
                  <tr>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-wood-accent uppercase tracking-wider w-1/4">Project Type</th>
                    <th scope="col" class="px-6 py-4 text-left text-xs font-bold text-wood-accent uppercase tracking-wider w-1/2">Features</th>
                    <th scope="col" class="px-6 py-4 text-right text-xs font-bold text-wood-accent uppercase tracking-wider w-1/4">Price <span id="currency-code">(PHP)</span></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                  {
                    services.map((service) => (
                      <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                        <td class="px-6 py-4 whitespace-normal" data-label="Project Type">
                          <div class="text-sm font-bold text-gray-900 dark:text-white">{service.projectType}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-normal" data-label="Features">
                          <div class="text-sm text-gray-600 dark:text-gray-400">{service.features}</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right" data-label="Price">
                          <div class="text-sm font-bold text-wood-accent price-cell" data-min={service.min} data-max={service.max} data-plus={service.hasPlus ? "true" : "false"}>
                            ${service.min} - ${service.max}{service.hasPlus ? "+" : ""}
                          </div>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
        </div>
      </div>
    </section>

    <div id="project-idea-modal" class="fixed inset-0 z-[100] hidden overflow-y-auto px-4 py-6 sm:px-0" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="project-idea-modal-title" aria-describedby="project-idea-modal-description">
      <button id="project-idea-backdrop" type="button" class="fixed inset-0 bg-black/60 backdrop-blur-sm" aria-label="Close project idea form"></button>

      <div class="relative z-10 w-full max-w-2xl mx-auto min-h-full flex items-center justify-center py-8">
        <form id="project-idea-form" class="relative w-full bg-gray-50 dark:bg-[#252528] rounded-2xl p-6 sm:p-8 border border-gray-200 dark:border-gray-800 shadow-2xl space-y-5 overflow-hidden" novalidate>
          <!-- Success Overlay -->
          <div id="success-animation-overlay" class="absolute inset-0 bg-gray-50 dark:bg-[#252528] z-50 flex flex-col items-center justify-center pointer-events-none opacity-0">
            <svg width="80" height="80" viewBox="0 0 80 80" class="mb-6">
              <!-- Circle -->
              <circle id="success-circle" cx="40" cy="40" r="36" fill="none" stroke="#22c55e" stroke-width="4" stroke-dasharray="226" style="stroke-dashoffset: 226;" />
              <!-- Checkmark -->
              <path id="success-check" d="M24 40 L36 52 L56 28" fill="none" stroke="#22c55e" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="60" style="stroke-dashoffset: 60;" />
            </svg>
            <h3 id="success-title" class="text-3xl font-extrabold text-gray-900 dark:text-white opacity-0 transform translate-y-4">Idea Sent!</h3>
            <p id="success-message" class="text-gray-600 dark:text-gray-400 mt-3 text-center opacity-0 transform translate-y-4 px-6 text-sm">
              Thank you. I'll review it and reach out to you shortly.
            </p>
          </div>
          <button id="close-project-idea-modal" type="button" class="absolute top-4 right-4 p-2 rounded-full bg-white dark:bg-white/5 text-gray-500 dark:text-gray-400 hover:text-wood-accent focus:outline-none focus:ring-2 focus:ring-wood-accent transition-colors" aria-label="Close project idea form">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
            </svg>
          </button>

          <div class="pr-10">
            <span class="text-wood-accent font-bold tracking-widest uppercase text-xs mb-2 block">Project Inquiry</span>
            <h2 id="project-idea-modal-title" class="text-2xl font-extrabold text-gray-900 dark:text-white">Tell me your project idea</h2>
            <p id="project-idea-modal-description" class="text-sm text-gray-600 dark:text-gray-400 mt-2">
              Send your idea directly so I can review it and follow up manually for a meeting.
            </p>
          </div>

          <div>
            <label for="client-name" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Name</label>
            <input id="client-name" name="name" type="text" autocomplete="name" class="w-full bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-2 focus:ring-wood-accent focus:border-transparent p-3 shadow-sm outline-none placeholder-gray-400" placeholder="Your name" />
          </div>

          <div>
            <label for="client-email" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Reply email</label>
            <input id="client-email" name="email" type="email" autocomplete="email" class="w-full bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-2 focus:ring-wood-accent focus:border-transparent p-3 shadow-sm outline-none placeholder-gray-400" placeholder="you@example.com" />
          </div>

          <div>
            <label for="project-idea" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Project idea</label>
            <textarea id="project-idea" name="idea" rows="5" class="w-full bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-2 focus:ring-wood-accent focus:border-transparent p-3 shadow-sm outline-none placeholder-gray-400 resize-y" placeholder="What do you want to build?"></textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="project-budget" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Budget</label>
              <input id="project-budget" name="budget" type="text" class="w-full bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-2 focus:ring-wood-accent focus:border-transparent p-3 shadow-sm outline-none placeholder-gray-400" placeholder="Optional" />
            </div>
            <div>
              <label for="project-timeline" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Timeline</label>
              <input id="project-timeline" name="timeline" type="text" class="w-full bg-white dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-2 focus:ring-wood-accent focus:border-transparent p-3 shadow-sm outline-none placeholder-gray-400" placeholder="Optional" />
            </div>
          </div>

          <button id="submit-project-idea-btn" type="submit" class="w-full bg-gray-900 hover:bg-black dark:bg-white dark:hover:bg-gray-100 text-white dark:text-gray-900 font-bold py-4 px-6 rounded-lg transition-colors flex justify-center items-center shadow-md group">
            Send Project Idea
            <svg class="ml-2 group-hover:translate-x-1 transition-transform w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"></path>
            </svg>
          </button>

          <p id="idea-feedback" class="hidden text-sm font-medium rounded-lg p-3" role="status" aria-live="polite"></p>
          <p class="text-xs text-gray-500 dark:text-gray-400">
            Your idea is saved securely in Firebase for manual follow-up.
          </p>
        </form>
      </div>
    </div>
  </main>

  <style>
    /* Responsive Table Core CSS Wrapper */
    @media (max-width: 767px) {
      table.responsive-table,
      table.responsive-table thead,
      table.responsive-table tbody,
      table.responsive-table th,
      table.responsive-table td,
      table.responsive-table tr {
        display: block;
      }

      table.responsive-table thead tr {
        position: absolute;
        top: -9999px;
        left: -9999px;
      }

      table.responsive-table tr {
        border: 1px solid #e5e7eb;
        border-radius: 0.5rem;
        margin-bottom: 1rem;
        background: #fff;
      }

      html.dark table.responsive-table tr {
        border-color: #374151;
        background-color: #1f2937;
      }

      table.responsive-table td {
        border: none;
        border-bottom: 1px solid #f3f4f6;
        position: relative;
        padding-left: 45% !important;
        text-align: left !important;
        white-space: normal;
        min-height: 48px;
        display: flex;
        align-items: center;
      }

      html.dark table.responsive-table td {
        border-bottom-color: #374151;
      }

      table.responsive-table td:last-child {
        border-bottom: 0;
      }

      table.responsive-table td::before {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        left: 1rem;
        width: 35%;
        padding-right: 10px;
        white-space: nowrap;
        content: attr(data-label);
        font-weight: bold;
        color: var(--wood-accent);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
    }
  </style>

  <script>
    import { initializeApp } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-app.js";
    import { addDoc, collection, getFirestore, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-firestore.js";
    import { animate } from "animejs";
    import { sanitizeContactField, sanitizeContactMessage, validateProjectIdeaInput } from "../../utils/contact";
    import { FIREBASE_CONFIG, LEAD_NOTES_COLLECTION } from "../../utils/firebase";

    const PHP_RATE = 56;
    const firebaseApp = initializeApp(FIREBASE_CONFIG);
    const database = getFirestore(firebaseApp);

    /**
     * Formats a number for compact price display in the selected currency.
     * It accepts a numeric value and returns a comma-separated string.
     */
    function numberWithCommas(value) {
      return value.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
    }

    /**
     * Updates the visible pricing table values after the visitor toggles currency.
     * It accepts the target currency code and renders either PHP estimates or USDT values.
     */
    function setCurrency(currency) {
      const currencyCode = document.getElementById("currency-code");
      if (currencyCode) currencyCode.textContent = `(${currency})`;

      document.querySelectorAll(".price-cell").forEach((cell) => {
        const min = Number(cell.dataset.min);
        const max = Number(cell.dataset.max);
        const hasPlus = cell.dataset.plus === "true";

        if (currency === "USDT") {
          cell.textContent = `$${min} - $${max}${hasPlus ? "+" : ""}`;
          return;
        }

        cell.textContent = `PHP ${numberWithCommas(min * PHP_RATE)} - PHP ${numberWithCommas(max * PHP_RATE)}${hasPlus ? "+" : ""}`;
      });
    }

    /**
     * Shows a clean validation or status message beneath the project idea form.
     * It accepts a message and variant string, then renders a styled user-facing response.
     */
    function showFeedback(message, variant) {
      const feedback = document.getElementById("idea-feedback");
      if (!feedback) return;

      feedback.classList.remove("hidden", "bg-red-100", "text-red-700", "bg-green-100", "text-green-700");
      feedback.classList.add(variant === "error" ? "bg-red-100" : "bg-green-100", variant === "error" ? "text-red-700" : "text-green-700");
      feedback.textContent = message;
    }

    /**
     * Reads the project idea form into a plain object for validation and mailto generation.
     * It accepts the form element and returns the values currently entered by the visitor.
     */
    function readProjectIdeaForm(form) {
      const formData = new FormData(form);

      return {
        name: String(formData.get("name") ?? ""),
        email: String(formData.get("email") ?? ""),
        idea: String(formData.get("idea") ?? ""),
        budget: String(formData.get("budget") ?? ""),
        timeline: String(formData.get("timeline") ?? ""),
      };
    }

    /**
     * Returns all focusable controls inside the project idea modal.
     * It accepts the modal element and returns visible focusable elements used by the focus trap.
     */
    function getFocusableModalElements(modal) {
      return Array.from(
        modal.querySelectorAll(
          'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((element) => element.offsetParent !== null);
    }

    /**
     * Opens the project idea modal and moves focus to the first form field.
     * It accepts the modal, opener button, and first field, then returns no value.
     */
    function openProjectIdeaModal(modal, openerButton, firstField) {
      modal.classList.remove("hidden");
      modal.setAttribute("aria-hidden", "false");
      openerButton?.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      window.setTimeout(() => firstField?.focus(), 0);
    }

    /**
     * Closes the project idea modal and restores focus to the CTA that opened it.
     * It accepts the modal and opener button, then returns no value.
     */
    function closeProjectIdeaModal(modal, openerButton) {
      modal.classList.add("hidden");
      modal.setAttribute("aria-hidden", "true");
      openerButton?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      openerButton?.focus();
    }

    /**
     * Keeps keyboard focus inside the open modal when Tab or Shift+Tab is pressed.
     * It accepts a keyboard event and modal element, then loops focus when needed.
     */
    function trapModalFocus(event, modal) {
      if (event.key !== "Tab") return;

      const focusableElements = getFocusableModalElements(modal);
      const firstElement = focusableElements[0];
      const lastElement = focusableElements[focusableElements.length - 1];
      if (!firstElement || !lastElement) return;

      if (event.shiftKey && document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      } else if (!event.shiftKey && document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    }

    /**
     * Initializes the rate page interactions once the document is ready.
     * It accepts no arguments and wires currency toggling, accessible modal behavior, validation, and Firestore submission.
     */
    function initializeRatePage() {
      const ctaButton = document.getElementById("send-project-idea-btn");
      const ideaModal = document.getElementById("project-idea-modal");
      const ideaForm = document.getElementById("project-idea-form");
      const submitButton = document.getElementById("submit-project-idea-btn");
      const firstField = document.getElementById("client-name");
      const closeModalButton = document.getElementById("close-project-idea-modal");
      const modalBackdrop = document.getElementById("project-idea-backdrop");
      const currencyToggle = document.getElementById("currency-toggle");

      setCurrency("PHP");

      ctaButton?.addEventListener("click", () => {
        if (!ideaModal) return;
        openProjectIdeaModal(ideaModal, ctaButton, firstField);
      });

      closeModalButton?.addEventListener("click", () => {
        if (!ideaModal) return;
        closeProjectIdeaModal(ideaModal, ctaButton);
      });

      modalBackdrop?.addEventListener("click", () => {
        if (!ideaModal) return;
        closeProjectIdeaModal(ideaModal, ctaButton);
      });

      ideaModal?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeProjectIdeaModal(ideaModal, ctaButton);
          return;
        }

        trapModalFocus(event, ideaModal);
      });

      currencyToggle?.addEventListener("click", () => {
        const isPhp = currencyToggle.getAttribute("aria-checked") === "true";
        currencyToggle.setAttribute("aria-checked", String(!isPhp));
        
        const newCurrency = !isPhp ? "PHP" : "USDT";
        setCurrency(newCurrency);

        // Anime.js transition for toggle
        const toggleBg = document.getElementById("toggle-bg");
        const toggleThumb = document.getElementById("toggle-thumb-svg");
        const iconPhp = document.getElementById("toggle-icon-php");
        const iconUsdt = document.getElementById("toggle-icon-usdt");
        const labelPhp = document.getElementById("label-php");
        const labelUsdt = document.getElementById("label-usdt");

        // Move thumb
        animate(toggleThumb, {
          cx: newCurrency === "PHP" ? 40 : 16,
          duration: 400,
          ease: "spring(1, 80, 10, 0)"
        });

        // Move icons with thumb, ensuring vertical alignment and scale are preserved
        animate([iconPhp, iconUsdt], {
          translateX: newCurrency === "PHP" ? 34 : 10,
          translateY: 10,
          scale: 0.5,
          duration: 400,
          ease: "spring(1, 80, 10, 0)"
        });

        // Fade background color opacity
        animate(toggleBg, {
          opacity: newCurrency === "PHP" ? 1 : 0,
          duration: 300,
          ease: "easeInOutQuad"
        });

        // Fade icons
        animate(iconPhp, {
          opacity: newCurrency === "PHP" ? 1 : 0,
          duration: 200,
          ease: "easeInOutQuad"
        });

        animate(iconUsdt, {
          opacity: newCurrency === "USDT" ? 1 : 0,
          duration: 200,
          ease: "easeInOutQuad"
        });

        // Highlight active text and sync font weights
        if (newCurrency === "PHP") {
          labelPhp.classList.replace("text-gray-500", "text-gray-900");
          labelPhp.classList.replace("dark:text-gray-400", "dark:text-white");
          labelPhp.classList.replace("font-medium", "font-bold");
          
          labelUsdt.classList.replace("text-gray-900", "text-gray-500");
          labelUsdt.classList.replace("dark:text-white", "dark:text-gray-400");
          labelUsdt.classList.replace("font-bold", "font-medium");
        } else {
          labelUsdt.classList.replace("text-gray-500", "text-gray-900");
          labelUsdt.classList.replace("dark:text-gray-400", "dark:text-white");
          labelUsdt.classList.replace("font-medium", "font-bold");
          
          labelPhp.classList.replace("text-gray-900", "text-gray-500");
          labelPhp.classList.replace("dark:text-white", "dark:text-gray-400");
          labelPhp.classList.replace("font-bold", "font-medium");
        }
      });

      ideaForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const input = readProjectIdeaForm(ideaForm);
        const validation = validateProjectIdeaInput(input);

        if (!validation.isValid) {
          showFeedback(validation.message, "error");
          return;
        }

        submitButton.disabled = true;
        submitButton.textContent = "Sending...";

        try {
          await addDoc(collection(database, LEAD_NOTES_COLLECTION), {
            name: sanitizeContactField(input.name),
            email: sanitizeContactField(input.email),
            idea: sanitizeContactMessage(input.idea),
            budget: sanitizeContactField(input.budget ?? ""),
            timeline: sanitizeContactField(input.timeline ?? ""),
            nextAction: "Review project idea and schedule meeting",
            status: "New",
            source: "Rate page",
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp(),
          });
          // Trigger visually appealing success animation
          const successOverlay = document.getElementById("success-animation-overlay");
          const successCircle = document.getElementById("success-circle");
          const successCheck = document.getElementById("success-check");
          const successTitle = document.getElementById("success-title");
          const successMessage = document.getElementById("success-message");
          
          successOverlay.classList.remove("pointer-events-none");
          
          animate(successOverlay, { opacity: 1, duration: 300, ease: "linear" });
          animate(successCircle, { strokeDashoffset: [226, 0], duration: 800, delay: 100, ease: "easeInOutQuad" });
          animate(successCheck, { strokeDashoffset: [60, 0], duration: 500, delay: 500, ease: "easeOutQuad" });
          
          animate(successTitle, { opacity: [0, 1], translateY: [16, 0], duration: 600, delay: 700, ease: "spring(1, 80, 10, 0)" });
          animate(successMessage, { opacity: [0, 1], translateY: [16, 0], duration: 600, delay: 850, ease: "spring(1, 80, 10, 0)" });
          
          setTimeout(() => {
            const ideaModal = document.getElementById("project-idea-modal");
            const ctaButton = document.getElementById("send-project-idea-btn");
            closeProjectIdeaModal(ideaModal, ctaButton);
            
            // Reset states silently after modal is hidden
            setTimeout(() => {
              ideaForm.reset();
              successOverlay.classList.add("pointer-events-none");
              successOverlay.style.opacity = "0";
              successCircle.style.strokeDashoffset = "226";
              successCheck.style.strokeDashoffset = "60";
              successTitle.style.opacity = "0";
              successTitle.style.transform = "translateY(16px)";
              successMessage.style.opacity = "0";
              successMessage.style.transform = "translateY(16px)";
              submitButton.disabled = false;
              submitButton.textContent = "Send Project Idea";
              
              const feedback = document.getElementById("idea-feedback");
              if(feedback) feedback.classList.add("hidden");
            }, 300);
          }, 3500);

        } catch {
          showFeedback("Project idea could not be sent right now. Please try again later.", "error");
          submitButton.disabled = false;
          submitButton.textContent = "Send Project Idea";
        }
      });
    }

    document.addEventListener("DOMContentLoaded", initializeRatePage);
  </script>
</Layout>
