---
/**
 * Strategy Call Booking Page Component
 * File: src/pages/rate/index.astro
 * Purpose: Allows potential clients to book a free 15-minute business automation and technical strategy session.
 * Contains: Core value propositions, meeting agenda, direct Calendly embed widget with visual loading states, and fallback triggers.
 * System Role: Replaces the old static rates catalog page with a high-conversion strategy call scheduler, routing warm leads directly to Calendly.
 */
import Layout from "../../layouts/Layout.astro";

// Easily configurable Calendly event URL
// NOTE: Rebranded from 30min to 15-minute-meeting for high conversion and quick strategy alignment.
const CALENDLY_URL = "https://calendly.com/junalvior21/15-minute-meeting";

const title = "Book a Free 15-Minute Strategy Call | Jun Alvior | Business Automation Specialist";
const description =
  "Schedule a free 15-minute technical strategy session with Jun Alvior. Audit your business workflows, identify bottleneck automation points, and map out a clean scalable application roadmap.";
---

<Layout title={title} description={description}>
  <main id="main-content" class="flex-grow flex flex-col">
    <!-- ORGANISMS: Booking Section -->
    <section id="strategy-call" class="py-24 bg-grey-light dark:bg-[#1a1a1a] flex-grow transition-colors duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header Introduction Section -->
        <div class="text-center mb-16 relative animate-fade-in">
          <span class="text-sm font-bold tracking-widest text-wood-accent uppercase mb-2 block">Strategy Session</span>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white max-w-4xl mx-auto">
            Book a Free 15-Minute Strategy Call
          </h1>
          <p class="max-w-2xl mx-auto mt-4 text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            Let's audit your manual workflows, map out your technical system requirements, and design an implementation plan to scale your startup.
          </p>
          <div class="w-24 h-1 bg-wood-accent mx-auto rounded-full mt-6"></div>
        </div>

        <!-- Center-Aligned Container Grid (Sets strict layout constraint for maximum premium typography flow) -->
        <div class="max-w-3xl mx-auto space-y-12">
          
          <!-- Card 1: Value Proposition (No solid backgrounds, centered text structure) -->
          <div class="p-6 sm:p-8 w-full text-center">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center justify-center gap-2">
              <svg class="w-6 h-6 text-wood-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 002-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
              </svg>
              What We Will Accomplish:
            </h2>
            
            <!-- Centered Steps Wrapper -->
            <div class="space-y-6 max-w-xl mx-auto text-left pb-8">
              <!-- Step 1 -->
              <div class="flex gap-4">
                <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-wood-accent/10 text-wood-accent font-bold text-sm">
                  1
                </div>
                <div>
                  <h3 class="text-sm font-bold text-gray-900 dark:text-white mb-1">
                    Workflow Bottleneck Audit
                  </h3>
                  <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    We'll examine your current operations to pinpoint slow processes, spreadsheets, or legacy tools that drain team productivity.
                  </p>
                </div>
              </div>

              <!-- Step 2 -->
              <div class="flex gap-4">
                <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-wood-accent/10 text-wood-accent font-bold text-sm">
                  2
                </div>
                <div>
                  <h3 class="text-sm font-bold text-gray-900 dark:text-white mb-1">
                    Technical Feasibility Mapping
                  </h3>
                  <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    Determine the absolute best stack (React, Django, Supabase, or custom background automation scripts) that achieves your business goals.
                  </p>
                </div>
              </div>

              <!-- Step 3 -->
              <div class="flex gap-4">
                <div class="flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full bg-wood-accent/10 text-wood-accent font-bold text-sm">
                  3
                </div>
                <div>
                  <h3 class="text-sm font-bold text-gray-900 dark:text-white mb-1">
                    Actionable System Roadmap
                  </h3>
                  <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    Leave the call with a clear implementation outline and estimated timelines, with zero obligation to hire me.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Card 2: Client Value Statement Card (No solid backgrounds, completely centered elements) -->
          <div class="p-8 relative overflow-hidden w-full text-center">
            <div class="absolute -right-8 -bottom-8 w-24 h-24 bg-wood-accent/5 rounded-full blur-xl"></div>
            
            <svg class="w-10 h-10 text-wood-accent/20 absolute top-4 right-4" fill="currentColor" viewBox="0 0 32 32">
              <path d="M10 8c-3.3 0-6 2.7-6 6v10h10V14H6c0-2.2 1.8-4 4-4V8zm12 0c-3.3 0-6 2.7-6 6v10h10V14h-8c0-2.2 1.8-4 4-4V8z"/>
            </svg>
            
            <p class="text-base text-gray-700 dark:text-gray-300 italic mb-6 leading-relaxed relative z-10 max-w-2xl mx-auto">
              "I deliver international-grade architectures and bulletproof backend integrations without the Silicon Valley agency bloat. Let's design a system that works for you."
            </p>
            
            <!-- Author Card Details (Centered flex container layout with extra padding to breathe) -->
            <div class="flex items-center justify-center gap-4 relative z-10 py-2">
              <div class="w-12 h-12 flex-shrink-0 rounded-full bg-wood-accent/20 border-2 border-wood-accent text-wood-accent flex items-center justify-center font-bold text-sm shadow-inner">
                JA
              </div>
              <div class="flex flex-col text-left justify-center pl-2">
                <h4 class="text-sm font-bold text-gray-900 dark:text-white leading-tight">Jun Alvior</h4>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Full Stack Developer & Automation Engineer</p>
              </div>
            </div>
          </div>

          <!-- Card 4: Centered Dynamic Scheduler Widget (Appointment card wrapper with background removed) -->
          <div class="flex flex-col w-full mx-auto mt-6">
            <!-- Transparent Container (Completely removed solid backgrounds, borders, padding, and shadows) -->
            <div class="relative w-full overflow-hidden min-h-[700px] bg-transparent">
              
              <!-- Skeletal Loading State (Matches page background exactly to prevent layout flash) -->
              <!-- NOTE: Uses transparent background to respect the user's design preference and prevent unreadable texts -->
              <div id="scheduler-skeleton" class="absolute inset-0 flex flex-col justify-center items-center bg-transparent z-10 transition-all duration-500 p-8">
                <div class="flex flex-col items-center max-w-sm text-center">
                  <!-- Premium Custom Loader Ring -->
                  <div class="relative w-16 h-16 mb-6">
                    <div class="absolute inset-0 border-4 border-wood-accent/20 rounded-full"></div>
                    <div class="absolute inset-0 border-4 border-wood-accent border-t-transparent rounded-full animate-spin"></div>
                    <div class="absolute inset-2 border-2 border-wood-accent/30 rounded-full animate-ping"></div>
                  </div>
                  
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                    Loading Strategic Scheduler
                  </h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">
                    Aligning color scheme with your theme preference...
                  </p>
                  
                  <!-- Direct Access Fallback Button -->
                  <a
                    href={CALENDLY_URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-6 px-5 py-2.5 bg-wood-accent hover:bg-wood-700 text-white text-xs font-bold rounded-lg transition-colors inline-flex items-center gap-2 shadow-md hover:shadow-wood-accent/20"
                  >
                    Open Scheduler Directly
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Calendly Dynamic Injection Container -->
              <div id="calendly-container" class="w-full min-h-[680px] rounded-xl overflow-hidden bg-transparent"></div>
            </div>
            
            <p class="text-center text-xs text-gray-500 dark:text-gray-400 mt-4">
              Secured & routed via Calendly. Need a custom time slot? Email me directly at <a href="mailto:junalvior21@gmail.com" class="text-wood-accent hover:underline">junalvior21@gmail.com</a>.
            </p>
          </div>

          <!-- Card 3: Alternative Action Card (Prefer Email First? - Completely centered text, no solid backgrounds) -->
          <div class="p-6 sm:p-8 w-full text-center mt-12 sm:mt-16 border-t border-gray-200 dark:border-gray-800">
            <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">Prefer Email First?</h3>
            <p class="text-sm text-gray-600 dark:text-gray-300 mb-6 max-w-xl mx-auto">
              No problem. Submit your project requirements and I will get back to you with a comprehensive analysis in under 24 hours.
            </p>
            <!-- Button centered layout -->
            <div class="max-w-xs sm:max-w-sm mx-auto">
              <a
                href="mailto:junalvior21@gmail.com?subject=Strategy%20Session%20Inquiry"
                class="inline-flex items-center justify-center w-full px-6 py-4 bg-transparent border-2 border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:border-wood-accent hover:text-wood-accent dark:hover:border-wood-accent dark:hover:text-wood-accent transition-all focus:ring-2 focus:ring-wood-accent focus:outline-none focus:ring-offset-2 dark:focus:ring-offset-[#1a1a1a]"
              >
                Email Me
                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>
  
  <!-- Inline Styling for Embedded Widget Elements -->
  <style is:global>
    /* Clean up inline embeds */
    .calendly-inline-widget iframe {
      border: 0 !important;
      background-color: transparent !important;
    }
  </style>

  <!-- Client-side Script to manage loading visual states and dynamic color picking -->
  <script is:inline define:vars={{ CALENDLY_URL }}>
    /**
     * Dynamically builds and loads the Calendly inline scheduler, color-picking the active theme (light or dark).
     * It aligns the background, text, and primary accents with the active website theme.
     * Accepts no arguments and automatically updates the iframe source variables.
     * Returns nothing.
     */
    function loadCalendlyWidget() {
      const container = document.getElementById("calendly-container");
      if (!container) return;

      // Detect if user has active dark mode
      const isDark = document.documentElement.classList.contains("dark");
      
      // Select exact hex values matching the primary page backgrounds (#1a1a1a for dark, #f5f5f5 for grey-light)
      const bgColor = isDark ? "1a1a1a" : "f5f5f5";
      const textColor = isDark ? "e5e7eb" : "1a1a1a";
      const primaryColor = "8d6e63"; // Wood accent hex color
      
      // Compile the final secure request parameters
      const eventParams = `?hide_landing_page_details=1&hide_gdpr_banner=1&background_color=${bgColor}&text_color=${textColor}&primary_color=${primaryColor}`;
      const requestUrl = CALENDLY_URL + eventParams;

      // Prevent redundant iframe layers on theme toggle
      container.innerHTML = "";

      // Construct and configure inline widget element
      const widget = document.createElement("div");
      widget.className = "calendly-inline-widget w-full h-[680px]";
      widget.style.minWidth = "320px";
      widget.style.height = "680px";
      widget.setAttribute("data-url", requestUrl);
      container.appendChild(widget);

      // Initialize widget if the global library is active, else load the asset script
      if (window.Calendly) {
        window.Calendly.initInlineWidgets();
      } else {
        if (!document.getElementById("calendly-script")) {
          const script = document.createElement("script");
          script.id = "calendly-script";
          script.type = "text/javascript";
          script.src = "https://assets.calendly.com/assets/external/widget.js";
          script.async = true;
          document.body.appendChild(script);
        }
      }
    }

    /**
     * Hides the custom skeletal loader wrapper with a smooth transition once Calendly mounts.
     * Accepts no arguments and returns nothing.
     */
    function hideLoadingSkeleton() {
      const skeleton = document.getElementById("scheduler-skeleton");
      if (!skeleton) return;
      skeleton.classList.add("opacity-0", "pointer-events-none");
    }

    // Monitor Calendly postMessage events to hide the loader exactly when the widget content renders
    // This provides a perfect, smooth transition without layout flash.
    window.addEventListener("message", (e) => {
      if (
        e.origin === "https://calendly.com" &&
        e.data.event &&
        (e.data.event === "calendly.event_type_viewed" || e.data.event === "calendly.profile_page_viewed")
      ) {
        hideLoadingSkeleton();
      }
    });

    // Monitor theme toggle button interactions dynamically via document element mutations
    const themeMutationObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "class") {
          // Re-load scheduler with matching background and text colors seamlessly
          loadCalendlyWidget();
        }
      });
    });

    // Initialize all listeners and mount the widget once DOM is active
    document.addEventListener("DOMContentLoaded", () => {
      loadCalendlyWidget();
      themeMutationObserver.observe(document.documentElement, { attributes: true });
    });
  </script>
</Layout>
