---
/**
 * Firebase-backed inquiries inbox page for the quick portfolio site.
 * This file renders an admin-only inquiry workspace protected by Firebase Email/Password Auth.
 * Project ideas submitted from the Rate page are read from Firestore for admin review and follow-up tracking.
 */
import Layout from "../../layouts/Layout.astro";
import { FIREBASE_ADMIN_EMAILS } from "../../utils/firebase";

const title = "Project Inquiries | Jun Alvior | Full Stack Software Developer";
const description = "Firebase-protected inbox for reviewing project inquiries submitted from the Rate page.";
const adminEmailLabel = FIREBASE_ADMIN_EMAILS.join(", ");
---

<Layout title={title} description={description}>
  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 min-h-screen">
    <section id="auth-panel" class="max-w-md mx-auto">
      <form id="login-form" class="bg-white dark:bg-[#252528] rounded-2xl p-6 border border-gray-200 dark:border-gray-800 shadow-xl space-y-5" novalidate>
        <div class="text-center">
          <span class="text-wood-accent font-bold tracking-widest uppercase text-xs mb-2 block">Admin Access</span>
          <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white">Project Inquiries Login</h1>
          <p class="text-sm text-gray-600 dark:text-gray-300 mt-2">
            Sign in with the Firebase admin account for this portfolio.
          </p>
        </div>

        <div>
          <label for="admin-email" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Email</label>
          <input id="admin-email" name="email" type="email" autocomplete="email" class="w-full bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-2 focus:ring-wood-accent focus:border-transparent p-3 shadow-sm outline-none placeholder-gray-400" placeholder={adminEmailLabel} />
        </div>

        <div>
          <label for="admin-password" class="block text-sm font-bold text-gray-900 dark:text-white mb-2">Password</label>
          <input id="admin-password" name="password" type="password" autocomplete="current-password" class="w-full bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg focus:ring-2 focus:ring-wood-accent focus:border-transparent p-3 shadow-sm outline-none placeholder-gray-400" placeholder="Firebase password" />
        </div>

        <button type="submit" class="w-full bg-wood-accent hover:bg-wood-700 text-white font-bold py-4 px-6 rounded-lg transition-colors flex justify-center items-center shadow-md">
          Sign In
        </button>

        <p id="auth-feedback" class="hidden text-sm font-medium rounded-lg p-3" role="status" aria-live="polite"></p>
      </form>
    </section>

    <section id="notes-panel" class="hidden">
      <div class="flex flex-col md:flex-row justify-between gap-4 md:items-end border-b border-gray-200 dark:border-gray-800 pb-6 mb-6">
        <div>
          <span class="text-wood-accent font-bold tracking-widest uppercase text-xs mb-2 block">Inbox</span>
          <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white">Project Inquiries</h1>
          <p id="signed-in-label" class="text-sm text-gray-600 dark:text-gray-300 mt-2"></p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <div id="lead-count" class="px-4 py-2.5 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl text-xs font-bold text-gray-600 dark:text-gray-300 shadow-sm">
            0 Inquiries
          </div>
          <button id="sign-out-btn" type="button" class="bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 font-bold py-2.5 px-4 rounded-lg transition-colors">
            Sign Out
          </button>
        </div>
      </div>

      <p id="lead-feedback" class="hidden text-sm font-medium rounded-lg p-3 mb-6" role="status" aria-live="polite"></p>
      <div id="lead-notes-list" class="grid grid-cols-1 gap-4"></div>

      <div id="empty-lead-state" class="hidden flex-col items-center justify-center py-24 text-center text-gray-400">
        <svg class="w-16 h-16 mb-4 text-gray-300 dark:text-gray-700" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 13 2 6.67V18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6.67zm0-2 8.52-5.51C20.18 5.14 19.62 5 19 5H5c-.62 0-1.18.14-1.52.49z"></path>
        </svg>
        <p class="text-lg font-bold text-gray-500 dark:text-gray-300">No project inquiries yet.</p>
        <p class="text-sm mt-1">Submissions from the Rate page will appear here.</p>
      </div>
    </section>
  </main>

  <script>
    // @ts-nocheck
    import { initializeApp } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-app.js";
    import { getAuth, onAuthStateChanged, signInWithEmailAndPassword, signOut } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-auth.js";
    import { collection, deleteDoc, doc, getFirestore, onSnapshot, orderBy, query, serverTimestamp, updateDoc } from "https://www.gstatic.com/firebasejs/12.10.0/firebase-firestore.js";
    import { sanitizeContactField } from "../../utils/contact";
    import { FIREBASE_ADMIN_EMAILS, FIREBASE_CONFIG, LEAD_NOTES_COLLECTION } from "../../utils/firebase";
    const firebaseApp = initializeApp(FIREBASE_CONFIG);
    const auth = getAuth(firebaseApp);
    const database = getFirestore(firebaseApp);
    let unsubscribeFromNotes: any = null;

    /**
     * Shows a clean status message for authentication or Firestore operations.
     * It accepts an element id, message, and variant string, then renders safe user-facing text.
     */
    function showFeedback(elementId: string, message: string, variant: string) {
      const feedback = document.getElementById(elementId);
      if (!feedback) return;

      feedback.classList.remove("hidden", "bg-red-100", "text-red-700", "bg-green-100", "text-green-700");
      feedback.classList.add(variant === "error" ? "bg-red-100" : "bg-green-100", variant === "error" ? "text-red-700" : "text-green-700");
      feedback.textContent = message;
    }

    /**
     * Checks whether a Firebase user can access the notes workspace.
     * It accepts a Firebase user object and returns true when the user's email is configured as an admin.
     */
    function isAllowedAdmin(user: any) {
      return Boolean(user?.email && FIREBASE_ADMIN_EMAILS.includes(user.email.toLowerCase()));
    }

    /**
     * Creates a text node wrapper with the requested classes for safe note rendering.
     * It accepts an HTML tag name, class names, and text, then returns a DOM element using textContent.
     */
    function createTextElement(tagName: string, className: string, text: string) {
      const element = document.createElement(tagName);
      element.className = className;
      element.textContent = text;
      return element;
    }

    /**
     * Creates the editable status selector for a Firestore note card.
     * It accepts a note object and returns a select element wired by data attributes.
     */
    function createStatusSelect(note: any) {
      const select = document.createElement("select");
      select.className = "note-status bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg p-2 outline-none";
      select.dataset.noteId = note.id;

      ["New", "Contacted", "Meeting", "Waiting", "Closed"].forEach((status) => {
        const option = document.createElement("option");
        option.value = status;
        option.textContent = status;
        option.selected = note.status === status;
        select.append(option);
      });

      return select;
    }

    /**
     * Creates the editable next-action field for a Firestore note card.
     * It accepts a note object and returns an input element wired by data attributes.
     */
    function createNextActionInput(note: any) {
      const input = document.createElement("input");
      input.type = "text";
      input.value = note.nextAction ?? "";
      input.placeholder = "Next action";
      input.dataset.noteId = note.id;
      input.className = "note-next-action w-full bg-gray-50 dark:bg-[#1a1a1a] border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white text-sm rounded-lg p-2 outline-none";
      return input;
    }

    /**
     * Creates a complete note card with safe text rendering and editable controls.
     * It accepts a Firestore note object and returns an article element for the notes list.
     */
    function createLeadNoteCard(note: any) {
      const card = document.createElement("article");
      card.className = "bg-white dark:bg-[#252528] rounded-2xl p-5 border border-gray-200 dark:border-gray-800 shadow-sm space-y-4";

      const header = document.createElement("div");
      header.className = "flex flex-col md:flex-row md:items-start md:justify-between gap-3";

      const identity = document.createElement("div");
      identity.append(createTextElement("h3", "text-lg font-bold text-gray-900 dark:text-white", note.name));
      identity.append(createTextElement("p", "text-sm text-gray-500 dark:text-gray-300", note.email || "No email saved"));

      const actions = document.createElement("div");
      actions.className = "flex items-center gap-2";
      actions.append(createStatusSelect(note));

      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.dataset.noteId = note.id;
      deleteButton.className = "delete-note px-3 py-2 text-sm font-bold rounded-lg bg-red-100 text-red-700 hover:bg-red-200 transition-colors";
      deleteButton.textContent = "Delete";
      actions.append(deleteButton);

      header.append(identity, actions);
      card.append(header);
      card.append(createTextElement("p", "text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap", note.idea));
      if (note.budget || note.timeline) {
        card.append(createTextElement("p", "text-xs font-bold text-gray-500 dark:text-gray-300", `Budget: ${note.budget || "Not provided"} | Timeline: ${note.timeline || "Not provided"}`));
      }

      const footer = document.createElement("div");
      footer.className = "grid grid-cols-1 md:grid-cols-[1fr_auto] gap-3 items-center pt-3 border-t border-gray-100 dark:border-gray-800";
      footer.append(createNextActionInput(note));
      footer.append(createTextElement("span", "text-xs text-gray-400", note.createdAtLabel));
      card.append(footer);

      return card;
    }

    /**
     * Renders the current Firestore note collection into the board.
     * It accepts an array of note objects and updates list, empty state, and count elements.
     */
    function renderLeadNotes(notes: any[]) {
      const list = document.getElementById("lead-notes-list");
      const emptyState = document.getElementById("empty-lead-state");
      const leadCount = document.getElementById("lead-count");
      if (!list || !emptyState || !leadCount) return;

      list.replaceChildren();
      notes.forEach((note) => list.append(createLeadNoteCard(note)));
      emptyState.classList.toggle("hidden", notes.length > 0);
      emptyState.classList.toggle("flex", notes.length === 0);
      leadCount.textContent = `${notes.length} ${notes.length === 1 ? "Inquiry" : "Inquiries"}`;
    }

    /**
     * Converts a Firestore document snapshot into a renderable note object.
     * It accepts a document snapshot and returns normalized data for the note board.
     */
    function mapLeadNoteDocument(documentSnapshot: any) {
      const data = documentSnapshot.data();
      const createdAtDate = data.createdAt?.toDate?.();

      return {
        id: documentSnapshot.id,
        name: data.name ?? "",
        email: data.email ?? "",
        idea: data.idea ?? "",
        budget: data.budget ?? "",
        timeline: data.timeline ?? "",
        nextAction: data.nextAction ?? "",
        status: data.status ?? "New",
        createdAtLabel: createdAtDate ? createdAtDate.toLocaleDateString() : "Just now",
      };
    }

    /**
     * Starts the realtime Firestore listener for project inquiries.
     * It accepts no arguments and updates the board whenever Firestore changes.
     */
    function subscribeToLeadNotes() {
      if (unsubscribeFromNotes) unsubscribeFromNotes();

      const notesQuery = query(collection(database, LEAD_NOTES_COLLECTION), orderBy("createdAt", "desc"));
      unsubscribeFromNotes = onSnapshot(
        notesQuery,
        (snapshot) => renderLeadNotes(snapshot.docs.map(mapLeadNoteDocument)),
        () => showFeedback("lead-feedback", "Project inquiries could not be loaded from Firebase.", "error"),
      );
    }

    /**
     * Shows the correct workspace area for the current authentication state.
     * It accepts the Firebase user object and updates the login and notes panels.
     */
    function renderAuthState(user) {
      const authPanel = document.getElementById("auth-panel");
      const notesPanel = document.getElementById("notes-panel");
      const signedInLabel = document.getElementById("signed-in-label");

      if (isAllowedAdmin(user)) {
        authPanel?.classList.add("hidden");
        notesPanel?.classList.remove("hidden");
        if (signedInLabel) signedInLabel.textContent = `Signed in as ${user.email}. Reviewing submissions from the Rate page.`;
        subscribeToLeadNotes();
        return;
      }

      if (unsubscribeFromNotes) unsubscribeFromNotes();
      authPanel?.classList.remove("hidden");
      notesPanel?.classList.add("hidden");
      renderLeadNotes([]);

      if (user) {
        signOut(auth).catch(() => showFeedback("auth-feedback", "This account is not allowed to access project inquiries.", "error"));
      }
    }

    /**
     * Initializes Firebase Auth and Firestore interactions once the document is ready.
     * It accepts no arguments and wires login, sign out, updates, deletes, and realtime rendering.
     */
    function initializeFirebaseLeadNotesPage() {
      const loginForm = document.getElementById("login-form");
      const signOutButton = document.getElementById("sign-out-btn");
      const notesList = document.getElementById("lead-notes-list");

      onAuthStateChanged(auth, renderAuthState);

      loginForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const formData = new FormData(loginForm);
        const email = sanitizeContactField(String(formData.get("email") ?? ""));
        const password = String(formData.get("password") ?? "");

        if (!email || !password) {
          showFeedback("auth-feedback", "Please enter your Firebase email and password.", "error");
          return;
        }

        try {
          await signInWithEmailAndPassword(auth, email, password);
          loginForm.reset();
        } catch {
          showFeedback("auth-feedback", "Sign in failed. Check the Firebase email and password.", "error");
        }
      });

      signOutButton?.addEventListener("click", async () => {
        try {
          await signOut(auth);
        } catch {
          showFeedback("lead-feedback", "Sign out failed. Please try again.", "error");
        }
      });

      notesList?.addEventListener("change", async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLSelectElement) || !target.classList.contains("note-status")) return;

        try {
          await updateDoc(doc(database, LEAD_NOTES_COLLECTION, target.dataset.noteId), {
            status: target.value,
            updatedAt: serverTimestamp(),
          });
        } catch {
          showFeedback("lead-feedback", "Status could not be updated.", "error");
        }
      });

      notesList?.addEventListener("change", async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement) || !target.classList.contains("note-next-action")) return;

        try {
          await updateDoc(doc(database, LEAD_NOTES_COLLECTION, target.dataset.noteId), {
            nextAction: sanitizeContactField(target.value),
            updatedAt: serverTimestamp(),
          });
        } catch {
          showFeedback("lead-feedback", "Next action could not be updated.", "error");
        }
      });

      notesList?.addEventListener("click", async (event) => {
        const target = event.target;
        if (!(target instanceof HTMLButtonElement) || !target.classList.contains("delete-note")) return;

        try {
          await deleteDoc(doc(database, LEAD_NOTES_COLLECTION, target.dataset.noteId));
          showFeedback("lead-feedback", "Project inquiry deleted from Firebase.", "success");
        } catch {
          showFeedback("lead-feedback", "Project inquiry could not be deleted.", "error");
        }
      });
    }

    document.addEventListener("DOMContentLoaded", initializeFirebaseLeadNotesPage);
  </script>
</Layout>
