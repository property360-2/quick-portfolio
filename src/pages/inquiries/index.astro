---
import Layout from '../../layouts/Layout.astro';
const title = 'Inquiries Dashboard | Jun Alvior';
const description = '';
---

<Layout title={title} description={description}>
<main
      class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-12 min-h-screen relative"
    >
      <!-- Password Modal -->
      <div
        id="auth-overlay"
        class="fixed inset-0 z-[60] bg-gray-50 dark:bg-[#1a1a1a] flex flex-col items-center justify-center p-4 transition-all duration-500"
      >
        <div
          class="bg-white dark:bg-[#252528] rounded-2xl p-8 border border-gray-200 dark:border-gray-800 shadow-xl max-w-md w-full text-center scale-100 transition-transform"
        >
          <svg
            class="text-5xl text-wood-accent mb-4"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM8.9 6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2H8.9V6zM18 20H6V10h12v10z"
            />
          </svg>
          <h2 class="text-2xl font-bold mb-2">Admin Access</h2>
          <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">
            Enter the master password to view inquiries.
          </p>

          <form id="auth-form" class="space-y-4">
            <input
              type="password"
              id="admin-pass"
              required
              placeholder="Enter Password"
              class="block w-full bg-gray-50 dark:bg-[#1a1a1a] border border-gray-300 dark:border-gray-600 text-gray-900 dark:text-white rounded-lg focus:ring-wood-accent focus:border-wood-accent p-3 outline-none transition-all"
            />
            <button
              type="submit"
              id="auth-btn"
              class="w-full py-3 px-4 bg-wood-accent text-white font-bold rounded-lg shadow-md hover:bg-wood-700 transition-colors flex items-center justify-center"
            >
              <span id="auth-btn-text">Authenticate</span>
              <svg
                id="auth-spinner"
                class="hidden animate-spin ml-2 h-5 w-5 text-white"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
              >
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"
                ></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
            </button>
            <p id="auth-error" class="text-red-500 text-sm hidden">
              Incorrect Password.
            </p>
          </form>
        </div>
      </div>

      <!-- Dashboard Content -->
      <div
        id="dashboard-content"
        class="hidden opacity-0 transition-opacity duration-500"
      >
        <div
          class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 border-b border-gray-200 dark:border-gray-800 pb-6"
        >
          <div>
            <h1
              class="text-3xl font-bold text-gray-900 dark:text-white gap-2 flex items-center"
            >
              <svg
                class="text-wood-accent text-3xl"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5v-3h3.56c.69 1.19 1.97 2 3.44 2s2.75-.81 3.44-2H19v3zm0-5h-4.99c0 1.1-.9 2-2 2s-2-.9-2-2H5V5h14v9z"
                />
              </svg>
              Project Inquiries
            </h1>
            <p class="text-gray-500 mt-2">
              Manage and review quotes submitted from your rate page.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-4 mt-4 md:mt-0">
            <!-- Currency Visual Toggle -->
            <div
              class="flex items-center space-x-2 bg-gray-100 dark:bg-black/20 p-1.5 rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm"
            >
              <span class="text-[10px] font-bold text-gray-500 uppercase px-2"
                >Convert to:</span
              >
              <div class="flex space-x-1">
                <button
                  id="display-php"
                  class="display-toggle px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all bg-wood-accent text-white shadow-sm"
                  data-currency="PHP"
                >
                  PHP
                </button>
                <button
                  id="display-usdt"
                  class="display-toggle px-3 py-1.5 rounded-lg text-[11px] font-bold transition-all text-gray-500 hover:text-gray-700 dark:hover:text-gray-300"
                  data-currency="USDT"
                >
                  USDT
                </button>
              </div>
            </div>

            <div
              id="quote-count"
              class="px-4 py-2.5 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl text-xs font-bold text-gray-600 dark:text-gray-400 shadow-sm flex items-center"
            >
              <svg
                class="text-sm mr-2 opacity-50"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M15 4v2h3v12h-3v2h5V4zM4 20h5v-2H6V6h3V4H4z" />
              </svg>
              <span id="inquiry-count-text">0 Inquiries</span>
            </div>
            <button
              id="refresh-btn"
              class="p-2.5 bg-white dark:bg-[#252528] border border-gray-200 dark:border-gray-800 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700 transition-all shadow-sm active:scale-95 group"
            >
              <svg
                class="block group-hover:rotate-180 transition-transform duration-500"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                />
              </svg>
            </button>
          </div>
        </div>

        <!-- Loader -->
        <div id="data-loader" class="flex justify-center items-center py-20">
          <svg
            class="animate-spin h-10 w-10 text-wood-accent"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </div>

        <!-- Table Container -->
        <div
          id="table-wrapper"
          class="hidden overflow-hidden bg-white dark:bg-[#252528] rounded-2xl border border-gray-200 dark:border-gray-800 shadow-xl relative"
        >
          <div class="overflow-x-auto custom-scrollbar">
            <table class="w-full text-left border-collapse table-auto">
              <thead>
                <tr
                  class="bg-gray-50/50 dark:bg-black/20 border-b border-gray-200 dark:border-gray-800"
                >
                  <th
                    class="px-6 py-5 text-xs font-bold text-gray-500 uppercase tracking-widest min-w-[140px]"
                  >
                    Date Received
                  </th>
                  <th
                    class="px-6 py-5 text-xs font-bold text-gray-500 uppercase tracking-widest min-w-[180px]"
                  >
                    Client Info
                  </th>
                  <th
                    class="px-6 py-5 text-xs font-bold text-gray-500 uppercase tracking-widest min-w-[250px]"
                  >
                    Project Details
                  </th>
                  <th
                    class="px-6 py-5 text-xs font-bold text-gray-500 uppercase tracking-widest text-right whitespace-nowrap"
                  >
                    One-Time Total
                  </th>
                  <th
                    class="px-6 py-5 text-xs font-bold text-gray-500 uppercase tracking-widest text-right whitespace-nowrap"
                  >
                    Monthly Total
                  </th>
                  <th
                    class="px-6 py-5 text-xs font-bold text-gray-500 uppercase tracking-widest text-center"
                  >
                    Action
                  </th>
                </tr>
              </thead>
              <tbody
                id="quotes-tbody"
                class="divide-y divide-gray-100 dark:divide-gray-800"
              >
                <!-- Rows populated here -->
              </tbody>
            </table>
          </div>
        </div>

        <div
          id="empty-state"
          class="hidden flex-col items-center justify-center py-32 text-gray-400"
        >
          <svg
            class="text-7xl mb-4 text-gray-300 dark:text-gray-700"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path
              d="M12 13L2 6.67V18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6.67L12 13zM12 11l8.52-5.51C20.18 5.14 19.62 5 19 5H5c-.62 0-1.18.14-1.52.49L12 11z"
            />
          </svg>
          <p class="text-lg font-medium">No inquiries received yet.</p>
          <p class="text-sm mt-1">Quotes will appear here after submission.</p>
        </div>
      </div>
    </main>
</Layout>
