---
import Layout from '../../layouts/Layout.astro';
import TestimonialsSection from '../../components/TestimonialsSection.astro';
const title = 'Client Testimonials | Dionisio "Jun" Alvior';
const description = 'Verified client feedback and engineering deliverables — real outcomes from production systems built for FinTech, SaaS, AI/ML, retail, and operations clients.';
---

<Layout title={title} description={description}>
  <main id="main-content" class="flex-grow flex flex-col pt-16">
    <TestimonialsSection />

    <section class="py-20 bg-white dark:bg-[#1f1f1f] border-t border-gray-100 dark:border-gray-800">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl md:text-3xl font-extrabold text-gray-900 dark:text-white mb-4 gs-reveal">
          Want results like these?
        </h2>
        <p class="text-gray-600 dark:text-gray-300 mb-8 leading-relaxed gs-reveal">
          I help teams turn manual, error-prone workflows into reliable production systems.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center gs-reveal">
          <a
            href="/quick-portfolio/contact/"
            class="inline-flex items-center justify-center px-8 py-4 bg-wood-accent hover:bg-wood-700 text-white font-bold rounded-xl shadow-lg hover:shadow-wood-accent/40 transition-all transform hover:-translate-y-1 focus:ring-2 focus:ring-wood-accent focus:outline-none"
          >
            Start a Project
          </a>
          <a
            href="/quick-portfolio/portfolio/"
            class="inline-flex items-center justify-center px-8 py-4 bg-white dark:bg-[#252528] border-2 border-wood-accent text-wood-accent dark:text-wood-300 font-bold rounded-xl hover:bg-wood-50 dark:hover:bg-[#1a1a1a] transition-all transform hover:-translate-y-1 focus:ring-2 focus:ring-wood-accent focus:outline-none"
          >
            View Selected Work
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
