# ==============================================================================
# File: .gitignore
# Purpose: Prevents sensitive data and environment-specific files from being tracked by Git.
# Fits: quick-portfolio repository (Astro / Node.js project).
# ==============================================================================

# Build output
dist/

# Generated types
.astro/

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.*
!.env.example

# OS-specific files
.DS_Store
Thumbs.db

# Editor/IDE settings
.vscode/
.idea/
